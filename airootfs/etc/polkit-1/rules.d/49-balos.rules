/*
 * BalOS PolicyKit rules
 * Grant wheel/gamemode users permission to run power-profile commands
 * without typing sudo every time.
 */

polkit.addRule(function(action, subject) {
    if (!subject.isInGroup("wheel")) return;

    // Allow bal boost/saver/balance without password
    if (action.id == "org.balos.powerprofile") {
        return polkit.Result.YES;
    }

    // Shield + stealth: ask for password once per session
    if (action.id == "org.balos.firewall" || action.id == "org.balos.stealth") {
        return polkit.Result.AUTH_ADMIN_KEEP;
    }

    // Systemctl for known services (no password)
    if (action.id == "org.freedesktop.systemd1.manage-units") {
        var unit = action.lookup("unit");
        if (unit == "tor.service" || unit == "dnscrypt-proxy.service" ||
            unit == "nftables.service" || unit == "tlp.service" ||
            unit == "wg-quick@wg0.service" || unit == "gamemoded.service") {
            return polkit.Result.YES;
        }
    }

    // Suspend/hibernate/reboot without password (for gamers)
    if (action.id.match(/^org\.freedesktop\.login1\.(suspend|hibernate|reboot|power-off)/)) {
        return polkit.Result.YES;
    }
});
