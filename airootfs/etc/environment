# BalOS system-wide environment

# ── Wayland / display ───────────────────────────────────────────
QT_QPA_PLATFORM=wayland;xcb
GDK_BACKEND=wayland,x11
SDL_VIDEODRIVER=wayland,x11
CLUTTER_BACKEND=wayland
MOZ_ENABLE_WAYLAND=1
MOZ_USE_XINPUT2=1
_JAVA_AWT_WM_NONREPARENTING=1
QT_AUTO_SCREEN_SCALE_FACTOR=1
QT_WAYLAND_DISABLE_WINDOWDECORATION=0

# ── Hardware video accel ────────────────────────────────────────
LIBVA_DRIVER_NAME=radeonsi
VDPAU_DRIVER=radeonsi

# ── Gaming / Wine ───────────────────────────────────────────────
STEAM_RUNTIME=1
PROTON_ENABLE_NVAPI=1
PROTON_HIDE_NVIDIA_GPU=0
PROTON_ENABLE_WAYLAND=1
DXVK_LOG_LEVEL=none
VKD3D_DEBUG=none
WINEESYNC=1
WINEFSYNC=1
mesa_glthread=true

# ── Performance allocator ───────────────────────────────────────
MALLOC_CONF=background_thread:true,metadata_thp:auto,dirty_decay_ms:1000,muzzy_decay_ms:0

# ── Editors ─────────────────────────────────────────────────────
EDITOR=nvim
VISUAL=nvim
SYSTEMD_EDITOR=nvim
PAGER=less
LESS=-R

# ── Hacker defaults ─────────────────────────────────────────────
HISTCONTROL=ignoreboth:erasedups
HISTTIMEFORMAT="%Y-%m-%d %H:%M:%S "

# ── Colors (bat, less, grep) ────────────────────────────────────
BAT_THEME=Dracula
MANPAGER="sh -c 'col -bx | bat -l man -p --theme=Dracula'"
GREP_COLORS='ms=01;32:mc=01;32:sl=:cx=:fn=35:ln=32:bn=32:se=36'
LESS_TERMCAP_mb=$'\e[1;32m'
LESS_TERMCAP_md=$'\e[1;32m'
LESS_TERMCAP_me=$'\e[0m'
LESS_TERMCAP_so=$'\e[01;33m'
LESS_TERMCAP_se=$'\e[0m'
LESS_TERMCAP_us=$'\e[1;4;31m'
LESS_TERMCAP_ue=$'\e[0m'

# ── XDG ─────────────────────────────────────────────────────────
XDG_CURRENT_DESKTOP=KDE
