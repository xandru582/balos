[Unit]
Description=BalOS Suricata IDS (host monitoring)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/suricata/balos.yaml

[Service]
Type=simple
ExecStartPre=/bin/sh -c 'test -d /var/lib/suricata/rules || (mkdir -p /var/lib/suricata/rules && suricata-update 2>/dev/null || true)'
# Pick the active interface: default route wins, else first non-loopback UP iface.
ExecStart=/bin/sh -c 'IFACE=$(ip -4 route show default 2>/dev/null | awk "{print \$5; exit}"); [ -z "$IFACE" ] && IFACE=$(ip -o link show up 2>/dev/null | awk -F": " "{print \$2}" | grep -v "^lo$" | head -1); [ -z "$IFACE" ] && { echo "balos-suricata: no active interface found"; exit 1; }; exec /usr/bin/suricata -c /etc/suricata/balos.yaml -i "$IFACE"'
Restart=on-failure
RestartSec=10
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUSchedulingPolicy=batch

# Sandbox
ProtectSystem=strict
ReadWritePaths=/var/log/suricata /var/run/suricata /var/lib/suricata
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
