#!/usr/bin/env bash
# balai — BalOS local AI assistant (offline, ~1GB Qwen2.5-1.5B)
# Talks to local ollama HTTP API on 127.0.0.1:11434.
# You are NOT forwarding anything to the cloud — 100% local.
#
# Why 1.5B and not smaller? Empirical testing: Qwen2.5-0.5B hallucinates
# commands that don't exist ("bal wipe"), enters token-repetition loops,
# and gives wrong answers ~50% of the time. Qwen2.5-1.5B is the smallest
# Qwen that reliably follows the BalOS system prompt. Users with more RAM
# can upgrade to 3b/7b via: BALAI_MODEL=qwen2.5:3b-instruct-q4_K_M
set -uo pipefail

VERSION="1.0.1-dark"
MODEL_DEFAULT="qwen2.5:1.5b-instruct-q4_K_M"
MODEL="${BALAI_MODEL:-$MODEL_DEFAULT}"
SYSTEM_PROMPT_FILE="${BALAI_SYSTEM_PROMPT:-/usr/share/balos/ai/system-prompt.md}"
OLLAMA_HOST="${OLLAMA_HOST:-127.0.0.1:11434}"
OLLAMA_URL="http://${OLLAMA_HOST}"
HISTORY_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/balai/history.jsonl"
LAST_CMD_FILE="${XDG_RUNTIME_DIR:-/tmp}/balai-last-suggested"
NOTES_FILE="${BALAI_NOTES_FILE:-${XDG_STATE_HOME:-$HOME/.local/state}/balai/notes.md}"

G='\033[0;32m'; R='\033[0;31m'; Y='\033[1;33m'; C='\033[0;36m'; M='\033[0;35m'
B='\033[1m'; D='\033[2m'; N='\033[0m'

# ─── utilities ───────────────────────────────────────────────────
need() { command -v "$1" &>/dev/null; }
die()  { echo -e "${R}✗ $*${N}" >&2; exit 1; }
info() { echo -e "${C}▸${N} $*" >&2; }
warn() { echo -e "${Y}⚠ $*${N}" >&2; }
ok()   { echo -e "${G}✓${N} $*" >&2; }

# Start ollama service if not running (idempotent).
# On BalOS the package installs a systemd service that reads models from
# /var/lib/ollama/.ollama/models (HOME=/var/lib/ollama). We respect that.
# Fallback path (user-level serve) mirrors the same HOME so both paths see
# the models baked into squashfs during the ISO build.
ensure_ollama() {
    if curl -fsS --max-time 2 "${OLLAMA_URL}/api/tags" &>/dev/null; then
        return 0
    fi
    info "ollama not responding — starting service…"
    if systemctl is-enabled ollama &>/dev/null 2>&1; then
        sudo systemctl start ollama 2>/dev/null || true
    elif command -v systemctl &>/dev/null && systemctl cat ollama &>/dev/null; then
        sudo systemctl start ollama 2>/dev/null || true
    else
        # user-level fallback (e.g. live ISO without service installed).
        # Point at the system model dir so baked-in models are visible.
        export OLLAMA_MODELS="${OLLAMA_MODELS:-/var/lib/ollama/.ollama/models}"
        [[ ! -r "$OLLAMA_MODELS" ]] && export OLLAMA_MODELS="$HOME/.ollama/models"
        nohup ollama serve &>/dev/null &
        disown
    fi
    # wait up to 15 s (startup can be slow first time)
    for i in {1..30}; do
        sleep 0.5
        curl -fsS --max-time 1 "${OLLAMA_URL}/api/tags" &>/dev/null && { ok "ollama up"; return 0; }
    done
    die "ollama failed to start — try: sudo systemctl start ollama"
}

# Check if model is present locally; pull if missing (requires network).
# Uses proper JSON parsing (grep on JSON is fragile due to whitespace).
ensure_model() {
    # Battery guard runs here (once) since every expensive command funnels
    # through ensure_model. Users can bypass with BALAI_FORCE=1.
    if ! check_battery_guard; then exit 77; fi

    local m="${1:-$MODEL}"
    local found
    found=$(curl -fsS --max-time 3 "${OLLAMA_URL}/api/tags" 2>/dev/null \
        | python3 -c "
import sys, json
try:
    d = json.load(sys.stdin)
    names = {mod['name'] for mod in d.get('models', [])}
    print('yes' if '$m' in names else 'no')
except Exception:
    print('no')" 2>/dev/null)
    [[ "$found" == "yes" ]] && return 0
    warn "model ${m} not found locally"
    # Soft network probe: try curl against ollama registry (doesn't reveal
    # user activity). Ping to 1.1.1.1 fails under fortress firewall.
    if ! curl -fsS --max-time 3 -o /dev/null https://registry.ollama.ai 2>/dev/null; then
        die "no network — cannot pull model. Connect to internet or pick a model that's already installed (\`balai model list\`)."
    fi
    local sz="~1 GB"
    [[ "$m" == *"0.5b"* ]] && sz="~400 MB"
    [[ "$m" == *"3b"*   ]] && sz="~2 GB"
    [[ "$m" == *"7b"*   ]] && sz="~4 GB"
    echo -ne "${Y}pull ${m} now? (${sz}) [Y/n] ${N}"
    read -r ans
    ans=$(printf '%s' "$ans" | tr '[:upper:]' '[:lower:]')
    [[ "$ans" =~ ^(n|no)$ ]] && die "aborted"
    ollama pull "$m" || die "pull failed"
}

# Return the system prompt string (used as 'system' field in API payload).
load_system_prompt() {
    if [[ -r "$SYSTEM_PROMPT_FILE" ]]; then
        cat "$SYSTEM_PROMPT_FILE"
    else
        # Fallback minimal prompt.
        echo "You are BalAI, a terse CLI assistant for BalOS (Arch-based). Suggest commands; never run them. Prefer bal* wrappers when they fit."
    fi
}

# Build JSON payload safely.
# Args: mode (chat|generate), prompt, [keep_alive]
build_payload() {
    local mode="$1" user_prompt="$2" keep_alive="${3:-5m}"
    local sysp
    sysp=$(load_system_prompt)

    # Use python for safe JSON escaping (python is in base packages)
    python3 - "$MODEL" "$sysp" "$user_prompt" "$keep_alive" << 'PY'
import json, sys
model, sysp, prompt, keep = sys.argv[1:5]
payload = {
    "model": model,
    "stream": True,
    "keep_alive": keep,
    "messages": [
        {"role": "system", "content": sysp},
        {"role": "user", "content": prompt},
    ],
    "options": {
        "temperature": 0.3,
        "top_p": 0.9,
        "num_ctx": 4096,
        "num_predict": 512,
    },
}
print(json.dumps(payload))
PY
}

# Stream chat with multi-turn history. Reads prior turns from
# $history_file (one JSON object per line: {"role":...,"content":...})
# and appends BOTH the user's new prompt AND the assistant's full
# response to the file, so subsequent calls see real context.
#
# $1 = user prompt
# $2 = path to history file (will be created if absent; may grow unbounded
#      in theory — the REPL caps it by truncating on /clear).
stream_chat_with_history() {
    local prompt="$1" hfile="$2"
    [[ -n "$hfile" ]] || { stream_chat "$prompt"; return; }
    mkdir -p "$(dirname "$hfile")" 2>/dev/null || true
    touch "$hfile" 2>/dev/null || true
    # Append the new user turn to the file BEFORE building payload so the
    # model sees it on retry if we crash mid-stream.
    python3 -c "
import json, sys
sys.stdout.write(json.dumps({'role':'user','content':sys.argv[1]})+'\n')
" "$prompt" >> "$hfile" 2>/dev/null || true

    local payload
    payload=$(python3 - "$MODEL" "$(load_system_prompt)" "$hfile" << 'PY'
import json, sys
model, sysp, hfile = sys.argv[1:4]
messages = [{"role": "system", "content": sysp}]
with open(hfile) as f:
    for line in f:
        line = line.strip()
        if not line:
            continue
        try:
            messages.append(json.loads(line))
        except Exception:
            continue
# Keep the system prompt + the last 16 turns — enough for coherent
# follow-ups without blowing the 4096-token context window.
if len(messages) > 17:
    messages = [messages[0]] + messages[-16:]
payload = {
    "model": model, "stream": True, "keep_alive": "5m",
    "messages": messages,
    "options": {"temperature": 0.3, "top_p": 0.9,
                "num_ctx": 4096, "num_predict": 512},
}
print(json.dumps(payload))
PY
)
    local capture; capture=$(mktemp)
    curl -fsS -N -H 'Content-Type: application/json' \
         -d "$payload" "${OLLAMA_URL}/api/chat" 2>/dev/null \
      | python3 -u -c '
import sys, json
for raw in sys.stdin:
    raw = raw.strip()
    if not raw: continue
    try: d = json.loads(raw)
    except Exception: continue
    c = d.get("message", {}).get("content", "")
    if c:
        sys.stdout.write(c); sys.stdout.flush()
' | tee "$capture"
    echo ""
    local full; full=$(cat "$capture"); rm -f "$capture"
    # Append the assistant turn so the next call sees it.
    python3 -c "
import json, sys
sys.stdout.write(json.dumps({'role':'assistant','content':sys.argv[1]})+'\n')
" "$full" >> "$hfile" 2>/dev/null || true
    echo "$full" > "$LAST_CMD_FILE" 2>/dev/null || true
}

# Stream a /api/chat response, print assistant text, capture full text.
# Uses a SINGLE python subprocess as streaming parser (fast — no per-line fork).
stream_chat() {
    local prompt="$1"
    local payload
    payload=$(build_payload chat "$prompt") || return 1

    mkdir -p "$(dirname "$HISTORY_FILE")" 2>/dev/null || true
    printf '%s\n' "$(date -Iseconds) USER $prompt" >> "$HISTORY_FILE" 2>/dev/null || true

    local capture
    capture=$(mktemp)
    curl -fsS -N -H 'Content-Type: application/json' \
         -d "$payload" "${OLLAMA_URL}/api/chat" 2>/dev/null \
      | python3 -u -c '
import sys, json
for raw in sys.stdin:
    raw = raw.strip()
    if not raw:
        continue
    try:
        d = json.loads(raw)
    except Exception:
        continue
    c = d.get("message", {}).get("content", "")
    if c:
        sys.stdout.write(c)
        sys.stdout.flush()
' | tee "$capture"

    echo ""
    local full
    full=$(cat "$capture")
    rm -f "$capture"
    printf '%s\n' "$(date -Iseconds) ASSISTANT $full" >> "$HISTORY_FILE" 2>/dev/null || true
    # Always save full reply to $LAST_CMD_FILE — callers read from there
    # (avoids double-output when capturing via $(stream_chat ...)).
    echo "$full" > "$LAST_CMD_FILE" 2>/dev/null || true
}

# Read the last assistant reply (populated by stream_chat).
last_reply() { cat "$LAST_CMD_FILE" 2>/dev/null; }

# Extract first command from assistant output — tries multiple formats.
# 1. Fenced ```bash / ```sh / ``` block (strict, most common).
# 2. $-prefixed line.
# 3. Single inline `backtick` span when the response is a one-liner.
extract_command() {
    local txt="$1"
    local cmd
    # 1. Fenced code block. Stop after first block.
    cmd=$(echo "$txt" | awk '
        BEGIN { inblk=0; done=0 }
        done { next }
        /^```(bash|sh|shell)?[[:space:]]*$/ {
            if (inblk) { done=1 }
            inblk = !inblk
            next
        }
        inblk { print }
    ' | head -20)
    if [[ -n "${cmd//[[:space:]]/}" ]]; then
        printf '%s\n' "$cmd"
        return 0
    fi
    # 2. Shell-prompt-prefixed line (`$ command`).
    cmd=$(echo "$txt" | grep -E '^[[:space:]]*\$[[:space:]]' | head -1 \
         | sed -E 's/^[[:space:]]*\$[[:space:]]+//')
    if [[ -n "$cmd" ]]; then
        printf '%s\n' "$cmd"
        return 0
    fi
    # 3. Single inline backtick span — only if response is short (≤3 lines).
    local lines
    lines=$(echo "$txt" | wc -l)
    if (( lines <= 3 )); then
        cmd=$(echo "$txt" | grep -oE '`[^`]+`' | head -1 | tr -d '`')
        [[ -n "$cmd" ]] && { printf '%s\n' "$cmd"; return 0; }
    fi
    return 1
}

# ─── context gathering ─────────────────────────────────────────
# Collects a SHORT summary of current system state that can be fed to
# the model so it answers with awareness of the user's real situation
# ("my battery" → knows you're on 14%, etc.). Everything is read-only
# and best-effort; individual failures are swallowed.
# 2-second memoized cache for gather_ctx.
# Rationale: sequences like `balai tip` → `balai doctor` → `balai "…"`
# used to re-probe /sys, /proc, iwgetid, and ollama four times in a
# couple of seconds. With the cache, only the first call pays the cost
# (~60-120 ms); subsequent calls inside the TTL return instantly.
# Per-user cache file (writable by owner only), living under $XDG_RUNTIME_DIR
# when available so it's gone on logout.
GATHER_CTX_TTL="${BALAI_CTX_TTL:-2}"
_ctx_cache_file() {
    local base="${XDG_RUNTIME_DIR:-/tmp}"
    [[ -d "$base" && -w "$base" ]] || base="/tmp"
    printf '%s/balai-ctx-%s' "$base" "$(id -u)"
}

gather_ctx() {
    local cache; cache=$(_ctx_cache_file)
    if [[ -r "$cache" ]]; then
        # portable mtime-diff via stat; accept both GNU (-c %Y) and BSD (-f %m)
        local mtime now
        mtime=$(stat -c %Y "$cache" 2>/dev/null || stat -f %m "$cache" 2>/dev/null || echo 0)
        now=$(date +%s)
        if (( now - mtime < GATHER_CTX_TTL )); then
            cat "$cache"
            return 0
        fi
    fi

    local out=""
    local line

    # Power profile — written by balboost / balsaver. Legacy fallback to
    # /run/balos-mode (the old pre-unified path).
    for pf in /run/balos/power-profile /run/balos-mode /tmp/balos-mode; do
        if [[ -r "$pf" ]]; then
            line=$(cat "$pf" 2>/dev/null)
            [[ -n "$line" ]] && { out+="power-profile: $line"$'\n'; break; }
        fi
    done

    # Firewall tier — written by balshield
    if [[ -r /run/balos/shield-tier ]]; then
        line=$(cat /run/balos/shield-tier 2>/dev/null)
        [[ -n "$line" ]] && out+="firewall: $line"$'\n'
    elif need nft; then
        # Cheap probe: is nftables loaded at all?
        sudo -n nft list ruleset 2>/dev/null | grep -q 'chain input' && out+="firewall: nftables loaded"$'\n'
    fi

    # Stealth — written by balstealth
    if [[ -r /run/balos/stealth ]]; then
        line=$(cat /run/balos/stealth 2>/dev/null)
        [[ "$line" == "on" ]] && out+="stealth: on"$'\n'
    fi
    if systemctl is-active tor &>/dev/null; then
        out+="tor: active"$'\n'
    fi
    if systemctl is-active dnscrypt-proxy &>/dev/null; then
        out+="dns: dnscrypt (DoH)"$'\n'
    fi

    # VPN (WireGuard)
    if ip link show wg0 &>/dev/null; then
        out+="vpn: wg0 up"$'\n'
    fi

    # Default iface + IP
    local iface ip4
    iface=$(ip -o route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="dev"){print $(i+1); exit}}')
    if [[ -n "$iface" ]]; then
        ip4=$(ip -o -4 addr show "$iface" 2>/dev/null | awk '{print $4}' | head -1)
        out+="net: ${iface} ${ip4:-no-ipv4}"$'\n'
    fi

    # WiFi SSID
    local ssid
    ssid=$(iwgetid -r 2>/dev/null) || ssid=""
    [[ -n "$ssid" ]] && out+="wifi-ssid: $ssid"$'\n'

    # Battery
    if [[ -r /sys/class/power_supply/BAT0/capacity ]]; then
        local pct status
        pct=$(cat /sys/class/power_supply/BAT0/capacity 2>/dev/null)
        status=$(cat /sys/class/power_supply/BAT0/status 2>/dev/null)
        out+="battery: ${pct}% ${status}"$'\n'
    fi

    # CPU governor
    if [[ -r /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor ]]; then
        line=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null)
        out+="cpu-governor: $line"$'\n'
    fi

    # Uptime + load
    line=$(uptime 2>/dev/null | sed -E 's/.*up ([^,]+), .*load average: (.*)/up \1, load \2/')
    [[ -n "$line" ]] && out+="system: $line"$'\n'

    # Memory
    if need free; then
        line=$(free -h 2>/dev/null | awk '/^Mem:/{printf "%s used / %s total", $3, $2}')
        [[ -n "$line" ]] && out+="mem: $line"$'\n'
    fi

    # Disk on root
    line=$(df -h / 2>/dev/null | awk 'NR==2{printf "%s used / %s (%s)", $3, $2, $5}')
    [[ -n "$line" ]] && out+="disk /: $line"$'\n'

    # ollama running?
    if curl -fsS --max-time 1 "${OLLAMA_URL}/api/tags" &>/dev/null; then
        out+="ollama: up (${MODEL})"$'\n'
    fi

    # Kernel
    line=$(uname -r 2>/dev/null)
    [[ -n "$line" ]] && out+="kernel: $line"$'\n'

    # Write cache best-effort; ignore ENOSPC / read-only FS.
    ( umask 077; printf '%s' "$out" > "$cache" ) 2>/dev/null || true

    printf '%s' "$out"
}

# Decide if a user query likely needs context injection. Cheap regex —
# we'd rather inject unnecessarily than miss a "what's my battery" case.
# Note: uses `tr` for lowercasing instead of ${var,,} so this works under
# bash 3.x too (important for macOS dev; target BalOS is bash 5).
needs_ctx() {
    local q
    q=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
    [[ "$q" =~ (my|current|right\ now|actual|whats?|what\ is|how\ (many|much)\ ).*(battery|cpu|ram|memory|disk|firewall|shield|vpn|wifi|ssid|tor|stealth|power|profile|kernel|uptime|ip|iface|interface|governor|temp|load) ]] || \
    [[ "$q" =~ (status|am\ i|are\ we).*(connected|protected|safe|stealth|online|vpn|tor|on\ battery|plugged) ]] || \
    [[ "$q" =~ ^(status|where|which) ]]
}

# Wrap a prompt with an optional [SYSTEM CONTEXT] block.
# Args: prompt  (reads $BALAI_CTX_MODE: auto|always|never)
with_ctx() {
    local prompt="$1"
    local mode="${BALAI_CTX_MODE:-auto}"
    local inject_ctx=true
    case "$mode" in
        never) inject_ctx=false ;;
        always) inject_ctx=true ;;
        auto|*) needs_ctx "$prompt" || inject_ctx=false ;;
    esac
    local ctx="" notes=""
    $inject_ctx && ctx=$(gather_ctx)
    # Notes are injected regardless of ctx mode (unless user set `never`),
    # because they are persistent user preferences, not live system state.
    if [[ "$mode" != "never" ]] && [[ -r "$NOTES_FILE" ]] && [[ -s "$NOTES_FILE" ]]; then
        # Cap notes at 2 KB so they don't blow the context window on 1.5B.
        notes=$(head -c 2048 "$NOTES_FILE")
    fi
    if [[ -z "$ctx" && -z "$notes" ]]; then
        printf '%s' "$prompt"
    else
        {
            [[ -n "$ctx" ]]   && printf 'Current BalOS system state:\n%s\n' "$ctx"
            [[ -n "$notes" ]] && printf 'User preferences and notes (remember these):\n%s\n' "$notes"
            printf 'User question: %s' "$prompt"
        }
    fi
}

# ─── subcommands ─────────────────────────────────────────────────

cmd_chat() {
    ensure_ollama
    ensure_model
    echo -e "${M}${B}╔════════════════════════════════════════════╗${N}"
    echo -e "${M}${B}║  BalAI · local · ${MODEL}            ${N}"
    echo -e "${M}${B}╚════════════════════════════════════════════╝${N}"
    echo -e "${D}type 'exit' to quit, '/clear' to reset context, '/save' to persist this session${N}"
    echo ""
    # Per-REPL history file — conversation is multi-turn within one session.
    # Starts fresh each REPL launch unless the user runs /save.
    local session_dir="${XDG_STATE_HOME:-$HOME/.local/state}/balai/sessions"
    local session
    session="${session_dir}/repl-$(date +%Y%m%d-%H%M%S).jsonl"
    mkdir -p "$session_dir" 2>/dev/null || true
    # Hidden scratch file that gets wiped on /clear; only copied to the
    # named session file on /save.
    local scratch; scratch=$(mktemp)
    trap 'rm -f "$scratch"' EXIT
    while true; do
        echo -ne "${G}${B}you ▸${N} "
        local q
        IFS= read -r q || break
        [[ -z "$q" ]] && continue
        case "$q" in
            exit|quit|:q) break ;;
            /clear)       clear; : > "$scratch"; echo -e "${D}context cleared${N}"; continue ;;
            /model)       echo "current: $MODEL"; continue ;;
            /save)        cp "$scratch" "$session" 2>/dev/null && echo -e "${G}saved → $session${N}"; continue ;;
            /help)        echo "Commands: /clear /model /save /help  |  exit"; continue ;;
        esac
        echo -ne "${C}${B}bal ▸${N} "
        local p; p=$(with_ctx "$q")
        stream_chat_with_history "$p" "$scratch"
        echo ""
    done
}

cmd_once() {
    ensure_ollama
    ensure_model
    local prompt
    prompt=$(with_ctx "$*")
    stream_chat "$prompt"
}

# Dump the current system context as the model sees it (useful for the
# user to audit what balai is feeding its prompt with).
cmd_ctx() {
    local ctx
    ctx=$(gather_ctx)
    if [[ -z "$ctx" ]]; then
        echo "(no context probes succeeded)"
    else
        echo -e "${M}${B}balai — current system context${N}"
        echo -e "${D}(this gets prepended automatically when your question mentions 'my …' etc.)${N}"
        echo ""
        printf '%s' "$ctx"
    fi
}

# Returns 0 if the command looks destructive, 1 otherwise.
# Shared between cmd_cmd and cmd_agent. Pattern list kept in one place.
is_destructive() {
    local cmd="$1"
    local sysdirs='(home|etc|var|usr|bin|sbin|boot|lib|lib32|lib64|opt|root|srv|tmp|dev|proc|sys)'
    local danger_alts=(
        "rm[[:space:]]+-[a-zA-Z]*[rR][a-zA-Z]*[fF][a-zA-Z]*[[:space:]]+(--[[:space:]]+)?/([[:space:];&|]|\$)"
        "rm[[:space:]]+-[a-zA-Z]*[fF][a-zA-Z]*[rR][a-zA-Z]*[[:space:]]+(--[[:space:]]+)?/([[:space:];&|]|\$)"
        "rm[[:space:]]+-[a-zA-Z]*[rR][a-zA-Z]*[fF][a-zA-Z]*[[:space:]]+(--[[:space:]]+)?/${sysdirs}([[:space:];&|/]|\$)"
        "rm[[:space:]]+-[a-zA-Z]*[fF][a-zA-Z]*[rR][a-zA-Z]*[[:space:]]+(--[[:space:]]+)?/${sysdirs}([[:space:];&|/]|\$)"
        "dd[[:space:]].*of=/dev/(sd|nvme|hd|mmc|vd|loop)"
        "mkfs\.[a-z0-9]+[[:space:]]+/dev/"
        "wipefs[[:space:]]+(-[afFq]+[[:space:]]+)?/dev/"
        "shred[[:space:]].*[[:space:]]/dev/"
        ">[[:space:]]*/dev/(sd|nvme|hd|mmc|vd)"
        "blkdiscard[[:space:]]+/dev/"
        "(s?fdisk|sgdisk|parted)[[:space:]]+(--[[:alpha:]-]+[[:space:]]+)?/dev/"
        "cryptsetup[[:space:]]+(erase|luksRemoveKey|luksKillSlot|luksErase)"
        "chmod[[:space:]]+-[a-zA-Z]*R[a-zA-Z]*[[:space:]]+[0-9]+[[:space:]]+/([[:space:];&|]|\$)"
        "chmod[[:space:]]+-[a-zA-Z]*R[a-zA-Z]*[[:space:]]+[0-9]+[[:space:]]+/${sysdirs}([[:space:];&|/]|\$)"
        "chown[[:space:]]+-[a-zA-Z]*R[a-zA-Z]*[[:space:]]+[^[:space:]]+[[:space:]]+/([[:space:];&|]|\$)"
        "chown[[:space:]]+-[a-zA-Z]*R[a-zA-Z]*[[:space:]]+[^[:space:]]+[[:space:]]+/${sysdirs}([[:space:];&|/]|\$)"
        "(curl|wget|fetch)[[:space:]][^|]*\\|[[:space:]]*(sudo[[:space:]]+)?(sh|bash|zsh|dash|ksh|fish|python[23]?|perl|ruby|node)([[:space:];&|]|\$)"
        ":[[:space:]]*\\([[:space:]]*\\)[[:space:]]*\\{"
        "chmod[[:space:]]+(-[a-zA-Z]+[[:space:]]+)?0?777[[:space:]]+/([[:space:];&|]|\$)"
        "setenforce[[:space:]]+0"
        "(killall|pkill)([[:space:]]+-[a-zA-Z0-9]+)*[[:space:]]+(systemd|init|sshd|NetworkManager|dbus|polkitd)"
    )
    local anchor='(^|[[:space:];&|`(])'
    local danger_re="${anchor}($(IFS='|'; echo "${danger_alts[*]}"))"
    printf '%s' "$cmd" | grep -qE "$danger_re"
}

cmd_cmd() {
    [[ $# -eq 0 ]] && die "usage: balai cmd \"<what you want to do>\""
    ensure_ollama
    ensure_model
    local intent="$*"

    # Auto man-page injection when the intent mentions a known command.
    # Detect candidate commands: any whitespace-separated token that is
    # (a) all-lowercase alnum-ish, (b) actually installed, (c) longer
    # than 2 chars so we don't pull `ls` / `rm` for every query. Take
    # the first match; don't try to pull 5 man pages.
    local man_excerpt="" cand
    for cand in $intent; do
        cand=$(printf '%s' "$cand" | tr -d '`",./:;()<>|&$')
        [[ ${#cand} -ge 3 ]] || continue
        [[ "$cand" =~ ^[a-z][a-z0-9_-]+$ ]] || continue
        # Skip obvious English words so "find all files" doesn't pull `all`.
        case "$cand" in
            all|the|and|for|this|that|with|from|into|some|any|every|new|old|file|files|folder|folders|command|terminal|shell|how|what|why|when|where|show|make|run|list|delete|remove|create|change|edit|open|close|start|stop|search|check|test|my|your|our|use|using) continue ;;
        esac
        if command -v "$cand" &>/dev/null && command -v man &>/dev/null; then
            man_excerpt=$(MANWIDTH=100 man --no-hyphenation "$cand" 2>/dev/null | col -b | head -c 3000)
            [[ -n "$man_excerpt" ]] && { info "injecting man(${cand}) for accuracy"; break; }
        fi
    done

    echo -e "${D}thinking…${N}"
    local base_prompt="Translate this intent into ONE shell command. Respond with exactly ONE fenced \`\`\`bash block containing the command, followed by at most ONE short line. Do not repeat the block. If the task needs a bal* wrapper, prefer it. Intent: ${intent}"
    if [[ -n "$man_excerpt" ]]; then
        stream_chat "Authoritative reference for flag accuracy (use it — don't guess):

=== man excerpt ===
${man_excerpt}
=== end ===

${base_prompt}"
    else
        stream_chat "$base_prompt"
    fi

    local reply cmd
    reply=$(last_reply)
    cmd=$(extract_command "$reply")
    [[ -z "$cmd" ]] && die "no command extracted — try rephrasing"

    # Strip any leading `$ ` prompt, trim outer whitespace.
    cmd="${cmd#$ }"
    cmd="$(echo "$cmd" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')"

    echo ""
    echo -e "${M}${B}suggested:${N}"
    echo -e "${C}$cmd${N}"
    echo ""

    # Safety block: refuse to auto-run obviously destructive commands.
    # See is_destructive() for the full pattern catalogue.
    if is_destructive "$cmd"; then
        warn "this looks DESTRUCTIVE — review manually; not offering to run it."
        if need wl-copy; then
            printf '%s' "$cmd" | wl-copy 2>/dev/null && info "copied to clipboard so you can inspect it"
        fi
        return 1
    fi

    # Also warn (but allow) for anything touching /etc or /boot as root.
    local caution=""
    if echo "$cmd" | grep -qE '(^|[[:space:];|&])sudo[[:space:]]+.*[[:space:]]/(etc|boot|usr|var/lib)(/|[[:space:]]|$)'; then
        caution="modifies system files"
    fi
    [[ -n "$caution" ]] && warn "caution: $caution"

    echo -ne "${Y}run it? [y/N] ${N}"
    local ans
    read -r ans
    ans=$(printf '%s' "$ans" | tr '[:upper:]' '[:lower:]')
    if [[ "$ans" =~ ^(y|yes)$ ]]; then
        echo -e "${D}────────────────────${N}"
        # Use bash -c so user's shell state (aliases, functions) isn't
        # accidentally polluted and so errors don't kill balai via set -e.
        bash -c "$cmd"
    else
        if need wl-copy; then
            printf '%s' "$cmd" | wl-copy 2>/dev/null && ok "copied to clipboard"
        else
            info "not run — command shown above"
        fi
    fi
}

# ──────────────────────────────────────────────────────────────────
# cmd_agent — iterative approval loop.
#
# Given a high-level goal, the model proposes ONE command at a time.
# The user approves (Enter / y), skips (s), or quits (q). Approved
# commands run locally and their output (truncated) is fed back into
# the next turn so the model can reason about what happened.
#
# Ends when:
#   - the model emits a line starting with  DONE   (success),
#   - or                                    ABORT  (gives up),
#   - or the user quits (q),
#   - or MAX_STEPS is reached.
# ──────────────────────────────────────────────────────────────────

AGENT_MAX_STEPS="${BALAI_AGENT_MAX_STEPS:-10}"
AGENT_MAX_OUT_BYTES="${BALAI_AGENT_MAX_OUT_BYTES:-2048}"

# Non-streaming ask used by the agent — we want the full reply back as
# a single string so we can parse DONE/ABORT markers reliably.
ask_once() {
    local prompt="$1" keep_alive="${2:-5m}"
    local payload
    payload=$(python3 - "$MODEL" "$(load_system_prompt)" "$prompt" "$keep_alive" << 'PY'
import json, sys
model, sysp, prompt, keep = sys.argv[1:5]
payload = {
    "model": model, "stream": False, "keep_alive": keep,
    "messages": [
        {"role": "system", "content": sysp},
        {"role": "user",   "content": prompt},
    ],
    "options": {"temperature": 0.2, "top_p": 0.9, "num_ctx": 4096, "num_predict": 400},
}
print(json.dumps(payload))
PY
)
    curl -fsS -N -H 'Content-Type: application/json' -d "$payload" \
        "${OLLAMA_URL}/api/chat" 2>/dev/null \
      | python3 -c 'import sys,json
try: print(json.load(sys.stdin).get("message",{}).get("content","").strip())
except Exception: pass'
}

cmd_agent() {
    [[ $# -eq 0 ]] && die "usage: balai agent \"<high-level goal>\"
       (agent proposes one command, asks before running, loops until done.)"
    ensure_ollama
    ensure_model

    local goal="$*"
    local step=0
    local transcript=""
    local ctx
    ctx=$(gather_ctx 2>/dev/null)

    echo -e "${M}${B}🤖 BalAI agent mode${N}  ${D}(max ${AGENT_MAX_STEPS} steps)${N}"
    echo -e "  goal:  ${C}${goal}${N}"
    echo -e "  rules: Enter=run, s=skip, q=quit   ${D}(Ctrl-C also exits)${N}"
    echo ""

    # Agent-specific prefix ON TOP of the default system prompt, teaching
    # the model the turn-taking protocol.
    local agent_rules="You are now in AGENT MODE — you propose ONE shell command at a time,
and you WILL see its output before proposing the next one.

Protocol each turn:
1. Output EXACTLY one \`\`\`bash fenced block with ONE command (no explanations above the block).
2. Add ONE short line after the block stating what you expect the command to reveal or change.
3. When the overall goal is complete, output a final message whose FIRST LINE is exactly:
   DONE: <one-sentence summary of what was accomplished>
4. If you cannot achieve the goal, reply with a line starting with:
   ABORT: <one-sentence reason>

Never emit more than ONE fenced block per turn. Never ask the user questions —
they can only approve or reject what you propose."

    while (( step < AGENT_MAX_STEPS )); do
        step=$((step + 1))
        echo -e "${M}${B}── step ${step}/${AGENT_MAX_STEPS} ──${N}"

        local turn_prompt
        if [[ $step -eq 1 ]]; then
            turn_prompt="$agent_rules

Current system context:
$ctx

Goal: $goal

Propose the first command."
        else
            turn_prompt="$agent_rules

Current system context:
$ctx

Goal: $goal

Transcript so far:
$transcript

Propose the next command, or emit DONE / ABORT."
        fi

        echo -e "${D}thinking…${N}"
        local reply
        reply=$(ask_once "$turn_prompt")
        if [[ -z "$reply" ]]; then
            warn "no reply from model — aborting"
            return 1
        fi

        # Show the model's message, condensed.
        echo -e "${D}────────────────${N}"
        echo "$reply" | head -6
        echo -e "${D}────────────────${N}"

        # Terminate conditions.
        if printf '%s' "$reply" | grep -qE '^DONE[: ]'; then
            ok "$(printf '%s' "$reply" | grep -m1 -E '^DONE[: ]')"
            return 0
        fi
        if printf '%s' "$reply" | grep -qE '^ABORT[: ]'; then
            warn "$(printf '%s' "$reply" | grep -m1 -E '^ABORT[: ]')"
            return 1
        fi

        # Extract proposed command.
        local cmd
        cmd=$(extract_command "$reply")
        if [[ -z "$cmd" ]]; then
            warn "no command extracted — asking model to retry"
            transcript+="
Step $step: model reply had no command block; asked to retry."
            continue
        fi
        cmd="${cmd#$ }"
        cmd="$(echo "$cmd" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')"

        echo ""
        echo -e "${M}proposed:${N} ${C}${cmd}${N}"

        # Safety: block destructive commands outright.
        if is_destructive "$cmd"; then
            warn "destructive command — refused. Asking model to propose a safer alternative."
            transcript+="
Step $step: proposed '$cmd' — REFUSED (matched destructive pattern)."
            continue
        fi

        # Approval prompt.
        echo -ne "${Y}[Enter] run · [s] skip · [q] quit · [e] edit: ${N}"
        local ans; read -r ans
        case "$ans" in
            q|Q|quit|exit)
                info "agent stopped by user."
                return 0
                ;;
            s|S|skip|n|N|no)
                transcript+="
Step $step: proposed '$cmd' — user SKIPPED."
                continue
                ;;
            e|E|edit)
                echo -ne "${C}edit> ${N}${cmd}"
                # Naive edit: let user retype
                local newcmd
                read -r -e -i "$cmd" newcmd
                [[ -n "$newcmd" ]] && cmd="$newcmd"
                ;;
        esac

        # Run it and capture (head -c for bounded memory).
        local outfile status
        outfile=$(mktemp)
        echo -e "${D}──────── output ────────${N}"
        set +e
        bash -c "$cmd" 2>&1 | tee "$outfile"
        status=${PIPESTATUS[0]}
        set -e
        echo -e "${D}────── exit $status ──────${N}"

        # Truncate output for the next turn.
        local out
        out=$(head -c "$AGENT_MAX_OUT_BYTES" "$outfile")
        local trunc=""
        (( $(wc -c < "$outfile") > AGENT_MAX_OUT_BYTES )) && \
            trunc=" …[truncated to ${AGENT_MAX_OUT_BYTES} bytes]"
        rm -f "$outfile"

        transcript+="
Step $step: ran '$cmd' (exit=$status)${trunc}
Output:
$out"
    done

    warn "max steps reached ($AGENT_MAX_STEPS). Re-run with BALAI_AGENT_MAX_STEPS=N to raise."
    return 1
}

cmd_explain() {
    ensure_ollama
    ensure_model
    local target="${1:-}"
    local content

    # --diff A B : semantic diff of two files/outputs. We run `diff -u`
    # locally (never send whole files) and ask the model to explain
    # what *really* changed.
    if [[ "$target" == "--diff" ]]; then
        local a="${2:-}" b="${3:-}"
        if [[ -z "$a" || -z "$b" ]]; then
            die "usage: balai explain --diff <file-a> <file-b>"
        fi
        [[ -r "$a" ]] || die "can't read: $a"
        [[ -r "$b" ]] || die "can't read: $b"
        local dtmp; dtmp=$(mktemp)
        diff -u -- "$a" "$b" > "$dtmp"
        if [[ ! -s "$dtmp" ]]; then
            rm -f "$dtmp"
            echo "(files are identical)"; return 0
        fi
        local payload
        payload=$(head -c 6000 "$dtmp")
        rm -f "$dtmp"
        stream_chat "Explain this unified diff in plain English. Tell me:
1. What *actually* changed (ignoring whitespace / reordering),
2. Any behaviour impact, and
3. A one-line summary suitable for a commit message.

DIFF:
${payload}"
        return
    fi

    # Piped input always wins: `cat err.log | balai explain`
    if [[ ! -t 0 ]]; then
        content=$(head -c 8000)
        [[ -z "$content" ]] && die "nothing on stdin"
        stream_chat "Explain this output and suggest next steps. Be terse.\n\n${content}"
        return
    fi
    if [[ -z "$target" || "$target" == "--last" ]]; then
        # Read last line of zsh_history (default shell) or bash_history fallback.
        # `fc` only works in interactive shells — we're in a script subshell.
        local histf=""
        for f in "${HISTFILE:-}" "$HOME/.zsh_history" "$HOME/.bash_history"; do
            [[ -n "$f" && -f "$f" ]] && { histf="$f"; break; }
        done
        [[ -z "$histf" ]] && die "no history file found — pipe input instead: <cmd> |& balai explain"
        # zsh extended-history lines look like: ": 1718049310:0;actual cmd"
        content=$(tail -1 "$histf" | sed -E 's/^: [0-9]+:[0-9]+;//')
        [[ -z "$content" ]] && die "history empty"
        stream_chat "Explain what this command does and any pitfalls: ${content}"
    elif [[ -f "$target" ]]; then
        content=$(head -c 8000 "$target")
        stream_chat "Explain this file (truncated to 8KB if larger). File: ${target}\n\n${content}"
    else
        # Treat as literal command/text.
        stream_chat "Explain this: ${target} $*"
    fi
}

cmd_fix() {
    ensure_ollama
    ensure_model
    local err
    if [[ $# -gt 0 ]]; then
        err="$*"
    else
        echo -e "${D}paste error, then Ctrl-D:${N}"
        err=$(cat)
    fi
    [[ -z "$err" ]] && die "no error provided"
    stream_chat "I got this error. Diagnose and give a concrete fix as a command. Be terse.\n\n${err}"
}

# ─── knowledge injection: man pages ────────────────────────────
# Feed a command's man page (first ~4 KB) to the model and let it
# answer anything about that command. Much more accurate than asking
# the 1.5B model from its pre-trained memory — it has seen Qwen's
# view of `find` flags, which may be outdated.
cmd_man() {
    [[ $# -eq 0 ]] && die "usage: balai man <command> [question]"
    ensure_ollama
    ensure_model
    local cmd_name="$1"; shift || true
    local question="${*:-}"
    command -v man &>/dev/null || die "man(1) not installed"
    local page
    # col -b strips backspace-overstrike that some man pages use for bold.
    page=$(MANWIDTH=100 man --no-hyphenation "$cmd_name" 2>/dev/null | col -b | head -c 4500)
    if [[ -z "$page" ]]; then
        die "no man page for '$cmd_name'"
    fi
    local ask="${question:-Give a 5-line cheat sheet with the most useful invocations of this command.}"
    stream_chat "You have the FOLLOWING man-page excerpt as authoritative reference. Use it — don't guess flags.

=== man ${cmd_name} (first 4500 bytes) ===
${page}
=== end ===

Question: ${ask}"
}

# Natural-language journal query. Reads the last N log lines (default
# 500) filtered by priority/since, then asks the model to answer the
# operator's question. Never pipes historical logs through — the raw
# journal can be huge; we tail and truncate aggressively.
cmd_journal() {
    ensure_ollama
    ensure_model
    local since="1 hour ago"
    local prio="warning"
    local lines=500
    # lightweight flag parsing; bare question captured in $*
    local args=()
    while (($#)); do
        case "$1" in
            --since)  since="$2"; shift 2 ;;
            --prio)   prio="$2";  shift 2 ;;
            --lines)  lines="$2"; shift 2 ;;
            -h|--help)
                echo "usage: balai journal [--since '1h'] [--prio warning|err] [--lines 500] \"<question>\""
                return 0 ;;
            *) args+=("$1"); shift ;;
        esac
    done
    local question="${args[*]:-What went wrong recently? Be terse.}"
    command -v journalctl &>/dev/null || die "journalctl not available"
    local jbuf
    jbuf=$(journalctl --no-pager --priority="$prio" --since="$since" --lines="$lines" 2>/dev/null | tail -c 6000)
    [[ -n "$jbuf" ]] || { echo "no journal entries matched"; return 0; }
    stream_chat "You are a systems operator. Read this journal excerpt and answer:

${question}

Rules:
- Reference concrete unit names and error codes you see in the excerpt.
- If there are multiple unrelated issues, group them.
- End with ONE fenced bash block showing the command that would fix the most important issue (or investigate further), or '(no action — healthy)' if nothing is wrong.

=== journalctl --priority=${prio} --since='${since}' (tail) ===
${jbuf}
=== end ==="
}

# Explain a systemd unit: show its resolved content + AI commentary on
# what it does, security posture, and common mis-configs.
cmd_unit() {
    [[ $# -eq 0 ]] && die "usage: balai unit <unit-name>"
    ensure_ollama
    ensure_model
    local unit="$1"
    command -v systemctl &>/dev/null || die "systemctl not available"
    local content status
    content=$(systemctl cat "$unit" 2>/dev/null | head -c 4000)
    if [[ -z "$content" ]]; then
        die "unknown unit: $unit"
    fi
    status=$(systemctl status "$unit" --no-pager -l 2>/dev/null | head -20)
    stream_chat "Explain this systemd unit and flag anything notable.

=== systemctl cat ${unit} ===
${content}
=== systemctl status ${unit} (head) ===
${status}
=== end ===

Cover: (1) what service this is / what it depends on, (2) security posture (Restart, NoNewPrivileges, CapabilityBoundingSet, ProtectSystem, hardening directives present or missing), (3) any misconfiguration you notice, (4) one command to inspect it further. Be terse — one short bullet per point."
}

# Refuse / warn when running the model on a dying battery. Cold-start
# of Qwen2.5 pulls ~300 J from the pack; running `balai` back-to-back
# can cost 1-2 % of charge. Surface the cost instead of hiding it.
#   Behaviour:
#     battery >= 20% or AC : silent
#     battery 10-19%       : one-line warning, still runs
#     battery <10%         : refuses unless BALAI_FORCE=1
check_battery_guard() {
    [[ "${BALAI_FORCE:-0}" == "1" ]] && return 0
    local bat cap status ac=0
    for b in /sys/class/power_supply/BAT*; do
        [[ -d "$b" ]] || continue
        cap=$(cat "$b/capacity" 2>/dev/null)
        status=$(cat "$b/status" 2>/dev/null)
        break
    done
    for a in /sys/class/power_supply/A[CD]*; do
        [[ "$(cat "$a/online" 2>/dev/null)" == "1" ]] && ac=1
    done
    [[ -z "$cap" || "$ac" == "1" ]] && return 0
    # Only gate on "Discharging" states.
    [[ "$status" == "Discharging" ]] || return 0
    if (( cap < 10 )); then
        warn "battery at ${cap}% — balai refuses to run (LLMs are expensive on a dying pack)."
        warn "override with:  BALAI_FORCE=1 balai ..."
        return 1
    fi
    if (( cap < 20 )); then
        warn "battery at ${cap}% — consider: bal saver"
    fi
    return 0
}

# Health check: collect signals from the local system (failed services,
# high RAM, high load, pending updates, .pacnew files, broken VPN, etc),
# then ask the model to summarise and suggest next steps. Pure read-only.
cmd_doctor() {
    ensure_ollama
    ensure_model
    info "gathering diagnostics (read-only, ~5 s)…"

    local tmpf
    tmpf=$(mktemp)
    {
        echo "### Host: $(hostname) — $(date -Is 2>/dev/null)"
        echo ""
        echo "### Context (balai view)"
        gather_ctx 2>/dev/null
        echo ""
        echo "### Failed systemd units"
        systemctl --failed --no-legend 2>/dev/null | head -20 || echo "(systemctl unavailable)"
        echo ""
        echo "### Services of interest"
        for svc in NetworkManager sddm tlp nftables dnscrypt-proxy tor ollama suricata wg-quick@wg0 ufw firewalld; do
            state=$(systemctl is-active "$svc" 2>/dev/null || true)
            enabled=$(systemctl is-enabled "$svc" 2>/dev/null || true)
            [[ -n "$state" || -n "$enabled" ]] && printf '  %-22s active=%-10s enabled=%s\n' "$svc" "${state:-n/a}" "${enabled:-n/a}"
        done
        echo ""
        echo "### Recent journal errors (last 20)"
        journalctl -p err -n 20 --no-pager 2>/dev/null | tail -20 || echo "(journalctl unavailable)"
        echo ""
        echo "### Disk pressure"
        df -h / /boot /var /home 2>/dev/null | grep -vE '^(tmpfs|devtmpfs|efivarfs)' | head -10
        echo ""
        echo "### Memory + swap"
        free -h 2>/dev/null | head -4
        echo ""
        echo "### .pacnew files (need manual merge)"
        find /etc -name '*.pacnew' 2>/dev/null | head -10
        echo ""
        echo "### Pacman last transaction"
        tail -40 /var/log/pacman.log 2>/dev/null | tail -20
        echo ""
        echo "### Kernel ring-buffer tail"
        dmesg --ctime 2>/dev/null | tail -15 || tail -15 /var/log/dmesg 2>/dev/null
    } > "$tmpf"

    # Show raw diagnostics first (condensed)
    echo -e "${D}─── raw diagnostics (for reference) ────────────────${N}" >&2
    head -80 "$tmpf" >&2
    echo -e "${D}────────────────────────────────────────────────────${N}" >&2
    echo ""
    echo -e "${M}${B}AI summary:${N}"
    stream_chat "You are running as a system doctor. Read the diagnostics below and produce: (1) ONE line overall verdict (healthy / minor issues / attention needed), (2) up to 3 concrete issues as bullet points with the exact bal* or systemctl command to fix each. Be terse. Do NOT emit more than one fenced block per issue.

DIAGNOSTICS:
$(cat "$tmpf")"
    rm -f "$tmpf"
}

# ─── persistent memory (notes) ──────────────────────────────────
# Plain-text bullet file that the user curates. Injected into every
# prompt so the model remembers preferences across sessions (model size,
# preferred editor, home network SSID, allergies to certain commands…).
cmd_remember() {
    [[ $# -eq 0 ]] && die "usage: balai remember \"I prefer btrfs over ext4\""
    mkdir -p "$(dirname "$NOTES_FILE")"
    local line="$*"
    # Strip leading dashes/bullets the user may have typed.
    line="${line#- }"
    line="${line#* }"
    printf -- '- %s\n' "$*" >> "$NOTES_FILE"
    ok "remembered. (${NOTES_FILE})"
}

# Thumbs-up/down feedback. Thumbs-down with a reason appends a "Do NOT"
# line to notes.md so the model sees it on every future turn and avoids
# repeating the same bad advice. Thumbs-up writes to a separate log
# (not injected) for auditing what the user liked.
cmd_feedback() {
    local verdict="${1:-}"; shift || true
    local reason="$*"
    case "$verdict" in
        up|good|+1|👍)
            mkdir -p "$(dirname "$NOTES_FILE")"
            local log="${NOTES_FILE%.md}-likes.log"
            local last; last=$(last_reply 2>/dev/null | head -c 200)
            printf '%s  👍  %s\n' "$(date -Iseconds)" "${reason:-(no reason)}"   >> "$log"
            [[ -n "$last" ]] && printf '   ↳ %s…\n' "$last"                     >> "$log"
            ok "noted (${log})"
            ;;
        down|bad|-1|👎)
            [[ -n "$reason" ]] || { echo "usage: balai thumbs down \"<what was wrong>\""; return 1; }
            mkdir -p "$(dirname "$NOTES_FILE")"
            # Capture context about the rejected reply so the user can
            # audit later (full reply NOT injected — only the user's
            # one-line critique goes into notes).
            local rej_log="${NOTES_FILE%.md}-rejections.log"
            {
                printf '=== %s ===\n' "$(date -Iseconds)"
                printf 'user said: %s\n' "$reason"
                printf 'last reply:\n'
                last_reply | sed 's/^/  /'
                printf '\n'
            } >> "$rej_log"
            # Inject the correction as a negation the model will always see.
            printf -- '- Do NOT: %s (user feedback, %s)\n' "$reason" "$(date +%Y-%m-%d)" >> "$NOTES_FILE"
            ok "logged rejection and added avoidance note. BalAI won't repeat that."
            ;;
        *)
            echo "usage: balai thumbs {up|down} \"<reason>\""
            return 1
            ;;
    esac
}

cmd_forget() {
    if [[ ! -s "$NOTES_FILE" ]]; then
        echo "(nothing to forget — no notes yet)"; return 0
    fi
    if [[ $# -eq 0 ]]; then
        # Confirm total wipe.
        echo -e "${Y}This will delete ALL remembered notes:${N}"
        sed 's/^/  /' "$NOTES_FILE"
        printf '%s' "wipe everything? [y/N] "
        local ans; read -r ans
        ans=$(printf '%s' "$ans" | tr '[:upper:]' '[:lower:]')
        [[ "$ans" == "y" || "$ans" == "yes" ]] || { echo "cancelled"; return 0; }
        : > "$NOTES_FILE"
        ok "all notes cleared"
        return 0
    fi
    local pattern="$*"
    local tmpf
    tmpf=$(mktemp)
    grep -viF -- "$pattern" "$NOTES_FILE" > "$tmpf" || true
    local before after
    before=$(wc -l < "$NOTES_FILE" 2>/dev/null | tr -d ' ')
    after=$(wc -l < "$tmpf" 2>/dev/null | tr -d ' ')
    mv "$tmpf" "$NOTES_FILE"
    ok "removed $((before - after)) line(s) matching '$pattern'"
}

cmd_memory() {
    if [[ ! -s "$NOTES_FILE" ]]; then
        echo "(no notes yet — add some with: balai remember \"...\")"
        return 0
    fi
    echo -e "${B}Remembered notes:${N}  ${D}${NOTES_FILE}${N}"
    cat "$NOTES_FILE"
}

# One-line proactive tip based on current system state. Used by
# `balmonitor --once` footer and `balai tip`. Non-streaming, <80 chars
# ideal, times out fast so TUI callers are never blocked.
cmd_tip() {
    ensure_ollama 2>/dev/null || { echo "(balai offline)"; return 0; }
    ensure_model   2>/dev/null || { echo "(model missing)"; return 0; }
    local ctx
    ctx=$(gather_ctx 2>/dev/null)
    local prompt="Given this BalOS snapshot:

$ctx

If there is ONE small optimisation or concern worth mentioning right now, reply with a single line of at most 90 characters starting with '→ '. If everything looks fine, reply exactly: → all green."
    # Silent failure if ollama is flaky — tip is decorative.
    timeout 12 curl -fsS "${OLLAMA_URL}/api/generate" \
        -d "$(python3 -c "import json,sys; print(json.dumps({'model':'${MODEL}','prompt':sys.argv[1],'stream':False,'options':{'num_predict':60,'temperature':0.3}}))" "$prompt")" \
        2>/dev/null \
        | python3 -c 'import sys,json
try: print(json.load(sys.stdin).get("response","").strip().splitlines()[0])
except: pass' \
        || true
}

# ─── cmd_perf: local tokens-per-second benchmark ───────────────
# Hits ollama with a fixed prompt (num_predict=128) three times and
# reports mean / best. Useful after kernel upgrades or when comparing
# models. Bounded: never runs longer than ~30 s total.
cmd_perf() {
    ensure_ollama
    ensure_model
    info "benchmarking ${MODEL} (3 runs × 128 tokens)…"
    python3 - "$OLLAMA_URL" "$MODEL" << 'PY'
import json, sys, time, urllib.request
url, model = sys.argv[1:3]
prompt = "List the first 25 prime numbers, separated by commas."
runs = []
for i in range(3):
    body = json.dumps({
        "model": model,
        "prompt": prompt,
        "stream": False,
        "options": {"temperature": 0.0, "num_predict": 128},
    }).encode()
    t0 = time.monotonic()
    try:
        req = urllib.request.Request(
            f"{url}/api/generate",
            data=body,
            headers={"Content-Type": "application/json"},
        )
        with urllib.request.urlopen(req, timeout=25) as r:
            data = json.load(r)
    except Exception as e:
        print(f"run {i+1}: error — {e}")
        continue
    dt = time.monotonic() - t0
    eval_count = data.get("eval_count", 0) or 0
    eval_ns    = data.get("eval_duration", 0) or 0
    load_ns    = data.get("load_duration", 0) or 0
    tps = (eval_count / (eval_ns/1e9)) if eval_ns else 0
    runs.append({"tps": tps, "tokens": eval_count, "wall_s": dt, "load_s": load_ns/1e9})
    print(f"  run {i+1}: {tps:6.1f} tok/s  ({eval_count} tok, wall {dt:.2f} s, load {load_ns/1e9:.2f} s)")
if runs:
    best = max(r["tps"] for r in runs)
    mean = sum(r["tps"] for r in runs) / len(runs)
    print()
    print(f"  mean: {mean:6.1f} tok/s")
    print(f"  best: {best:6.1f} tok/s")
PY
}

# ─── cmd_serve: OpenAI-compatible proxy on 127.0.0.1:11435 ─────
# Lightweight HTTP shim that speaks /v1/chat/completions the way
# OpenAI clients expect, then forwards to ollama /api/chat with the
# BalAI system prompt and user notes PRE-APPLIED. Lets any
# OpenAI-compatible IDE plugin (Continue, Cursor-alts, Aider, …)
# consume BalAI transparently.
#
# Ollama itself does expose /v1/chat/completions but it doesn't know
# about our system prompt or notes — that's what this shim adds.
#
# Run in foreground (Ctrl-C to stop) or as a systemd user service
# (see /etc/systemd/user/balai-serve.service).
cmd_serve() {
    ensure_ollama
    ensure_model
    local addr="${1:-127.0.0.1:11435}"
    info "OpenAI-compatible proxy at http://${addr}/v1/chat/completions"
    info "  ctrl-c to stop. Upstream: ${OLLAMA_URL}  Model: ${MODEL}"
    exec python3 - "$addr" "$OLLAMA_URL" "$MODEL" "$(load_system_prompt)" "$NOTES_FILE" << 'PY'
import sys, json, http.server, socketserver, threading, urllib.request
from urllib.parse import urlparse

addr, ollama_url, default_model, sys_prompt, notes_file = sys.argv[1:6]
host, port = addr.rsplit(":", 1)
port = int(port)

def _notes():
    try:
        with open(notes_file) as f:
            return f.read()[:2048]
    except OSError:
        return ""

def _full_system():
    base = sys_prompt
    n = _notes()
    if n:
        base += "\n\nUser preferences and notes (remember these):\n" + n
    return base

class Handler(http.server.BaseHTTPRequestHandler):
    def log_message(self, fmt, *args):
        # quieter than default — only log errors
        if "error" in fmt.lower() or "404" in fmt % args:
            super().log_message(fmt, *args)

    def _json(self, code, obj):
        body = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        p = urlparse(self.path)
        if p.path == "/v1/models":
            try:
                with urllib.request.urlopen(f"{ollama_url}/api/tags", timeout=3) as r:
                    tags = json.load(r)
                models = [{"id": m.get("name"), "object": "model",
                           "created": 0, "owned_by": "balai"}
                          for m in tags.get("models", [])]
                return self._json(200, {"object": "list", "data": models})
            except Exception as e:
                return self._json(502, {"error": str(e)})
        if p.path in ("/", "/v1/health"):
            return self._json(200, {"status": "ok", "model": default_model})
        return self._json(404, {"error": "not found"})

    def do_POST(self):
        p = urlparse(self.path)
        if p.path != "/v1/chat/completions":
            return self._json(404, {"error": "not found"})
        try:
            length = int(self.headers.get("Content-Length", "0"))
            req = json.loads(self.rfile.read(length) or b"{}")
        except Exception as e:
            return self._json(400, {"error": f"bad json: {e}"})

        model = req.get("model") or default_model
        # Prepend our system prompt unless the caller already supplied one.
        msgs = list(req.get("messages") or [])
        if not any(m.get("role") == "system" for m in msgs):
            msgs.insert(0, {"role": "system", "content": _full_system()})
        stream = bool(req.get("stream"))
        options = {
            "temperature": float(req.get("temperature", 0.2)),
            "top_p":       float(req.get("top_p", 0.9)),
            "num_predict": int(req.get("max_tokens", 512)),
        }
        body = json.dumps({
            "model": model, "messages": msgs,
            "stream": stream, "options": options,
        }).encode()

        upstream = urllib.request.Request(
            f"{ollama_url}/api/chat",
            data=body,
            headers={"Content-Type": "application/json"},
        )
        try:
            r = urllib.request.urlopen(upstream, timeout=180)
        except Exception as e:
            return self._json(502, {"error": f"upstream: {e}"})

        if not stream:
            # Non-streaming — translate single response
            try:
                data = json.load(r)
            except Exception as e:
                return self._json(502, {"error": f"decode: {e}"})
            content = data.get("message", {}).get("content", "")
            resp = {
                "id": "chatcmpl-balai",
                "object": "chat.completion",
                "created": 0,
                "model": model,
                "choices": [{
                    "index": 0,
                    "message": {"role": "assistant", "content": content},
                    "finish_reason": "stop",
                }],
                "usage": {
                    "prompt_tokens":     data.get("prompt_eval_count", 0),
                    "completion_tokens": data.get("eval_count", 0),
                    "total_tokens":      data.get("prompt_eval_count", 0) + data.get("eval_count", 0),
                },
            }
            return self._json(200, resp)

        # Streaming — translate NDJSON ollama → SSE OpenAI
        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream")
        self.send_header("Cache-Control", "no-cache")
        self.end_headers()
        try:
            for raw in r:
                line = raw.decode(errors="replace").strip()
                if not line:
                    continue
                try:
                    obj = json.loads(line)
                except Exception:
                    continue
                piece = obj.get("message", {}).get("content", "")
                if piece:
                    chunk = {
                        "id": "chatcmpl-balai", "object": "chat.completion.chunk",
                        "model": model,
                        "choices": [{"index": 0,
                                     "delta": {"role": "assistant", "content": piece},
                                     "finish_reason": None}],
                    }
                    self.wfile.write(f"data: {json.dumps(chunk)}\n\n".encode())
                    self.wfile.flush()
                if obj.get("done"):
                    self.wfile.write(b"data: [DONE]\n\n")
                    self.wfile.flush()
                    break
        except (BrokenPipeError, ConnectionResetError):
            return

class ReusableTCPServer(socketserver.ThreadingMixIn, http.server.HTTPServer):
    allow_reuse_address = True
    daemon_threads = True

srv = ReusableTCPServer((host, port), Handler)
try:
    srv.serve_forever()
except KeyboardInterrupt:
    srv.shutdown()
PY
}

cmd_setup() {
    info "checking ollama service…"
    if ! need ollama; then
        die "ollama not installed — pacman -S ollama"
    fi
    if systemctl is-enabled ollama &>/dev/null; then
        ok "ollama service enabled"
    else
        info "enabling ollama…"
        sudo systemctl enable --now ollama || warn "could not enable (not fatal on live ISO)"
    fi
    ensure_ollama
    ensure_model
    ok "BalAI ready. Try: balai \"how do I enable stealth mode\""
}

cmd_status() {
    echo -e "${B}BalAI status${N}"
    echo -e "  version:  v${VERSION}"
    echo -e "  model:    ${MODEL}"
    echo -e "  host:     ${OLLAMA_HOST}"
    if curl -fsS --max-time 2 "${OLLAMA_URL}/api/tags" &>/dev/null; then
        echo -e "  ollama:   ${G}● running${N}"
        local tags
        tags=$(curl -fsS "${OLLAMA_URL}/api/tags" | python3 -c 'import sys,json
d=json.load(sys.stdin); print("  models:  ", ", ".join(m["name"] for m in d.get("models",[])) or "(none)")')
        echo -e "$tags"
    else
        echo -e "  ollama:   ${Y}○ not running${N} (balai will start on-demand)"
    fi
    local ram
    ram=$(free -m | awk '/^Mem:/{printf "%d/%d MB", $3, $2}')
    echo -e "  RAM:      ${ram}"
}

cmd_model() {
    ensure_ollama
    local sub="${1:-list}"; shift || true
    case "$sub" in
        list|ls)
            curl -fsS "${OLLAMA_URL}/api/tags" | python3 -c 'import sys,json
d=json.load(sys.stdin)
for m in d.get("models",[]):
    sz=m.get("size",0)/1e9
    print(f"  {m[\"name\"]:<40} {sz:>6.2f} GB")'
            ;;
        pull)
            [[ $# -eq 0 ]] && die "usage: balai model pull <model>"
            ollama pull "$1"
            ;;
        rm|remove|delete)
            [[ $# -eq 0 ]] && die "usage: balai model rm <model>"
            ollama rm "$1"
            ;;
        default)
            [[ $# -eq 0 ]] && { echo "current default: $MODEL_DEFAULT"; echo "use: export BALAI_MODEL=<name> in ~/.zshrc"; return 0; }
            warn "to change permanently, add: export BALAI_MODEL=\"$1\" to ~/.zshrc"
            ;;
        *) die "usage: balai model [list|pull|rm|default] [name]" ;;
    esac
}

cmd_usage() {
cat << EOF
${G}${B}BalAI${N} ${D}v${VERSION}${N} — local offline assistant (${MODEL})

${B}USAGE${N}
  balai                          ${D}# interactive chat${N}
  balai "question"               ${D}# one-shot query${N}
  balai cmd  "<intent>"          ${D}# generate command, confirm, run${N}
  balai agent "<goal>"           ${D}# iterative loop: propose → approve → run → observe${N}
  balai explain <file|--last>    ${D}# explain file or last command${N}
  balai fix  [error text]        ${D}# diagnose + suggest fix${N}
  balai ctx                      ${D}# show system context balai sees${N}
  balai doctor                   ${D}# diagnose system + AI summary${N}
  balai tip                      ${D}# one-line proactive suggestion${N}
  balai man <cmd> [q]            ${D}# inject man page; optional question${N}
  balai journal "<q>"            ${D}# natural-language journalctl query${N}
  balai unit <unit>              ${D}# show + explain a systemd unit${N}
  balai perf                     ${D}# tokens-per-second benchmark${N}
  balai serve [addr]             ${D}# OpenAI-compat proxy (default 127.0.0.1:11435)${N}
  balai remember "<fact>"        ${D}# add a persistent note the AI will always see${N}
  balai thumbs {up|down} "<r>"   ${D}# feedback; 'down' teaches the model to avoid that advice${N}
  balai memory                   ${D}# show remembered notes${N}
  balai forget [pattern]         ${D}# drop notes matching pattern (or all)${N}
  balai model [list|pull|rm]     ${D}# manage local models${N}
  balai status                   ${D}# service + model health${N}
  balai setup                    ${D}# first-run: enable service + pull model${N}

${B}ENV${N}
  BALAI_MODEL=<name>           ${D}# override default model (e.g. qwen2.5:3b-instruct-q4_K_M)${N}
  BALAI_SYSTEM_PROMPT=<path>   ${D}# override system prompt file${N}
  BALAI_CTX_MODE=auto|always|never ${D}# context injection (default: auto)${N}
  OLLAMA_HOST=host:port

${B}EXAMPLES${N}
  ${D}balai "how do I enable VPN kill-switch"${N}
  ${D}balai cmd "find all files modified in last 10 minutes"${N}
  ${D}balai explain /etc/nftables.conf${N}
  ${D}balai fix "permission denied"${N}

${B}NOTE${N}  100% offline. No data leaves this machine.
EOF
}

# ─── dispatcher ──────────────────────────────────────────────────
CMD="${1:-}"; shift || true

case "$CMD" in
    ""|chat|interactive)  cmd_chat ;;
    cmd|do|run|gen)       cmd_cmd "$@" ;;
    agent|loop|iterate)   cmd_agent "$@" ;;
    explain|exp|why)      cmd_explain "$@" ;;
    fix|err|error)        cmd_fix "$@" ;;
    ctx|context)          cmd_ctx ;;
    doctor|diag|diagnose) cmd_doctor ;;
    tip|suggest|hint)     cmd_tip ;;
    man|cheat|howto)      cmd_man "$@" ;;
    journal|log|logs)     cmd_journal "$@" ;;
    unit|service)         cmd_unit "$@" ;;
    serve|proxy|api)      cmd_serve "$@" ;;
    perf|bench|benchmark) cmd_perf ;;
    remember|note)        cmd_remember "$@" ;;
    thumbs|feedback)      cmd_feedback "$@" ;;
    forget)               cmd_forget "$@" ;;
    memory|notes|recall)  cmd_memory ;;
    setup|init)           cmd_setup ;;
    status|health)        cmd_status ;;
    model|models)         cmd_model "$@" ;;
    help|-h|--help)       cmd_usage ;;
    version|-v|--version) echo "BalAI v${VERSION}" ;;
    # Otherwise treat the whole command-line as a one-shot query.
    *)                    cmd_once "$CMD" "$@" ;;
esac
