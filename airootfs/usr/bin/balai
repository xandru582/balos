#!/usr/bin/env bash
# balai — BalOS local AI assistant (offline, ~1GB Qwen2.5-1.5B)
# Talks to local ollama HTTP API on 127.0.0.1:11434.
# You are NOT forwarding anything to the cloud — 100% local.
#
# Why 1.5B and not smaller? Empirical testing: Qwen2.5-0.5B hallucinates
# commands that don't exist ("bal wipe"), enters token-repetition loops,
# and gives wrong answers ~50% of the time. Qwen2.5-1.5B is the smallest
# Qwen that reliably follows the BalOS system prompt. Users with more RAM
# can upgrade to 3b/7b via: BALAI_MODEL=qwen2.5:3b-instruct-q4_K_M
set -uo pipefail

VERSION="1.0.1-dark"
MODEL_DEFAULT="qwen2.5:1.5b-instruct-q4_K_M"
MODEL="${BALAI_MODEL:-$MODEL_DEFAULT}"
SYSTEM_PROMPT_FILE="${BALAI_SYSTEM_PROMPT:-/usr/share/balos/ai/system-prompt.md}"
OLLAMA_HOST="${OLLAMA_HOST:-127.0.0.1:11434}"
OLLAMA_URL="http://${OLLAMA_HOST}"
HISTORY_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/balai/history.jsonl"
LAST_CMD_FILE="${XDG_RUNTIME_DIR:-/tmp}/balai-last-suggested"

G='\033[0;32m'; R='\033[0;31m'; Y='\033[1;33m'; C='\033[0;36m'; M='\033[0;35m'
B='\033[1m'; D='\033[2m'; N='\033[0m'

# ─── utilities ───────────────────────────────────────────────────
need() { command -v "$1" &>/dev/null; }
die()  { echo -e "${R}✗ $*${N}" >&2; exit 1; }
info() { echo -e "${C}▸${N} $*" >&2; }
warn() { echo -e "${Y}⚠ $*${N}" >&2; }
ok()   { echo -e "${G}✓${N} $*" >&2; }

# Start ollama service if not running (idempotent).
# On BalOS the package installs a systemd service that reads models from
# /var/lib/ollama/.ollama/models (HOME=/var/lib/ollama). We respect that.
# Fallback path (user-level serve) mirrors the same HOME so both paths see
# the models baked into squashfs during the ISO build.
ensure_ollama() {
    if curl -fsS --max-time 2 "${OLLAMA_URL}/api/tags" &>/dev/null; then
        return 0
    fi
    info "ollama not responding — starting service…"
    if systemctl is-enabled ollama &>/dev/null 2>&1; then
        sudo systemctl start ollama 2>/dev/null || true
    elif command -v systemctl &>/dev/null && systemctl cat ollama &>/dev/null; then
        sudo systemctl start ollama 2>/dev/null || true
    else
        # user-level fallback (e.g. live ISO without service installed).
        # Point at the system model dir so baked-in models are visible.
        export OLLAMA_MODELS="${OLLAMA_MODELS:-/var/lib/ollama/.ollama/models}"
        [[ ! -r "$OLLAMA_MODELS" ]] && export OLLAMA_MODELS="$HOME/.ollama/models"
        nohup ollama serve &>/dev/null &
        disown
    fi
    # wait up to 15 s (startup can be slow first time)
    for i in {1..30}; do
        sleep 0.5
        curl -fsS --max-time 1 "${OLLAMA_URL}/api/tags" &>/dev/null && { ok "ollama up"; return 0; }
    done
    die "ollama failed to start — try: sudo systemctl start ollama"
}

# Check if model is present locally; pull if missing (requires network).
# Uses proper JSON parsing (grep on JSON is fragile due to whitespace).
ensure_model() {
    local m="${1:-$MODEL}"
    local found
    found=$(curl -fsS --max-time 3 "${OLLAMA_URL}/api/tags" 2>/dev/null \
        | python3 -c "
import sys, json
try:
    d = json.load(sys.stdin)
    names = {mod['name'] for mod in d.get('models', [])}
    print('yes' if '$m' in names else 'no')
except Exception:
    print('no')" 2>/dev/null)
    [[ "$found" == "yes" ]] && return 0
    warn "model ${m} not found locally"
    # Soft network probe: try curl against ollama registry (doesn't reveal
    # user activity). Ping to 1.1.1.1 fails under fortress firewall.
    if ! curl -fsS --max-time 3 -o /dev/null https://registry.ollama.ai 2>/dev/null; then
        die "no network — cannot pull model. Connect to internet or pick a model that's already installed (\`balai model list\`)."
    fi
    local sz="~1 GB"
    [[ "$m" == *"0.5b"* ]] && sz="~400 MB"
    [[ "$m" == *"3b"*   ]] && sz="~2 GB"
    [[ "$m" == *"7b"*   ]] && sz="~4 GB"
    echo -ne "${Y}pull ${m} now? (${sz}) [Y/n] ${N}"
    read -r ans
    ans=$(printf '%s' "$ans" | tr '[:upper:]' '[:lower:]')
    [[ "$ans" =~ ^(n|no)$ ]] && die "aborted"
    ollama pull "$m" || die "pull failed"
}

# Return the system prompt string (used as 'system' field in API payload).
load_system_prompt() {
    if [[ -r "$SYSTEM_PROMPT_FILE" ]]; then
        cat "$SYSTEM_PROMPT_FILE"
    else
        # Fallback minimal prompt.
        echo "You are BalAI, a terse CLI assistant for BalOS (Arch-based). Suggest commands; never run them. Prefer bal* wrappers when they fit."
    fi
}

# Build JSON payload safely.
# Args: mode (chat|generate), prompt, [keep_alive]
build_payload() {
    local mode="$1" user_prompt="$2" keep_alive="${3:-5m}"
    local sysp
    sysp=$(load_system_prompt)

    # Use python for safe JSON escaping (python is in base packages)
    python3 - "$MODEL" "$sysp" "$user_prompt" "$keep_alive" << 'PY'
import json, sys
model, sysp, prompt, keep = sys.argv[1:5]
payload = {
    "model": model,
    "stream": True,
    "keep_alive": keep,
    "messages": [
        {"role": "system", "content": sysp},
        {"role": "user", "content": prompt},
    ],
    "options": {
        "temperature": 0.3,
        "top_p": 0.9,
        "num_ctx": 4096,
        "num_predict": 512,
    },
}
print(json.dumps(payload))
PY
}

# Stream a /api/chat response, print assistant text, capture full text.
# Uses a SINGLE python subprocess as streaming parser (fast — no per-line fork).
stream_chat() {
    local prompt="$1"
    local payload
    payload=$(build_payload chat "$prompt") || return 1

    mkdir -p "$(dirname "$HISTORY_FILE")" 2>/dev/null || true
    printf '%s\n' "$(date -Iseconds) USER $prompt" >> "$HISTORY_FILE" 2>/dev/null || true

    local capture
    capture=$(mktemp)
    curl -fsS -N -H 'Content-Type: application/json' \
         -d "$payload" "${OLLAMA_URL}/api/chat" 2>/dev/null \
      | python3 -u -c '
import sys, json
for raw in sys.stdin:
    raw = raw.strip()
    if not raw:
        continue
    try:
        d = json.loads(raw)
    except Exception:
        continue
    c = d.get("message", {}).get("content", "")
    if c:
        sys.stdout.write(c)
        sys.stdout.flush()
' | tee "$capture"

    echo ""
    local full
    full=$(cat "$capture")
    rm -f "$capture"
    printf '%s\n' "$(date -Iseconds) ASSISTANT $full" >> "$HISTORY_FILE" 2>/dev/null || true
    # Always save full reply to $LAST_CMD_FILE — callers read from there
    # (avoids double-output when capturing via $(stream_chat ...)).
    echo "$full" > "$LAST_CMD_FILE" 2>/dev/null || true
}

# Read the last assistant reply (populated by stream_chat).
last_reply() { cat "$LAST_CMD_FILE" 2>/dev/null; }

# Extract first command from assistant output — tries multiple formats.
# 1. Fenced ```bash / ```sh / ``` block (strict, most common).
# 2. $-prefixed line.
# 3. Single inline `backtick` span when the response is a one-liner.
extract_command() {
    local txt="$1"
    local cmd
    # 1. Fenced code block. Stop after first block.
    cmd=$(echo "$txt" | awk '
        BEGIN { inblk=0; done=0 }
        done { next }
        /^```(bash|sh|shell)?[[:space:]]*$/ {
            if (inblk) { done=1 }
            inblk = !inblk
            next
        }
        inblk { print }
    ' | head -20)
    if [[ -n "${cmd//[[:space:]]/}" ]]; then
        printf '%s\n' "$cmd"
        return 0
    fi
    # 2. Shell-prompt-prefixed line (`$ command`).
    cmd=$(echo "$txt" | grep -E '^[[:space:]]*\$[[:space:]]' | head -1 \
         | sed -E 's/^[[:space:]]*\$[[:space:]]+//')
    if [[ -n "$cmd" ]]; then
        printf '%s\n' "$cmd"
        return 0
    fi
    # 3. Single inline backtick span — only if response is short (≤3 lines).
    local lines
    lines=$(echo "$txt" | wc -l)
    if (( lines <= 3 )); then
        cmd=$(echo "$txt" | grep -oE '`[^`]+`' | head -1 | tr -d '`')
        [[ -n "$cmd" ]] && { printf '%s\n' "$cmd"; return 0; }
    fi
    return 1
}

# ─── context gathering ─────────────────────────────────────────
# Collects a SHORT summary of current system state that can be fed to
# the model so it answers with awareness of the user's real situation
# ("my battery" → knows you're on 14%, etc.). Everything is read-only
# and best-effort; individual failures are swallowed.
gather_ctx() {
    local out=""
    local line

    # Power profile — written by balboost / balsaver. Legacy fallback to
    # /run/balos-mode (the old pre-unified path).
    for pf in /run/balos/power-profile /run/balos-mode /tmp/balos-mode; do
        if [[ -r "$pf" ]]; then
            line=$(cat "$pf" 2>/dev/null)
            [[ -n "$line" ]] && { out+="power-profile: $line"$'\n'; break; }
        fi
    done

    # Firewall tier — written by balshield
    if [[ -r /run/balos/shield-tier ]]; then
        line=$(cat /run/balos/shield-tier 2>/dev/null)
        [[ -n "$line" ]] && out+="firewall: $line"$'\n'
    elif need nft; then
        # Cheap probe: is nftables loaded at all?
        sudo -n nft list ruleset 2>/dev/null | grep -q 'chain input' && out+="firewall: nftables loaded"$'\n'
    fi

    # Stealth — written by balstealth
    if [[ -r /run/balos/stealth ]]; then
        line=$(cat /run/balos/stealth 2>/dev/null)
        [[ "$line" == "on" ]] && out+="stealth: on"$'\n'
    fi
    if systemctl is-active tor &>/dev/null; then
        out+="tor: active"$'\n'
    fi
    if systemctl is-active dnscrypt-proxy &>/dev/null; then
        out+="dns: dnscrypt (DoH)"$'\n'
    fi

    # VPN (WireGuard)
    if ip link show wg0 &>/dev/null; then
        out+="vpn: wg0 up"$'\n'
    fi

    # Default iface + IP
    local iface ip4
    iface=$(ip -o route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="dev"){print $(i+1); exit}}')
    if [[ -n "$iface" ]]; then
        ip4=$(ip -o -4 addr show "$iface" 2>/dev/null | awk '{print $4}' | head -1)
        out+="net: ${iface} ${ip4:-no-ipv4}"$'\n'
    fi

    # WiFi SSID
    local ssid
    ssid=$(iwgetid -r 2>/dev/null) || ssid=""
    [[ -n "$ssid" ]] && out+="wifi-ssid: $ssid"$'\n'

    # Battery
    if [[ -r /sys/class/power_supply/BAT0/capacity ]]; then
        local pct status
        pct=$(cat /sys/class/power_supply/BAT0/capacity 2>/dev/null)
        status=$(cat /sys/class/power_supply/BAT0/status 2>/dev/null)
        out+="battery: ${pct}% ${status}"$'\n'
    fi

    # CPU governor
    if [[ -r /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor ]]; then
        line=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null)
        out+="cpu-governor: $line"$'\n'
    fi

    # Uptime + load
    line=$(uptime 2>/dev/null | sed -E 's/.*up ([^,]+), .*load average: (.*)/up \1, load \2/')
    [[ -n "$line" ]] && out+="system: $line"$'\n'

    # Memory
    if need free; then
        line=$(free -h 2>/dev/null | awk '/^Mem:/{printf "%s used / %s total", $3, $2}')
        [[ -n "$line" ]] && out+="mem: $line"$'\n'
    fi

    # Disk on root
    line=$(df -h / 2>/dev/null | awk 'NR==2{printf "%s used / %s (%s)", $3, $2, $5}')
    [[ -n "$line" ]] && out+="disk /: $line"$'\n'

    # ollama running?
    if curl -fsS --max-time 1 "${OLLAMA_URL}/api/tags" &>/dev/null; then
        out+="ollama: up (${MODEL})"$'\n'
    fi

    # Kernel
    line=$(uname -r 2>/dev/null)
    [[ -n "$line" ]] && out+="kernel: $line"$'\n'

    printf '%s' "$out"
}

# Decide if a user query likely needs context injection. Cheap regex —
# we'd rather inject unnecessarily than miss a "what's my battery" case.
# Note: uses `tr` for lowercasing instead of ${var,,} so this works under
# bash 3.x too (important for macOS dev; target BalOS is bash 5).
needs_ctx() {
    local q
    q=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
    [[ "$q" =~ (my|current|right\ now|actual|whats?|what\ is|how\ (many|much)\ ).*(battery|cpu|ram|memory|disk|firewall|shield|vpn|wifi|ssid|tor|stealth|power|profile|kernel|uptime|ip|iface|interface|governor|temp|load) ]] || \
    [[ "$q" =~ (status|am\ i|are\ we).*(connected|protected|safe|stealth|online|vpn|tor|on\ battery|plugged) ]] || \
    [[ "$q" =~ ^(status|where|which) ]]
}

# Wrap a prompt with an optional [SYSTEM CONTEXT] block.
# Args: prompt  (reads $BALAI_CTX_MODE: auto|always|never)
with_ctx() {
    local prompt="$1"
    local mode="${BALAI_CTX_MODE:-auto}"
    case "$mode" in
        never) printf '%s' "$prompt"; return ;;
        always) ;;
        auto|*)
            needs_ctx "$prompt" || { printf '%s' "$prompt"; return; }
            ;;
    esac
    local ctx
    ctx=$(gather_ctx)
    if [[ -z "$ctx" ]]; then
        printf '%s' "$prompt"
    else
        printf 'Current BalOS system state:\n%s\nUser question: %s' "$ctx" "$prompt"
    fi
}

# ─── subcommands ─────────────────────────────────────────────────

cmd_chat() {
    ensure_ollama
    ensure_model
    echo -e "${M}${B}╔════════════════════════════════════════════╗${N}"
    echo -e "${M}${B}║  BalAI · local · ${MODEL}            ${N}"
    echo -e "${M}${B}╚════════════════════════════════════════════╝${N}"
    echo -e "${D}type 'exit' to quit, '/clear' to reset, '/model' to switch${N}"
    echo ""
    while true; do
        echo -ne "${G}${B}you ▸${N} "
        local q
        IFS= read -r q || break
        [[ -z "$q" ]] && continue
        case "$q" in
            exit|quit|:q) break ;;
            /clear) clear; continue ;;
            /model) echo "current: $MODEL"; continue ;;
            /help)  echo "Commands: /clear /model /help  |  exit"; continue ;;
        esac
        echo -ne "${C}${B}bal ▸${N} "
        local p
        p=$(with_ctx "$q")
        stream_chat "$p"
        echo ""
    done
}

cmd_once() {
    ensure_ollama
    ensure_model
    local prompt
    prompt=$(with_ctx "$*")
    stream_chat "$prompt"
}

# Dump the current system context as the model sees it (useful for the
# user to audit what balai is feeding its prompt with).
cmd_ctx() {
    local ctx
    ctx=$(gather_ctx)
    if [[ -z "$ctx" ]]; then
        echo "(no context probes succeeded)"
    else
        echo -e "${M}${B}balai — current system context${N}"
        echo -e "${D}(this gets prepended automatically when your question mentions 'my …' etc.)${N}"
        echo ""
        printf '%s' "$ctx"
    fi
}

cmd_cmd() {
    [[ $# -eq 0 ]] && die "usage: balai cmd \"<what you want to do>\""
    ensure_ollama
    ensure_model
    local intent="$*"
    echo -e "${D}thinking…${N}"
    stream_chat "Translate this intent into ONE shell command. Respond with exactly ONE fenced \`\`\`bash block containing the command, followed by at most ONE short line. Do not repeat the block. If the task needs a bal* wrapper, prefer it. Intent: ${intent}"

    local reply cmd
    reply=$(last_reply)
    cmd=$(extract_command "$reply")
    [[ -z "$cmd" ]] && die "no command extracted — try rephrasing"

    # Strip any leading `$ ` prompt, trim outer whitespace.
    cmd="${cmd#$ }"
    cmd="$(echo "$cmd" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')"

    echo ""
    echo -e "${M}${B}suggested:${N}"
    echo -e "${C}$cmd${N}"
    echo ""

    # Safety block — widened after audit. Refuses to auto-run anything
    # that matches any of these DESTRUCTIVE patterns:
    local danger_re='(^|[[:space:];&|`(])(rm[[:space:]]+-[a-zA-Z]*r[a-zA-Z]*[fF][a-zA-Z]*[[:space:]]+/([[:space:]]|$)|dd[[:space:]].*of=/dev/(sd|nvme|hd|mmc)|mkfs\.[a-z0-9]+[[:space:]]+/dev/|wipefs[[:space:]]|shred[[:space:]].*[[:space:]]/dev/|>[[:space:]]*/dev/(sd|nvme|hd)|cryptsetup[[:space:]]+(erase|luksRemoveKey)|fdisk[[:space:]]+/dev/|parted[[:space:]]+/dev/|blkdiscard[[:space:]]|chmod[[:space:]]+-R[[:space:]]+.*[[:space:]]/([[:space:]]|$)|chown[[:space:]]+-R[[:space:]]+.*[[:space:]]/([[:space:]]|$)|:\(\)\{)'
    if echo "$cmd" | grep -qE "$danger_re"; then
        warn "this looks DESTRUCTIVE — review manually; not offering to run it."
        if need wl-copy; then
            printf '%s' "$cmd" | wl-copy 2>/dev/null && info "copied to clipboard so you can inspect it"
        fi
        return 1
    fi

    # Also warn (but allow) for anything touching /etc or /boot as root.
    local caution=""
    if echo "$cmd" | grep -qE '(^|[[:space:];|&])sudo[[:space:]]+.*[[:space:]]/(etc|boot|usr|var/lib)(/|[[:space:]]|$)'; then
        caution="modifies system files"
    fi
    [[ -n "$caution" ]] && warn "caution: $caution"

    echo -ne "${Y}run it? [y/N] ${N}"
    local ans
    read -r ans
    ans=$(printf '%s' "$ans" | tr '[:upper:]' '[:lower:]')
    if [[ "$ans" =~ ^(y|yes)$ ]]; then
        echo -e "${D}────────────────────${N}"
        # Use bash -c so user's shell state (aliases, functions) isn't
        # accidentally polluted and so errors don't kill balai via set -e.
        bash -c "$cmd"
    else
        if need wl-copy; then
            printf '%s' "$cmd" | wl-copy 2>/dev/null && ok "copied to clipboard"
        else
            info "not run — command shown above"
        fi
    fi
}

cmd_explain() {
    ensure_ollama
    ensure_model
    local target="${1:-}"
    local content
    # Piped input always wins: `cat err.log | balai explain`
    if [[ ! -t 0 ]]; then
        content=$(head -c 8000)
        [[ -z "$content" ]] && die "nothing on stdin"
        stream_chat "Explain this output and suggest next steps. Be terse.\n\n${content}"
        return
    fi
    if [[ -z "$target" || "$target" == "--last" ]]; then
        # Read last line of zsh_history (default shell) or bash_history fallback.
        # `fc` only works in interactive shells — we're in a script subshell.
        local histf=""
        for f in "${HISTFILE:-}" "$HOME/.zsh_history" "$HOME/.bash_history"; do
            [[ -n "$f" && -f "$f" ]] && { histf="$f"; break; }
        done
        [[ -z "$histf" ]] && die "no history file found — pipe input instead: <cmd> |& balai explain"
        # zsh extended-history lines look like: ": 1718049310:0;actual cmd"
        content=$(tail -1 "$histf" | sed -E 's/^: [0-9]+:[0-9]+;//')
        [[ -z "$content" ]] && die "history empty"
        stream_chat "Explain what this command does and any pitfalls: ${content}"
    elif [[ -f "$target" ]]; then
        content=$(head -c 8000 "$target")
        stream_chat "Explain this file (truncated to 8KB if larger). File: ${target}\n\n${content}"
    else
        # Treat as literal command/text.
        stream_chat "Explain this: ${target} $*"
    fi
}

cmd_fix() {
    ensure_ollama
    ensure_model
    local err
    if [[ $# -gt 0 ]]; then
        err="$*"
    else
        echo -e "${D}paste error, then Ctrl-D:${N}"
        err=$(cat)
    fi
    [[ -z "$err" ]] && die "no error provided"
    stream_chat "I got this error. Diagnose and give a concrete fix as a command. Be terse.\n\n${err}"
}

# Health check: collect signals from the local system (failed services,
# high RAM, high load, pending updates, .pacnew files, broken VPN, etc),
# then ask the model to summarise and suggest next steps. Pure read-only.
cmd_doctor() {
    ensure_ollama
    ensure_model
    info "gathering diagnostics (read-only, ~5 s)…"

    local tmpf
    tmpf=$(mktemp)
    {
        echo "### Host: $(hostname) — $(date -Is 2>/dev/null)"
        echo ""
        echo "### Context (balai view)"
        gather_ctx 2>/dev/null
        echo ""
        echo "### Failed systemd units"
        systemctl --failed --no-legend 2>/dev/null | head -20 || echo "(systemctl unavailable)"
        echo ""
        echo "### Services of interest"
        for svc in NetworkManager sddm tlp nftables dnscrypt-proxy tor ollama suricata wg-quick@wg0 ufw firewalld; do
            state=$(systemctl is-active "$svc" 2>/dev/null || true)
            enabled=$(systemctl is-enabled "$svc" 2>/dev/null || true)
            [[ -n "$state" || -n "$enabled" ]] && printf '  %-22s active=%-10s enabled=%s\n' "$svc" "${state:-n/a}" "${enabled:-n/a}"
        done
        echo ""
        echo "### Recent journal errors (last 20)"
        journalctl -p err -n 20 --no-pager 2>/dev/null | tail -20 || echo "(journalctl unavailable)"
        echo ""
        echo "### Disk pressure"
        df -h / /boot /var /home 2>/dev/null | grep -vE '^(tmpfs|devtmpfs|efivarfs)' | head -10
        echo ""
        echo "### Memory + swap"
        free -h 2>/dev/null | head -4
        echo ""
        echo "### .pacnew files (need manual merge)"
        find /etc -name '*.pacnew' 2>/dev/null | head -10
        echo ""
        echo "### Pacman last transaction"
        tail -40 /var/log/pacman.log 2>/dev/null | tail -20
        echo ""
        echo "### Kernel ring-buffer tail"
        dmesg --ctime 2>/dev/null | tail -15 || tail -15 /var/log/dmesg 2>/dev/null
    } > "$tmpf"

    # Show raw diagnostics first (condensed)
    echo -e "${D}─── raw diagnostics (for reference) ────────────────${N}" >&2
    head -80 "$tmpf" >&2
    echo -e "${D}────────────────────────────────────────────────────${N}" >&2
    echo ""
    echo -e "${M}${B}AI summary:${N}"
    stream_chat "You are running as a system doctor. Read the diagnostics below and produce: (1) ONE line overall verdict (healthy / minor issues / attention needed), (2) up to 3 concrete issues as bullet points with the exact bal* or systemctl command to fix each. Be terse. Do NOT emit more than one fenced block per issue.

DIAGNOSTICS:
$(cat "$tmpf")"
    rm -f "$tmpf"
}

# One-line proactive tip based on current system state. Used by
# `balmonitor --once` footer and `balai tip`. Non-streaming, <80 chars
# ideal, times out fast so TUI callers are never blocked.
cmd_tip() {
    ensure_ollama 2>/dev/null || { echo "(balai offline)"; return 0; }
    ensure_model   2>/dev/null || { echo "(model missing)"; return 0; }
    local ctx
    ctx=$(gather_ctx 2>/dev/null)
    local prompt="Given this BalOS snapshot:

$ctx

If there is ONE small optimisation or concern worth mentioning right now, reply with a single line of at most 90 characters starting with '→ '. If everything looks fine, reply exactly: → all green."
    # Silent failure if ollama is flaky — tip is decorative.
    timeout 12 curl -fsS "${OLLAMA_URL}/api/generate" \
        -d "$(python3 -c "import json,sys; print(json.dumps({'model':'${MODEL}','prompt':sys.argv[1],'stream':False,'options':{'num_predict':60,'temperature':0.3}}))" "$prompt")" \
        2>/dev/null \
        | python3 -c 'import sys,json
try: print(json.load(sys.stdin).get("response","").strip().splitlines()[0])
except: pass' \
        || true
}

cmd_setup() {
    info "checking ollama service…"
    if ! need ollama; then
        die "ollama not installed — pacman -S ollama"
    fi
    if systemctl is-enabled ollama &>/dev/null; then
        ok "ollama service enabled"
    else
        info "enabling ollama…"
        sudo systemctl enable --now ollama || warn "could not enable (not fatal on live ISO)"
    fi
    ensure_ollama
    ensure_model
    ok "BalAI ready. Try: balai \"how do I enable stealth mode\""
}

cmd_status() {
    echo -e "${B}BalAI status${N}"
    echo -e "  version:  v${VERSION}"
    echo -e "  model:    ${MODEL}"
    echo -e "  host:     ${OLLAMA_HOST}"
    if curl -fsS --max-time 2 "${OLLAMA_URL}/api/tags" &>/dev/null; then
        echo -e "  ollama:   ${G}● running${N}"
        local tags
        tags=$(curl -fsS "${OLLAMA_URL}/api/tags" | python3 -c 'import sys,json
d=json.load(sys.stdin); print("  models:  ", ", ".join(m["name"] for m in d.get("models",[])) or "(none)")')
        echo -e "$tags"
    else
        echo -e "  ollama:   ${Y}○ not running${N} (balai will start on-demand)"
    fi
    local ram
    ram=$(free -m | awk '/^Mem:/{printf "%d/%d MB", $3, $2}')
    echo -e "  RAM:      ${ram}"
}

cmd_model() {
    ensure_ollama
    local sub="${1:-list}"; shift || true
    case "$sub" in
        list|ls)
            curl -fsS "${OLLAMA_URL}/api/tags" | python3 -c 'import sys,json
d=json.load(sys.stdin)
for m in d.get("models",[]):
    sz=m.get("size",0)/1e9
    print(f"  {m[\"name\"]:<40} {sz:>6.2f} GB")'
            ;;
        pull)
            [[ $# -eq 0 ]] && die "usage: balai model pull <model>"
            ollama pull "$1"
            ;;
        rm|remove|delete)
            [[ $# -eq 0 ]] && die "usage: balai model rm <model>"
            ollama rm "$1"
            ;;
        default)
            [[ $# -eq 0 ]] && { echo "current default: $MODEL_DEFAULT"; echo "use: export BALAI_MODEL=<name> in ~/.zshrc"; return 0; }
            warn "to change permanently, add: export BALAI_MODEL=\"$1\" to ~/.zshrc"
            ;;
        *) die "usage: balai model [list|pull|rm|default] [name]" ;;
    esac
}

cmd_usage() {
cat << EOF
${G}${B}BalAI${N} ${D}v${VERSION}${N} — local offline assistant (${MODEL})

${B}USAGE${N}
  balai                          ${D}# interactive chat${N}
  balai "question"               ${D}# one-shot query${N}
  balai cmd  "<intent>"          ${D}# generate command, confirm, run${N}
  balai explain <file|--last>    ${D}# explain file or last command${N}
  balai fix  [error text]        ${D}# diagnose + suggest fix${N}
  balai ctx                      ${D}# show system context balai sees${N}
  balai doctor                   ${D}# diagnose system + AI summary${N}
  balai tip                      ${D}# one-line proactive suggestion${N}
  balai model [list|pull|rm]     ${D}# manage local models${N}
  balai status                   ${D}# service + model health${N}
  balai setup                    ${D}# first-run: enable service + pull model${N}

${B}ENV${N}
  BALAI_MODEL=<name>           ${D}# override default model (e.g. qwen2.5:3b-instruct-q4_K_M)${N}
  BALAI_SYSTEM_PROMPT=<path>   ${D}# override system prompt file${N}
  BALAI_CTX_MODE=auto|always|never ${D}# context injection (default: auto)${N}
  OLLAMA_HOST=host:port

${B}EXAMPLES${N}
  ${D}balai "how do I enable VPN kill-switch"${N}
  ${D}balai cmd "find all files modified in last 10 minutes"${N}
  ${D}balai explain /etc/nftables.conf${N}
  ${D}balai fix "permission denied"${N}

${B}NOTE${N}  100% offline. No data leaves this machine.
EOF
}

# ─── dispatcher ──────────────────────────────────────────────────
CMD="${1:-}"; shift || true

case "$CMD" in
    ""|chat|interactive)  cmd_chat ;;
    cmd|do|run|gen)       cmd_cmd "$@" ;;
    explain|exp|why)      cmd_explain "$@" ;;
    fix|err|error)        cmd_fix "$@" ;;
    ctx|context)          cmd_ctx ;;
    doctor|diag|diagnose) cmd_doctor ;;
    tip|suggest|hint)     cmd_tip ;;
    setup|init)           cmd_setup ;;
    status|health)        cmd_status ;;
    model|models)         cmd_model "$@" ;;
    help|-h|--help)       cmd_usage ;;
    version|-v|--version) echo "BalAI v${VERSION}" ;;
    # Otherwise treat the whole command-line as a one-shot query.
    *)                    cmd_once "$CMD" "$@" ;;
esac
