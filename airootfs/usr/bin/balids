#!/usr/bin/env bash
# balids — BalOS host IDS controller (Suricata wrapper)
set -euo pipefail

G='\033[0;32m'; C='\033[0;36m'; Y='\033[1;33m'; R='\033[0;31m'; M='\033[0;35m'
B='\033[1m'; D='\033[2m'; N='\033[0m'

usage() {
cat << EOF
${M}${B}balids${N} — host intrusion detection (Suricata)

  ${C}on${N}             Enable + start Suricata service
  ${C}off${N}            Stop Suricata
  ${C}status${N}         Show service + recent alert count
  ${C}update${N}         Refresh rule database (suricata-update)
  ${C}alerts${N} [n]     Show last ${D}n${N} alerts (default 20)
  ${C}watch${N}          Live tail of alerts with color
  ${C}stats${N}          Traffic statistics from stats.log
  ${C}test${N}           Synthetic alert (curl a known signature)

${B}LOGS${N} /var/log/suricata/{eve.json,fast.log,stats.log}
EOF
}

need_root() { [[ $EUID -ne 0 ]] && exec sudo "$0" "$@"; }

cmd_on() {
    need_root "$@"
    [[ -d /var/lib/suricata/rules ]] || {
        echo -e "${C}▸ fetching rules (first time)...${N}"
        suricata-update 2>&1 | tail -10
    }
    systemctl enable --now balos-suricata
    echo -e "${G}✓ Suricata active${N}"
}

cmd_off() {
    need_root "$@"
    systemctl disable --now balos-suricata
    echo -e "${Y}▸ Suricata stopped${N}"
}

cmd_status() {
    local st=$(systemctl is-active balos-suricata 2>/dev/null)
    echo -e "${B}Service:${N}    ${C}${st}${N}"
    if [[ -f /var/log/suricata/fast.log ]]; then
        local cnt=$(wc -l < /var/log/suricata/fast.log)
        local today=$(grep "^$(date +%m/%d)" /var/log/suricata/fast.log 2>/dev/null | wc -l)
        echo -e "${B}Alerts:${N}     total=${C}${cnt}${N}  today=${Y}${today}${N}"
    fi
    if [[ -f /var/log/suricata/stats.log ]]; then
        local up=$(grep -a uptime /var/log/suricata/stats.log 2>/dev/null | tail -1 | awk '{print $NF}')
        [[ -n "$up" ]] && echo -e "${B}Uptime:${N}     ${C}${up}${N}s"
    fi
    local rules=$(find /var/lib/suricata/rules -name '*.rules' 2>/dev/null | wc -l)
    echo -e "${B}Rule files:${N} ${C}${rules}${N}"
}

cmd_update() {
    need_root "$@"
    suricata-update
    systemctl reload balos-suricata 2>/dev/null || systemctl restart balos-suricata
    echo -e "${G}✓ rules updated${N}"
}

cmd_alerts() {
    local n="${1:-20}"
    [[ -f /var/log/suricata/fast.log ]] || { echo "no alerts yet"; return; }
    tail -n "$n" /var/log/suricata/fast.log | while IFS= read -r line; do
        if   [[ "$line" =~ \[1:[0-9]+:[0-9]+\][[:space:]]*([^[]+) ]]; then
            printf "${R}%s${N}\n" "$line"
        else
            echo "$line"
        fi
    done
}

cmd_watch() {
    [[ -f /var/log/suricata/fast.log ]] || { echo "no fast.log yet"; exit 1; }
    echo -e "${C}▸ live tail (Ctrl-C to stop)${N}\n"
    tail -F /var/log/suricata/fast.log | while IFS= read -r line; do
        if [[ "$line" =~ Priority:\ 1 ]]; then
            printf "${R}${B}%s${N}\n" "$line"
        elif [[ "$line" =~ Priority:\ 2 ]]; then
            printf "${Y}%s${N}\n" "$line"
        else
            printf "${D}%s${N}\n" "$line"
        fi
    done
}

cmd_stats() {
    [[ -f /var/log/suricata/stats.log ]] || { echo "no stats"; return; }
    echo -e "${B}Recent counters (last snapshot):${N}"
    awk '/^[-]+$/{buf=""} {buf=buf"\n"$0} END{print buf}' /var/log/suricata/stats.log | \
        grep -E 'decoder\.(pkts|bytes|ipv4|ipv6|tcp|udp)|app_layer\.flow\.(http|tls|dns|ssh)|alert|flow\.(tcp|udp)' | \
        head -30
}

cmd_test() {
    echo -e "${C}▸ generating synthetic alert (User-Agent match)${N}"
    curl -s -A "BlackSun" -m 3 http://testmynids.org/uid/index.html &>/dev/null || true
    sleep 2
    cmd_alerts 5
}

case "${1:-status}" in
    on|start|enable)  shift; cmd_on "$@" ;;
    off|stop|disable) shift; cmd_off "$@" ;;
    update|up)        shift; cmd_update "$@" ;;
    alerts|al)        shift; cmd_alerts "$@" ;;
    watch|tail)       cmd_watch ;;
    stats)            cmd_stats ;;
    test)             cmd_test ;;
    help|-h|--help)   usage ;;
    status|*)         cmd_status ;;
esac
