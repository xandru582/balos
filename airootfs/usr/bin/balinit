#!/usr/bin/env bash
# balinit — first-boot wizard (runs after install)
set -euo pipefail

G='\033[0;32m'; R='\033[0;31m'; Y='\033[1;33m'; C='\033[0;36m'; M='\033[0;35m'
B='\033[1m'; D='\033[2m'; N='\033[0m'

[[ $EUID -ne 0 ]] && { echo "Run as root: sudo balinit"; exit 1; }

clear
cat << 'EOF'
[0;32m
    ██████╗  █████╗ ██╗      ██████╗ ███████╗
    ██╔══██╗██╔══██╗██║     ██╔═══██╗██╔════╝
    ██████╔╝███████║██║     ██║   ██║███████╗
    ██╔══██╗██╔══██║██║     ██║   ██║╚════██║
    ██████╔╝██║  ██║███████╗╚██████╔╝███████║
    ╚═════╝ ╚═╝  ╚═╝╚══════╝ ╚═════╝ ╚══════╝
[0m       first-boot initialization
EOF

ask()     { echo -en "${C}  ▸ ${N}$* "; read -r REPLY; echo "$REPLY"; }
confirm() { echo -en "${Y}  ? ${N}$* [y/N] "; read -r r; [[ "${r,,}" == "y" ]]; }
step()    { echo -e "${G}  ✓${N} $*"; }

echo ""
echo -e "${B}This wizard will:${N}"
echo -e "  • Create your user account"
echo -e "  • Generate SSH keys"
echo -e "  • Set up WireGuard (optional)"
echo -e "  • Configure BlackArch repo keys"
echo -e "  • Apply first optimization pass"
echo ""

# ── 1. User ───────────────────────────────────────────────────────
USERNAME=$(ask "Username:")
[[ -z "$USERNAME" ]] && { echo "Username required"; exit 1; }

if id "$USERNAME" &>/dev/null; then
    echo -e "${Y}  User '$USERNAME' already exists — skipping creation.${N}"
else
    useradd -m -G wheel,audio,video,input,gamemode,wireshark,kvm,libvirt,docker -s /bin/zsh "$USERNAME"
    echo "Set password for ${USERNAME}:"
    passwd "$USERNAME"
    step "User ${USERNAME} created with groups: wheel, audio, video, gamemode, wireshark, kvm"
fi

# Enable sudo for wheel
echo "%wheel ALL=(ALL:ALL) ALL" > /etc/sudoers.d/10-balos
chmod 440 /etc/sudoers.d/10-balos

# ── 2. Hostname ───────────────────────────────────────────────────
HOSTNAME=$(ask "Hostname [balos]:")
HOSTNAME=${HOSTNAME:-balos}
hostnamectl set-hostname "$HOSTNAME"
step "Hostname → $HOSTNAME"

# ── 3. Timezone ───────────────────────────────────────────────────
if confirm "Auto-detect timezone from IP?"; then
    TZ=$(curl -s https://ipapi.co/timezone 2>/dev/null || echo "UTC")
else
    TZ=$(ask "Timezone [UTC]:")
    TZ=${TZ:-UTC}
fi
timedatectl set-timezone "$TZ"
step "Timezone → $TZ"

# ── 4. SSH keys ───────────────────────────────────────────────────
if confirm "Generate Ed25519 SSH key for ${USERNAME}?"; then
    runuser -u "$USERNAME" -- ssh-keygen -t ed25519 -N "" -f "/home/${USERNAME}/.ssh/id_ed25519"
    step "SSH key generated: /home/${USERNAME}/.ssh/id_ed25519.pub"
fi

# ── 5. WireGuard (optional) ───────────────────────────────────────
if confirm "Set up WireGuard VPN profile?"; then
    PRIV=$(wg genkey)
    PUB=$(echo "$PRIV" | wg pubkey)
    mkdir -p /etc/wireguard
    cat > /etc/wireguard/wg0.conf << CONF
[Interface]
PrivateKey = ${PRIV}
Address    = 10.8.0.2/24
DNS        = 1.1.1.1, 9.9.9.9
# ListenPort = 51820

[Peer]
PublicKey  = <YOUR_SERVER_PUBKEY_HERE>
Endpoint   = <YOUR_SERVER>:51820
AllowedIPs = 0.0.0.0/0, ::/0
PersistentKeepalive = 25
CONF
    chmod 600 /etc/wireguard/wg0.conf
    step "Stub WireGuard config created: /etc/wireguard/wg0.conf"
    echo -e "    ${D}Your public key: ${PUB}${N}"
fi

# ── 6. BlackArch keyring ──────────────────────────────────────────
if ! pacman-key --list-keys | grep -q blackarch; then
    if confirm "Install BlackArch keyring (2800+ pentest tools)?"; then
        # Verify strap.sh SHA1 against upstream before executing (published by BlackArch).
        # If the hash ever changes, review the diff before trusting the new script.
        STRAP_URL="https://blackarch.org/strap.sh"
        STRAP_SHA1="$(curl -fsSL https://blackarch.org/strap.sh.sha1sum 2>/dev/null | awk '{print $1}')"
        if ! curl -fsSLo /tmp/strap.sh "$STRAP_URL"; then
            echo -e "${R}  ✗ Failed to download strap.sh — skipping BlackArch${N}"
        elif [[ -n "$STRAP_SHA1" ]] && ! echo "$STRAP_SHA1  /tmp/strap.sh" | sha1sum -c - &>/dev/null; then
            echo -e "${R}  ✗ strap.sh hash mismatch — aborting (possible MITM)${N}"
            rm -f /tmp/strap.sh
        else
            chmod +x /tmp/strap.sh && /tmp/strap.sh && rm -f /tmp/strap.sh
            step "BlackArch repo enabled"
        fi
    fi
fi

# ── 7. Flatpak / Flathub ──────────────────────────────────────────
flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo
step "Flathub added"

# ── 8. Reflector (best mirrors) ──────────────────────────────────
if command -v reflector &>/dev/null; then
    reflector --country "United States,Germany,France,Netherlands" --latest 15 \
        --protocol https --sort rate --save /etc/pacman.d/mirrorlist &
    step "Mirror refresh running in background"
fi

# ── 9. Apply initial power profile based on AC/BAT ───────────────
if [[ "$(cat /sys/class/power_supply/AC/online 2>/dev/null)" == "1" ]]; then
    balsaver --balanced &>/dev/null
    step "Power profile → balanced (on AC)"
else
    balsaver &>/dev/null
    step "Power profile → saver (on battery)"
fi

# ── 10. Create user's balos config dir ───────────────────────────
USER_HOME="/home/${USERNAME}"
mkdir -p "${USER_HOME}/.config/balos"
chown -R "${USERNAME}:${USERNAME}" "${USER_HOME}/.config/balos"

cat << EOF

${G}${B}╔════════════════════════════════════════╗${N}
${G}${B}║   BalOS INITIALIZATION COMPLETE         ║${N}
${G}${B}╚════════════════════════════════════════╝${N}

  ${B}Welcome, ${USERNAME}.${N}

  Next steps:
    ${C}reboot${N}                    — enter your new session
    ${C}bal status${N}                — see current profile
    ${C}bal hack recon${N}            — fire up a pentest workspace
    ${C}bal kernel build${N}          — compile custom BalKernel (~45 min)

  ${D}Keep your keys safe. Hack responsibly.${N}

EOF
