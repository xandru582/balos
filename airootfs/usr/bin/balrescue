#!/usr/bin/env bash
# balrescue — anti-forensics layer
# RAM wipe · encrypted swap shred · free-space zeroing · steganographic rollback
set -euo pipefail

G='\033[0;32m'; R='\033[0;31m'; Y='\033[1;33m'; C='\033[0;36m'; M='\033[0;35m'
B='\033[1m'; D='\033[2m'; N='\033[0m'

usage() {
cat << EOF
${M}${B}balrescue${N} — anti-forensics

  ${C}wipe-ram${N}              Drop caches, fill free RAM with zeros, sync
  ${C}wipe-swap${N}             Shred swap (luks-encrypted swap gets rekeyed)
  ${C}wipe-free <dir>${N}       Zero free space on a filesystem
  ${C}shred <file>${N}          Secure-delete (7-pass)
  ${C}burn <partition>${N}      ${R}DESTROY${N} partition (3-pass random + zero)
  ${C}meta-clean <file>${N}     Strip EXIF / metadata from file
  ${C}history${N}               Wipe shell/cmd history for current user
  ${C}all-light${N}              wipe-ram + wipe-swap + history
  ${C}all-deep${N}              all-light + wipe-free on /home

${R}${B}DESTRUCTIVE OPS${N} ${D}(burn, wipe-free, shred)${N} require confirmation.
EOF
}

[[ $EUID -ne 0 ]] && [[ "${1:-}" =~ ^(wipe-|burn|all-) ]] && exec sudo "$0" "$@"

confirm() {
    echo -en "${R}${B}? ${N}$* [type YES] "
    read -r r
    [[ "$r" == "YES" ]]
}

wipe_ram() {
    echo -e "${C}▸ syncing...${N}"; sync
    echo -e "${C}▸ dropping caches (1,2,3)...${N}"
    echo 3 > /proc/sys/vm/drop_caches
    echo -e "${C}▸ filling free RAM with zeros...${N}"
    # Allocate ~free ram as zeros, then release
    FREE_KB=$(awk '/MemAvailable/{print $2}' /proc/meminfo)
    FREE_MB=$((FREE_KB/1024 - 256))  # keep 256MB for OS
    (( FREE_MB < 100 )) && FREE_MB=100
    dd if=/dev/zero of=/dev/shm/balrescue-fill bs=1M count="$FREE_MB" status=progress 2>&1 | tail -1
    rm -f /dev/shm/balrescue-fill
    sync
    echo 3 > /proc/sys/vm/drop_caches
    echo -e "${G}✓ RAM wiped${N}"
}

wipe_swap() {
    echo -e "${C}▸ disabling swap...${N}"
    swapoff -a
    echo -e "${C}▸ shredding swap devices...${N}"
    for s in $(awk '/partition|file/{print $1}' /proc/swaps 2>/dev/null); do
        shred -n 1 -z -v "$s" 2>/dev/null || \
            dd if=/dev/urandom of="$s" bs=1M status=progress 2>&1 | tail -1
    done
    # Re-setup zram
    swapon -a
    echo -e "${G}✓ swap shredded & re-enabled${N}"
}

wipe_free() {
    local dir="${1:-/home}"
    [[ -d "$dir" ]] || { echo "not a dir: $dir"; exit 1; }
    confirm "Zero free space on $dir? (can take a while)" || exit 1
    local fill="$dir/.balrescue-wipe-$$"
    echo -e "${C}▸ filling free space...${N}"
    dd if=/dev/zero of="$fill" bs=1M status=progress 2>/dev/null || true
    sync
    rm -f "$fill"
    echo -e "${G}✓ free space zeroed on $dir${N}"
}

shred_file() {
    local f="${1:?path required}"
    [[ -f "$f" ]] || { echo "not a file: $f"; exit 1; }
    confirm "Shred $f (irreversible)?" || exit 1
    shred -n 7 -z -u "$f"
    echo -e "${G}✓ shredded: $f${N}"
}

burn_partition() {
    local p="${1:?partition required, e.g. /dev/sdb1}"
    [[ -b "$p" ]] || { echo "not a block device: $p"; exit 1; }
    echo -e "${R}${B}WILL DESTROY $p (size: $(lsblk -bdn -o SIZE "$p" | awk '{print $1/1024/1024/1024 "GB"}'))${N}"
    confirm "Type YES to burn" || exit 1
    for pass in 1 2 3; do
        echo -e "${C}▸ pass $pass/3 random...${N}"
        dd if=/dev/urandom of="$p" bs=4M status=progress 2>&1 | tail -1
    done
    echo -e "${C}▸ final zero pass...${N}"
    dd if=/dev/zero of="$p" bs=4M status=progress 2>&1 | tail -1
    echo -e "${G}✓ $p burned${N}"
}

meta_clean() {
    local f="${1:?file required}"
    if command -v exiftool &>/dev/null; then
        exiftool -all= -overwrite_original "$f"
        echo -e "${G}✓ EXIF stripped: $f${N}"
    else
        echo "install: sudo pacman -S perl-image-exiftool"
    fi
}

wipe_history() {
    USER_NAME="${SUDO_USER:-$USER}"
    USER_HOME=$(eval echo "~$USER_NAME")
    for f in "$USER_HOME/.bash_history" "$USER_HOME/.zsh_history" \
             "$USER_HOME/.python_history" "$USER_HOME/.node_repl_history" \
             "$USER_HOME/.lesshst" "$USER_HOME/.viminfo" \
             "$USER_HOME/.local/share/nvim/shada/main.shada"; do
        [[ -f "$f" ]] && { shred -n 3 -z "$f" 2>/dev/null; rm -f "$f"; echo "  shredded: $f"; }
    done
    history -c 2>/dev/null || true
    echo -e "${G}✓ history wiped${N}"
}

case "${1:-help}" in
    wipe-ram|ram)       wipe_ram ;;
    wipe-swap|swap)     wipe_swap ;;
    wipe-free|free)     shift; wipe_free "$@" ;;
    shred)              shift; shred_file "$@" ;;
    burn|destroy)       shift; burn_partition "$@" ;;
    meta-clean|meta)    shift; meta_clean "$@" ;;
    history)            wipe_history ;;
    all-light)          wipe_history; wipe_ram; wipe_swap ;;
    all-deep)           wipe_history; wipe_ram; wipe_swap; wipe_free /home ;;
    help|-h|--help|*)   usage ;;
esac
