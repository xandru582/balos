def _kv(parent_layout: QVBoxLayout, key: str, value: str, cls: str = "") -> QLabel:
    row = QHBoxLayout()
    row.setContentsMargins(0, 2, 0, 2)
    k = QLabel(key)
    k.setObjectName(key)
    k.setProperty("class", "kv_k")
    k.setStyleSheet(f"color: {MUTED}; font-size: 11px; padding-left: 16px;")
    v = QLabel(value)
    v.setProperty("class", f"kv_v {cls}" if cls else "kv_v")
    v.setAlignment(Qt.AlignRight | Qt.AlignVCenter)
    v.setStyleSheet(f"color: {FG}; padding-right: 16px;"
                    "font-family: 'JetBrainsMono Nerd Font','JetBrains Mono',"
                    "'Fira Code',monospace;")
    row.addWidget(k)
    row.addStretch(1)
    row.addWidget(v)
    parent_layout.addLayout(row)
    return v


class Sidebar(QFrame):
    """Live system dashboard. Polls every 5 s."""

    def __init__(self):
        super().__init__()
        self.setObjectName("sidebar")
        self.setFixedWidth(280)
        self.setFrameShape(QFrame.NoFrame)

        root = QVBoxLayout(self)
        root.setContentsMargins(0, 0, 0, 10)
        root.setSpacing(0)

        brand = QLabel("🧠  BalAI")
        brand.setObjectName("brand")
        root.addWidget(brand)
        sub = QLabel(f"offline · {MODEL}")
        sub.setObjectName("brand_sub")
        root.addWidget(sub)

        # ── status groups ─────────────────────────────────────────
        self._labels: dict[str, QLabel] = {}

        self._section(root, "POWER")
        self._labels["battery"]    = _kv(root, "battery",    "—")
        self._labels["profile"]    = _kv(root, "profile",    "—")
        self._labels["governor"]   = _kv(root, "governor",   "—")

        self._section(root, "SYSTEM")
        self._labels["load"]       = _kv(root, "load 1m",    "—")
        self._labels["mem"]        = _kv(root, "memory",     "—")
        self._labels["disk"]       = _kv(root, "disk /",     "—")
        self._labels["uptime"]     = _kv(root, "uptime",     "—")
        self._labels["kernel"]     = _kv(root, "kernel",     "—")

        self._section(root, "NETWORK")
        self._labels["iface"]      = _kv(root, "iface",      "—")
        self._labels["ip"]         = _kv(root, "ip",         "—")
        self._labels["ssid"]       = _kv(root, "wifi",       "—")
        self._labels["vpn"]        = _kv(root, "vpn",        "—")
        self._labels["shield"]     = _kv(root, "firewall",   "—")

        root.addStretch(1)

        # Footer mini-help
        help_lbl = QLabel(
            "⌘/Ctrl+Enter  send\n"
            "Ctrl+L        clear\n"
            "Ctrl+D        doctor\n"
            "Ctrl+T        tip"
        )
        help_lbl.setStyleSheet(f"color: {MUTED}; padding: 8px 16px; font-size: 10px;")
        root.addWidget(help_lbl)

        # Poll loop
        self._timer = QTimer(self)
        self._timer.timeout.connect(self.refresh)
        self._timer.start(5000)
        self.refresh()

    def _section(self, layout: QVBoxLayout, title: str):
        spacer = QLabel(title)
        spacer.setStyleSheet(
            f"color: {ACCENT}; font-size: 10px; font-weight: 700; "
            "letter-spacing: 1.5px; padding: 14px 16px 4px 16px;"
        )
        layout.addWidget(spacer)

    def _set(self, key: str, value: str, level: str = ""):
        lbl = self._labels.get(key)
        if not lbl:
            return
        lbl.setText(value)
        color = {"ok": OK, "warn": WARN, "bad": BAD}.get(level, FG)
        lbl.setStyleSheet(f"color: {color}; padding-right: 16px;"
                          "font-family: 'JetBrainsMono Nerd Font',"
                          "'JetBrains Mono','Fira Code',monospace;")

    @Slot()
    def refresh(self):
        cap, st = _battery()
        if cap:
            n = int(cap.rstrip("%"))
            level = "bad" if (n < 15 and "Dis" in st) else \
                    "warn" if (n < 30 and "Dis" in st) else "ok"
            self._set("battery", f"{cap} {st}".strip(), level)
        else:
            self._set("battery", "AC" if _ac() else "?")

        self._set("profile",  _power_profile())
        self._set("governor", _governor())

        load = _cpu_load()
        try:
            load_f = float(load)
            ncpu   = os.cpu_count() or 1
            lvl    = "bad" if load_f > ncpu else "warn" if load_f > ncpu * 0.6 else "ok"
        except ValueError:
            lvl = ""
        self._set("load", load, lvl)
        self._set("mem", _mem())
        self._set("disk", _disk_root())
        self._set("uptime", _uptime())
        self._set("kernel", _kernel().split("-")[0])

        iface, ip = _iface_and_ip()
        self._set("iface", iface or "none", "ok" if iface else "warn")
        self._set("ip", ip or "—")
        self._set("ssid", _wifi_ssid() or "—")

        vpn = _vpn_state()
        self._set("vpn", vpn, "ok" if vpn != "off" else "")

        tier = _shield_tier()
        tier_lvl = {"off": "warn", "normal": "ok", "armor": "ok",
                    "fortress": "ok"}.get(tier, "")
        self._set("shield", tier, tier_lvl)


# ─── Chat view ──────────────────────────────────────────────────────

class ChatView(QTextEdit):
    def __init__(self):
        super().__init__()
        self.setObjectName("chat_view")
        self.setReadOnly(True)
        self.setFrameShape(QFrame.NoFrame)
        self.setVerticalScrollBarPolicy(Qt.ScrollBarAsNeeded)
        self.document().setDefaultStyleSheet(f"""
            body {{ color: {FG}; font-size: 13px; line-height: 1.5; }}
            .meta {{ color: {MUTED}; font-size: 10px; margin-top: 14px; }}
            .user {{ color: {ACCENT_2}; font-weight: 600; }}
            .ai   {{ color: {ACCENT};  font-weight: 600; }}
            pre {{ background: {PANEL}; padding: 10px 14px;
                   border-left: 3px solid {ACCENT}; font-family: monospace;
                   white-space: pre-wrap; margin: 6px 0; border-radius: 4px; }}
            code {{ background: {PANEL}; padding: 1px 5px; border-radius: 3px;
                    font-family: monospace; color: #f9a8d4; }}
            blockquote {{ border-left: 2px solid {MUTED}; color: {MUTED};
                          margin: 4px 0; padding-left: 10px; }}
        """)
        self._append_html(
            "<p class='meta'>BalAI — local offline assistant. "
            "100% on this device.</p>"
            "<p>👋 Hi. Ask me anything about your BalOS system, security, "
            "networking, or command-line chores. I can already see your current "
            "state on the left.</p>"
        )

    def _append_html(self, html: str):
        self.moveCursor(QTextCursor.End)
        self.insertHtml(html)
        self.moveCursor(QTextCursor.End)
        self.ensureCursorVisible()

    def add_user(self, text: str):
        safe = _html_escape(text).replace("\n", "<br>")
        self._append_html(
            f"<p class='meta'><span class='user'>you</span></p>"
            f"<p>{safe}</p>"
        )

    def start_ai(self):
        self._ai_buf: list[str] = []
        self._append_html("<p class='meta'><span class='ai'>balai</span></p>")
        self._append_html("<p id='ai_current'>")

    def append_ai_chunk(self, text: str):
        self._ai_buf.append(text)
        # Render incrementally as plain text with newline preservation. We
        # re-render the markdown once the stream finishes.
        self.moveCursor(QTextCursor.End)
        self.insertPlainText(text)
        self.moveCursor(QTextCursor.End)
        self.ensureCursorVisible()

    def finish_ai(self) -> str:
        full = "".join(getattr(self, "_ai_buf", []))
        # Replace the streamed plain text with rich markdown render.
        if full:
            # find and delete the current plain block then inject html
            # (simple approach: append a horizontal rule + rich version below
            #  would feel janky; instead, rewrite via selection).
            rendered = _md_to_html(full)
            # Remove the plain text we streamed by walking back N chars.
            cursor = self.textCursor()
            cursor.movePosition(QTextCursor.End)
            cursor.movePosition(QTextCursor.Left,
                                QTextCursor.KeepAnchor, len(full))
            cursor.removeSelectedText()
            self._append_html(rendered)
        self._append_html("<p></p>")
        return full

    def add_system(self, text: str, kind: str = "note"):
        color = {"note": MUTED, "warn": WARN, "err": BAD}.get(kind, MUTED)
        safe = _html_escape(text).replace("\n", "<br>")
        self._append_html(
            f"<p style='color:{color};font-size:11px;margin-top:6px;'>"
            f"▸ {safe}</p>"
        )


def _html_escape(s: str) -> str:
    return (s.replace("&", "&amp;").replace("<", "&lt;")
             .replace(">", "&gt;").replace('"', "&quot;"))


_BULLET_RE = re.compile(r"^\s*[-*]\s+", re.MULTILINE)


def _md_to_html(md: str) -> str:
    """Very small markdown → HTML. Covers: fenced code, inline code, bullets,
    bold/italic, and line breaks. We intentionally avoid a full MD lib to
    keep the dependency footprint tiny."""
    out = []
    i = 0
    lines = md.splitlines()
    while i < len(lines):
        line = lines[i]
        m = re.match(r"^```(\w+)?\s*$", line.strip())
        if m:
            i += 1
            buf = []
            while i < len(lines) and not lines[i].strip().startswith("```"):
                buf.append(lines[i])
                i += 1
            code = _html_escape("\n".join(buf))
            out.append(f"<pre><code>{code}</code></pre>")
            i += 1
            continue
        if _BULLET_RE.match(line):
            items = []
            while i < len(lines) and _BULLET_RE.match(lines[i]):
                txt = _BULLET_RE.sub("", lines[i])
                items.append("<li>" + _inline_md(_html_escape(txt)) + "</li>")
                i += 1
            out.append("<ul style='margin:4px 0 4px 18px;'>"
                       + "".join(items) + "</ul>")
            continue
        if not line.strip():
            out.append("")
            i += 1
            continue
        out.append("<p style='margin:4px 0;'>"
                   + _inline_md(_html_escape(line)) + "</p>")
        i += 1
    return "\n".join(out)


def _inline_md(s: str) -> str:
    s = re.sub(r"`([^`]+)`", r"<code>\1</code>", s)
    s = re.sub(r"\*\*([^*]+)\*\*", r"<b>\1</b>", s)
    s = re.sub(r"(?<!\*)\*([^*]+)\*(?!\*)", r"<i>\1</i>", s)
    return s


# ─── Main window ────────────────────────────────────────────────────

class MainWindow(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("BalAI — offline assistant")
        self.resize(1100, 720)
        self.setMinimumSize(820, 520)
        self.setStyleSheet(STYLESHEET)

        # Icon (fallbacks gracefully if not installed)
        for candidate in ("/usr/share/icons/hicolor/scalable/apps/balai.svg",
                          "/usr/share/pixmaps/balai.svg",
                          "/usr/share/pixmaps/balai.png"):
            if Path(candidate).is_file():
                self.setWindowIcon(QIcon(candidate))
                break

        root = QWidget()
        self.setCentralWidget(root)
        hroot = QHBoxLayout(root)
        hroot.setContentsMargins(0, 0, 0, 0)
        hroot.setSpacing(0)

        self.sidebar = Sidebar()
        hroot.addWidget(self.sidebar)

        # Right pane: chat + toolbar + input
        right = QWidget()
        rv = QVBoxLayout(right)
        rv.setContentsMargins(0, 0, 0, 0)
        rv.setSpacing(0)

        # Toolbar row with quick actions
        tb = QHBoxLayout()
        tb.setContentsMargins(12, 10, 12, 10)
        tb.setSpacing(8)
        for label, slot, tip in (
            ("🩺 Doctor",   self._do_doctor,   "System health + AI verdict"),
            ("💡 Tip",      self._do_tip,      "One-line proactive suggestion"),
            ("🧭 Context",  self._do_context,  "Show current system snapshot"),
            ("🧾 Remember", self._do_remember, "Add a persistent note"),
            ("🧹 Clear",    self._do_clear,    "Clear this conversation"),
        ):
            b = QPushButton(label)
            b.setToolTip(tip)
            b.clicked.connect(slot)
            tb.addWidget(b)
        tb.addStretch(1)
        self._stop_btn = QPushButton("■ Stop")
        self._stop_btn.setToolTip("Interrupt current response")
        self._stop_btn.setEnabled(False)
        self._stop_btn.clicked.connect(self._stop_stream)
        tb.addWidget(self._stop_btn)
        rv.addLayout(tb)

        self.chat = ChatView()
        rv.addWidget(self.chat, 1)

        # Input row
        inp_row = QHBoxLayout()
        inp_row.setContentsMargins(12, 0, 12, 12)
        inp_row.setSpacing(8)
        self.input = QPlainTextEdit()
        self.input.setObjectName("chat_input")
        self.input.setPlaceholderText("Ask BalAI…  (Enter to send, Shift+Enter for newline)")
        self.input.setFixedHeight(70)
        self.input.installEventFilter(self)
        inp_row.addWidget(self.input, 1)

        self.send_btn = QPushButton("Send  ↵")
        self.send_btn.setObjectName("send")
        self.send_btn.setFixedHeight(70)
        self.send_btn.setMinimumWidth(110)
        self.send_btn.clicked.connect(self._on_send)
        inp_row.addWidget(self.send_btn)
        rv.addLayout(inp_row)

        hroot.addWidget(right, 1)

        # Status bar shows ollama reachability + active model.
        sb = QStatusBar()
        self.setStatusBar(sb)
        self._sb_status = QLabel("checking ollama…")
        sb.addWidget(self._sb_status)
        self._sb_model = QLabel(f"model: {MODEL}")
        sb.addPermanentWidget(self._sb_model)

        # Shortcuts
        QShortcut(QKeySequence("Ctrl+L"), self, activated=self._do_clear)
        QShortcut(QKeySequence("Ctrl+D"), self, activated=self._do_doctor)
        QShortcut(QKeySequence("Ctrl+T"), self, activated=self._do_tip)
        QShortcut(QKeySequence("Ctrl+K"), self, activated=self._do_context)
        QShortcut(QKeySequence("Ctrl+Q"), self, activated=self.close)

        # Chat history for proper multi-turn (excluding system prompt).
        self.history: list[dict] = []
        self._thread: AIThread | None = None

        # Kick an initial ollama ping.
        QTimer.singleShot(200, self._ping_ollama)
        self._ping_timer = QTimer(self)
        self._ping_timer.timeout.connect(self._ping_ollama)
        self._ping_timer.start(15_000)

    # ── event filter: Enter submits, Shift+Enter = newline ────────

    def eventFilter(self, obj, ev):
        from PySide6.QtCore import QEvent
        if obj is self.input and ev.type() == QEvent.KeyPress:
            if ev.key() in (Qt.Key_Return, Qt.Key_Enter):
                # Shift/Ctrl+Enter inserts a newline; bare Enter sends.
                if ev.modifiers() & (Qt.ShiftModifier | Qt.ControlModifier):
                    return False
                self._on_send()
                return True
        return super().eventFilter(obj, ev)

    # ── quick actions ─────────────────────────────────────────────

    def _do_clear(self):
        self.chat.clear()
        self.history.clear()
        self.chat.add_system("conversation cleared")

    def _do_doctor(self):
        self._run_cli(["balai", "doctor"], header="🩺 system doctor")

    def _do_tip(self):
        self._run_cli(["balai", "tip"], header="💡 tip")

    def _do_context(self):
        self._run_cli(["balai", "ctx"], header="🧭 current context", render=False)

    def _do_remember(self):
        text, ok = QInputDialog.getText(
            self, "Remember this",
            "Add a note BalAI will keep in mind across sessions:"
        )
        if ok and text.strip():
            try:
                NOTES_FILE.parent.mkdir(parents=True, exist_ok=True)
                with NOTES_FILE.open("a") as f:
                    f.write(f"- {text.strip()}\n")
                self.chat.add_system(f"remembered: {text.strip()}")
            except OSError as e:
                self.chat.add_system(f"could not save note: {e}", "err")

    # ── sending messages ─────────────────────────────────────────

    def _on_send(self):
        if self._thread and self._thread.isRunning():
            return
        text = self.input.toPlainText().strip()
        if not text:
            return
        self.input.clear()
        self._send(text)

    def _send(self, prompt: str):
        # Context injection: if prompt looks like "my / current / what's…",
        # prepend a live snapshot so the 1.5B model doesn't hallucinate.
        effective = prompt
        if _needs_ctx(prompt):
            effective = (
                "Current BalOS system state:\n"
                f"{_inline_ctx()}\n"
                f"User question: {prompt}"
            )

        self.chat.add_user(prompt)
        self.history.append({"role": "user", "content": effective})
        self.chat.start_ai()

        self.send_btn.setEnabled(False)
        self._stop_btn.setEnabled(True)

        self._thread = AIThread(effective,
                                history=self.history[:-1])  # exclude current user msg
        self._thread.chunk.connect(self.chat.append_ai_chunk)
        self._thread.done.connect(self._on_done)
        self._thread.error.connect(self._on_error)
        self._thread.start()

    def _stop_stream(self):
        if self._thread and self._thread.isRunning():
            self._thread.stop()
            self.chat.add_system("stopped")

    @Slot(str)
    def _on_done(self, full: str):
        rendered = self.chat.finish_ai()
        self.history.append({"role": "assistant", "content": full or rendered})
        self.send_btn.setEnabled(True)
        self._stop_btn.setEnabled(False)

    @Slot(str)
    def _on_error(self, msg: str):
        self.chat.finish_ai()
        self.chat.add_system(msg, "err")
        self.send_btn.setEnabled(True)
        self._stop_btn.setEnabled(False)

    # ── run an external balai subcommand and render its output ──

    def _run_cli(self, cmd: list[str], header: str, render: bool = True):
        if not shutil.which(cmd[0]):
            self.chat.add_system(f"{cmd[0]} not found", "err")
            return
        self.chat.add_system(header)
        try:
            out = subprocess.run(
                cmd, capture_output=True, text=True, timeout=120,
            ).stdout.strip()
        except subprocess.TimeoutExpired:
            self.chat.add_system(f"{' '.join(cmd)} timed out", "warn")
            return
        if not out:
            self.chat.add_system("(no output)")
            return
        if render:
            self.chat._append_html(_md_to_html(out))
        else:
            self.chat._append_html(f"<pre>{_html_escape(out)}</pre>")

    # ── ollama reachability indicator ────────────────────────────

    def _ping_ollama(self):
        reachable = False
        try:
            import requests
            r = requests.get(f"{OLLAMA_URL}/api/tags", timeout=1.5)
            reachable = r.ok
        except Exception:
            reachable = False
        if reachable:
            self._sb_status.setText("● ollama connected")
            self._sb_status.setStyleSheet(f"color: {OK};")
        else:
            self._sb_status.setText("○ ollama not running — run: sudo systemctl start ollama")
            self._sb_status.setStyleSheet(f"color: {BAD};")


# ─── context helpers (mirror of balai's gather_ctx / needs_ctx) ─────

_CTX_KEYWORDS = re.compile(
    r"\b(my|current|right now|what(?:'s| is)|how (?:many|much)|status|"
    r"am i|are we)\b.*\b(battery|cpu|ram|memory|disk|firewall|shield|"
    r"vpn|wifi|ssid|tor|stealth|power|profile|kernel|uptime|ip|iface|"
    r"interface|governor|temp|load|connected|protected|online)\b",
    re.IGNORECASE,
)

def _needs_ctx(prompt: str) -> bool:
    return bool(_CTX_KEYWORDS.search(prompt))


def _inline_ctx() -> str:
    iface, ip = _iface_and_ip()
    cap, st = _battery()
    return (
        f"kernel: {_kernel()}\n"
        f"uptime: {_uptime()}\n"
        f"load 1m: {_cpu_load()}    governor: {_governor()}\n"
        f"memory: {_mem()}          disk /: {_disk_root()}\n"
        f"power-profile: {_power_profile()}\n"
        f"battery: {cap or 'AC'} {st}\n"
        f"iface: {iface or 'none'}  ip: {ip or '-'}\n"
        f"ssid: {_wifi_ssid() or '-'}    vpn: {_vpn_state()}\n"
        f"firewall: {_shield_tier()}\n"
    )


# ─── entrypoint ────────────────────────────────────────────────────

def main():
    app = QApplication(sys.argv)
    app.setApplicationName("balai-chat")
    app.setOrganizationName("BalOS")
    # Hint Qt platform plugin on Wayland-first sessions.
    if os.environ.get("XDG_SESSION_TYPE") == "wayland":
        os.environ.setdefault("QT_QPA_PLATFORM", "wayland;xcb")

    # Dark palette fallback (for system dialogs that ignore the stylesheet).
    pal = app.palette()
    pal.setColor(QPalette.Window, QColor(BG))
    pal.setColor(QPalette.Base, QColor(PANEL))
    pal.setColor(QPalette.Text, QColor(FG))
    pal.setColor(QPalette.WindowText, QColor(FG))
    pal.setColor(QPalette.Button, QColor(PANEL_ALT))
    pal.setColor(QPalette.ButtonText, QColor(FG))
    pal.setColor(QPalette.Highlight, QColor(ACCENT))
    pal.setColor(QPalette.HighlightedText, QColor("#ffffff"))
    app.setPalette(pal)

    w = MainWindow()
    w.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
