#!/usr/bin/env python3
# balai-chat — graphical front-end for BalAI.
#
# A friendly Qt6 chat window around the local Qwen2.5-1.5B model served by
# the ollama daemon at 127.0.0.1:11434. Streams tokens as they arrive, shows
# a live system dashboard on the left (battery, CPU, RAM, net, firewall,
# VPN, power profile), and exposes one-click shortcuts to the most useful
# balai subcommands (doctor, tip, ctx, remember).
#
# Zero cloud. Everything runs on this machine.
# Depends on: pyside6, python-requests, ollama, balai (which ships the model).

from __future__ import annotations

import json
import os
import re
import shutil
import socket
import subprocess
import sys
import time
from pathlib import Path

try:
    import requests  # noqa: F401 (imported lazily below for the status ping)
except Exception:  # pragma: no cover — on BalOS this is a hard dep
    requests = None

from PySide6.QtCore import (
    Qt, QTimer, QThread, Signal, Slot, QSize,
)
from PySide6.QtGui import (
    QAction, QFont, QFontDatabase, QIcon, QKeySequence, QPalette, QColor,
    QTextCursor, QShortcut,
)
from PySide6.QtWidgets import (
    QApplication, QHBoxLayout, QVBoxLayout, QWidget, QPushButton, QLabel,
    QTextEdit, QPlainTextEdit, QSizePolicy, QFrame, QScrollArea, QMainWindow,
    QInputDialog, QMessageBox, QMenu, QStatusBar, QSplitter,
)

# ─── theme ──────────────────────────────────────────────────────────
BG        = "#0d0d10"   # near-black (Matrix / BalOS dark)
PANEL     = "#16161c"
PANEL_ALT = "#1c1c24"
FG        = "#e7e7ea"
MUTED     = "#8a8a94"
ACCENT    = "#a855f7"   # magenta/violet (BalOS brand)
ACCENT_2  = "#22d3ee"   # cyan for user bubbles
OK        = "#22c55e"
WARN      = "#f59e0b"
BAD       = "#ef4444"

OLLAMA_URL   = os.environ.get("OLLAMA_HOST_URL") or \
               f"http://{os.environ.get('OLLAMA_HOST', '127.0.0.1:11434')}"
MODEL        = os.environ.get("BALAI_MODEL", "qwen2.5:1.5b-instruct-q4_K_M")
SYSTEM_PROMPT_FILE = Path(os.environ.get(
    "BALAI_SYSTEM_PROMPT",
    "/usr/share/balos/ai/system-prompt.md"
))
NOTES_FILE = Path(os.environ.get(
    "BALAI_NOTES_FILE",
    os.path.expanduser("~/.local/state/balai/notes.md"),
))

# ─── small helpers: read system state ──────────────────────────────

def _read(path: str) -> str:
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return ""


def _sh(cmd: list[str], timeout: float = 2.0) -> str:
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return (r.stdout or "").strip()
    except Exception:
        return ""


def _battery() -> tuple[str, str]:
    """Return (percent, state) or ('', '')."""
    for bat in sorted(Path("/sys/class/power_supply").glob("BAT*")):
        cap = _read(str(bat / "capacity"))
        st  = _read(str(bat / "status"))
        if cap:
            return f"{cap}%", st or ""
    return "", ""


def _ac() -> bool:
    for ac in sorted(Path("/sys/class/power_supply").glob("A[CD]*")):
        if _read(str(ac / "online")) == "1":
            return True
    # Laptops often expose "AC", desktops have no battery so assume plugged.
    if not any(Path("/sys/class/power_supply").glob("BAT*")):
        return True
    return False


def _cpu_load() -> str:
    try:
        one, _, _ = os.getloadavg()
        return f"{one:.2f}"
    except OSError:
        return "?"


def _cpu_freq_mhz() -> str:
    v = _read("/proc/cpuinfo")
    for line in v.splitlines():
        if line.lower().startswith("cpu mhz"):
            try:
                return f"{int(float(line.split(':')[1].strip()))} MHz"
            except Exception:
                break
    return ""


def _governor() -> str:
    return _read("/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor") or "?"


def _mem() -> str:
    try:
        total = free = avail = 0
        with open("/proc/meminfo") as f:
            for line in f:
                k, _, rest = line.partition(":")
                parts = rest.strip().split()
                if not parts:
                    continue
                try:
                    val = int(parts[0])
                except ValueError:
                    continue
                if k == "MemTotal":
                    total = val
                elif k == "MemFree":
                    free = val
                elif k == "MemAvailable":
                    avail = val
        if total:
            used_gb = (total - (avail or free)) / 1_048_576
            total_gb = total / 1_048_576
            return f"{used_gb:.1f} / {total_gb:.1f} GB"
    except OSError:
        pass
    return "?"


def _disk_root() -> str:
    try:
        s = os.statvfs("/")
        used = (s.f_blocks - s.f_bfree) * s.f_frsize / 1_073_741_824
        total = s.f_blocks * s.f_frsize / 1_073_741_824
        return f"{used:.0f} / {total:.0f} GB"
    except OSError:
        return "?"


def _uptime() -> str:
    try:
        with open("/proc/uptime") as f:
            secs = float(f.read().split()[0])
        d, rem = divmod(int(secs), 86400)
        h, rem = divmod(rem, 3600)
        m, _   = divmod(rem, 60)
        if d:  return f"{d}d {h}h {m}m"
        if h:  return f"{h}h {m}m"
        return f"{m}m"
    except OSError:
        return "?"


def _kernel() -> str:
    return _read("/proc/sys/kernel/osrelease") or "?"


def _iface_and_ip() -> tuple[str, str]:
    """Best-effort: first non-loopback iface with a carrier + v4 IP."""
    for iface in sorted(Path("/sys/class/net").iterdir(), key=lambda p: p.name):
        if iface.name == "lo":
            continue
        if _read(str(iface / "operstate")) != "up":
            continue
        ip = _sh(["ip", "-4", "-br", "addr", "show", "dev", iface.name]).split()
        if len(ip) >= 3:
            return iface.name, ip[2].split("/")[0]
    return "", ""


def _wifi_ssid() -> str:
    out = _sh(["iwgetid", "-r"]) or _sh(["iw", "dev"])
    if out and "SSID" not in out:
        return out.split("\n")[0].strip()
    return ""


def _vpn_state() -> str:
    # WireGuard via wg-quick (@wg0 is BalOS default)
    wg = _sh(["wg", "show", "wg0", "transfer"])
    if wg:
        return "wg0 ↑"
    # NetworkManager VPN connection
    nm = _sh(["nmcli", "-t", "-f", "TYPE,STATE,NAME", "con", "show", "--active"])
    for line in nm.splitlines():
        if line.startswith("vpn:") or "wireguard" in line:
            parts = line.split(":")
            if len(parts) >= 3 and parts[1] == "activated":
                return parts[2] + " ↑"
    return "off"


def _shield_tier() -> str:
    return _read("/run/balos/shield-tier") or "?"


def _power_profile() -> str:
    v = _read("/run/balos/power-profile")
    if v:
        return v.replace(":", " ")
    return "balance"


# ─── model client — streaming generator ─────────────────────────────

class AIThread(QThread):
    """Streams ollama tokens back to the UI.

    Emits:
      chunk(str)   — incremental token text
      done(str)    — final full assistant response (also used to snapshot history)
      error(str)   — fatal error message
    """
    chunk = Signal(str)
    done  = Signal(str)
    error = Signal(str)

    def __init__(self, prompt: str, history: list[dict], parent=None):
        super().__init__(parent)
        self._prompt = prompt
        self._history = history  # list of {"role": "...", "content": "..."}
        self._stop = False

    def stop(self):
        self._stop = True

    def run(self):
        try:
            import requests  # noqa: redefine for thread-local import safety
        except ImportError:
            self.error.emit("python-requests is not installed")
            return

        sys_prompt = ""
        if SYSTEM_PROMPT_FILE.exists():
            try:
                sys_prompt = SYSTEM_PROMPT_FILE.read_text()[:12000]
            except OSError:
                pass
        notes = ""
        if NOTES_FILE.exists():
            try:
                notes = NOTES_FILE.read_text()[:2048]
            except OSError:
                pass
        if notes:
            sys_prompt = (sys_prompt + "\n\nUser preferences and notes "
                          "(remember these):\n" + notes)

        # Build Ollama /api/chat payload.
        messages = []
        if sys_prompt:
            messages.append({"role": "system", "content": sys_prompt})
        messages.extend(self._history)
        messages.append({"role": "user", "content": self._prompt})

        try:
            resp = requests.post(
                f"{OLLAMA_URL}/api/chat",
                json={
                    "model": MODEL,
                    "messages": messages,
                    "stream": True,
                    "options": {
                        "temperature": 0.2,
                        "top_p": 0.9,
                        "num_predict": 512,
                    },
                },
                stream=True,
                timeout=(5, 180),
            )
            resp.raise_for_status()
        except Exception as e:
            self.error.emit(f"ollama unreachable: {e}")
            return

        full: list[str] = []
        for raw in resp.iter_lines(decode_unicode=True):
            if self._stop:
                break
            if not raw:
                continue
            try:
                obj = json.loads(raw)
            except json.JSONDecodeError:
                continue
            piece = obj.get("message", {}).get("content", "")
            if piece:
                full.append(piece)
                self.chunk.emit(piece)
            if obj.get("done"):
                break
        self.done.emit("".join(full))


