#!/usr/bin/env bash
# balnet — network swiss army knife
set -euo pipefail

G='\033[0;32m'; C='\033[0;36m'; Y='\033[1;33m'; M='\033[0;35m'
B='\033[1m'; D='\033[2m'; N='\033[0m'

CMD="${1:-help}"; shift || true

usage() {
cat << EOF
${C}${B}balnet${N} — network toolkit

${B}INFO${N}
  ${C}ip${N}              Show all IPs (local + public + VPN)
  ${C}iface${N}           List interfaces with stats
  ${C}speed${N}           Run speedtest-cli
  ${C}ports${N}           Show listening ports (ss)
  ${C}conns${N}           Show active connections
  ${C}dns${N}             Current DNS servers

${B}WIFI${N}
  ${C}scan${N}            Scan nearby networks
  ${C}connect <SSID>${N}  Connect with prompt
  ${C}monitor <iface>${N} Enable monitor mode
  ${C}managed <iface>${N} Restore managed mode

${B}VPN${N}
  ${C}vpn up [name]${N}   Start WireGuard tunnel (default wg0)
  ${C}vpn down${N}        Stop WireGuard
  ${C}vpn status${N}      Show VPN status

${B}UTIL${N}
  ${C}mac <iface>${N}     Randomize MAC
  ${C}flush${N}           Flush DNS + ARP + routes
  ${C}proxy <port>${N}    Start SOCKS5 proxy (via SSH)
  ${C}scan <target>${N}   Quick nmap on target
EOF
}

case "$CMD" in
    ip|addr)
        echo -e "${B}Local:${N}   $(ip -4 addr show | awk '/inet / && !/127\./{print $2}' | paste -sd ' ')"
        echo -e "${B}Public:${N}  ${C}$(curl -s ifconfig.me 2>/dev/null)${N}"
        ip link show wg0 &>/dev/null && echo -e "${B}VPN:${N}     $(ip -4 addr show wg0 | awk '/inet /{print $2}')"
        ;;
    iface|interfaces)
        ip -br link | while read -r line; do
            echo "  $line"
        done
        ;;
    speed)
        speedtest-cli --simple
        ;;
    ports)
        sudo ss -tulnp
        ;;
    conns|connections)
        sudo ss -tupn state established
        ;;
    dns)
        resolvectl status | grep -E 'DNS Server|DNS Domain|Link'
        ;;
    scan|wifi-scan)
        nmcli device wifi list --rescan yes
        ;;
    connect)
        nmcli device wifi connect "$1"
        ;;
    monitor)
        IFACE="${1:-wlan0}"
        sudo airmon-ng check kill
        sudo airmon-ng start "$IFACE"
        ;;
    managed)
        IFACE="${1:-wlan0mon}"
        sudo airmon-ng stop "$IFACE"
        sudo systemctl start NetworkManager
        ;;
    mac)
        IFACE="${1:-wlan0}"
        sudo ip link set "$IFACE" down
        sudo macchanger -r "$IFACE"
        sudo ip link set "$IFACE" up
        ;;
    flush)
        sudo resolvectl flush-caches
        sudo ip -s neigh flush all
        sudo ip route flush cache
        echo -e "${G}✓ flushed${N}"
        ;;
    vpn)
        SUB="${1:-status}"
        case "$SUB" in
            up|start)     sudo wg-quick up "${2:-wg0}" ;;
            down|stop)    sudo wg-quick down "${2:-wg0}" ;;
            status|show)  sudo wg show ;;
        esac
        ;;
    proxy)
        PORT="${1:-1080}"
        HOST="${2:-user@host}"
        echo -e "${C}Starting SOCKS5 proxy on localhost:${PORT} via ${HOST}${N}"
        ssh -D "$PORT" -N -q -C "$HOST"
        ;;
    nmap|portscan)
        sudo nmap -sV -sC -T4 "$@"
        ;;
    help|*)
        usage
        ;;
esac
