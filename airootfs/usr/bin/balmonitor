#!/usr/bin/env bash
# balmonitor — real-time TUI dashboard for BalOS
# Per-core CPU bars · network sparklines · battery drain · GPU · temps
set -euo pipefail

G='\033[0;32m'; R='\033[0;31m'; Y='\033[1;33m'; C='\033[0;36m'; M='\033[0;35m'
B='\033[1m'; D='\033[2m'; N='\033[0m'; DIM='\033[38;5;240m'

ONCE=false
COMPACT=false
case "${1:-}" in
    --once)    ONCE=true ;;
    --compact) COMPACT=true ;;
esac

# Sparkline glyphs (8 levels)
SPARK=(▁ ▂ ▃ ▄ ▅ ▆ ▇ █)

# Globals for deltas between frames
declare -a PREV_CPU_TOTAL=()
declare -a PREV_CPU_IDLE=()
PREV_RX=0; PREV_TX=0
PREV_DISK_READ=0; PREV_DISK_WRITE=0
declare -a HIST_RX=() HIST_TX=() HIST_CPU=()
HIST_MAX=40

# ─── helpers ──────────────────────────────────────────────────
cols() { tput cols 2>/dev/null || echo 80; }

bar() {
    # $1 = pct 0-100 · $2 = width · $3 = color
    local pct="${1%.*}"; local w="$2"; local col="$3"
    (( pct < 0 )) && pct=0; (( pct > 100 )) && pct=100
    local filled=$(( pct * w / 100 ))
    local empty=$(( w - filled ))
    local barcol="$col"
    (( pct >= 85 )) && barcol="$R"
    (( pct >= 60 && pct < 85 )) && barcol="$Y"
    printf "${barcol}"
    printf '█%.0s' $(seq 1 $filled 2>/dev/null)
    printf "${DIM}"
    printf '░%.0s' $(seq 1 $empty 2>/dev/null)
    printf "${N}"
}

sparkline() {
    # render history array as spark glyphs; arg = array name
    local -n arr=$1
    local max=1 v
    for v in "${arr[@]}"; do (( v > max )) && max=$v; done
    (( max == 0 )) && max=1
    local out=""
    for v in "${arr[@]}"; do
        local idx=$(( v * 7 / max ))
        (( idx > 7 )) && idx=7
        out+="${SPARK[$idx]}"
    done
    printf "%s" "$out"
}

push_hist() {
    # $1=array name, $2=value
    local -n a=$1
    a+=("$2")
    while (( ${#a[@]} > HIST_MAX )); do a=("${a[@]:1}"); done
}

human_bytes() {
    local b=$1
    if   (( b > 1073741824 )); then awk -v b="$b" 'BEGIN{printf "%.1f GB/s", b/1073741824}'
    elif (( b > 1048576 ));    then awk -v b="$b" 'BEGIN{printf "%.1f MB/s", b/1048576}'
    elif (( b > 1024 ));       then awk -v b="$b" 'BEGIN{printf "%.1f KB/s", b/1024}'
    else                            echo "${b} B/s"
    fi
}

# ─── samplers ─────────────────────────────────────────────────
read_cpu_stats() {
    # Fills CPU_USAGE[] array with per-core pct since last call
    CPU_USAGE=()
    local i=0
    while IFS= read -r line; do
        [[ "$line" =~ ^cpu[0-9]+ ]] || continue
        local vals=($line)
        local user=${vals[1]} nice=${vals[2]} sys=${vals[3]} idle=${vals[4]} iowait=${vals[5]:-0}
        local total=$((user+nice+sys+idle+iowait))
        local prev_total=${PREV_CPU_TOTAL[$i]:-0}
        local prev_idle=${PREV_CPU_IDLE[$i]:-0}
        local dt=$((total-prev_total)); local di=$((idle-prev_idle))
        local pct=0
        (( dt > 0 )) && pct=$(( (100 * (dt - di)) / dt ))
        CPU_USAGE[$i]=$pct
        PREV_CPU_TOTAL[$i]=$total
        PREV_CPU_IDLE[$i]=$idle
        i=$((i+1))
    done < /proc/stat
}

read_net_stats() {
    # sum across all non-lo interfaces
    local rx=0 tx=0
    while IFS= read -r line; do
        [[ "$line" =~ ^[[:space:]]*[a-z0-9]+: ]] || continue
        local iface=$(echo "$line" | awk -F: '{print $1}' | xargs)
        [[ "$iface" == "lo" ]] && continue
        local fields=($(echo "$line" | awk -F: '{print $2}'))
        rx=$(( rx + ${fields[0]} ))
        tx=$(( tx + ${fields[8]} ))
    done < /proc/net/dev
    NET_RX_BPS=0; NET_TX_BPS=0
    (( PREV_RX > 0 )) && NET_RX_BPS=$(( rx - PREV_RX ))
    (( PREV_TX > 0 )) && NET_TX_BPS=$(( tx - PREV_TX ))
    PREV_RX=$rx; PREV_TX=$tx
    (( NET_RX_BPS < 0 )) && NET_RX_BPS=0
    (( NET_TX_BPS < 0 )) && NET_TX_BPS=0
}

read_battery() {
    BAT_PCT="-"; BAT_STATE="-"; BAT_POWER="-"; BAT_REMAIN="-"
    local bat=$(ls -d /sys/class/power_supply/BAT* 2>/dev/null | head -1)
    [[ -z "$bat" ]] && return
    BAT_PCT=$(cat "$bat/capacity" 2>/dev/null || echo "?")
    BAT_STATE=$(cat "$bat/status" 2>/dev/null || echo "?")
    # Power draw in mW
    if [[ -r "$bat/power_now" ]]; then
        local pn=$(cat "$bat/power_now")
        BAT_POWER=$(awk -v p="$pn" 'BEGIN{printf "%.1f W", p/1000000}')
    elif [[ -r "$bat/current_now" && -r "$bat/voltage_now" ]]; then
        local cn=$(cat "$bat/current_now") vn=$(cat "$bat/voltage_now")
        BAT_POWER=$(awk -v c="$cn" -v v="$vn" 'BEGIN{printf "%.1f W", (c*v)/1000000000000}')
    fi
    # Time remaining
    if [[ "$BAT_STATE" == "Discharging" && -r "$bat/energy_now" && -r "$bat/power_now" ]]; then
        local en=$(cat "$bat/energy_now") pn=$(cat "$bat/power_now")
        (( pn > 0 )) && BAT_REMAIN=$(awk -v e="$en" -v p="$pn" 'BEGIN{h=e/p; printf "%dh %dm", int(h), int((h-int(h))*60)}')
    fi
}

read_gpu() {
    GPU_USAGE="-"; GPU_TEMP="-"; GPU_NAME=""
    # AMD
    if [[ -r /sys/class/drm/card0/device/gpu_busy_percent ]]; then
        GPU_USAGE="$(cat /sys/class/drm/card0/device/gpu_busy_percent)"
        GPU_NAME="amd"
    # NVIDIA
    elif command -v nvidia-smi &>/dev/null; then
        local out=$(nvidia-smi --query-gpu=utilization.gpu,temperature.gpu --format=csv,noheader,nounits 2>/dev/null | head -1)
        if [[ -n "$out" ]]; then
            GPU_USAGE=$(echo "$out" | cut -d, -f1 | xargs)
            GPU_TEMP=$(echo "$out" | cut -d, -f2 | xargs)
            GPU_NAME="nvidia"
        fi
    fi
    # AMD/Intel temp via hwmon
    if [[ "$GPU_TEMP" == "-" ]]; then
        for h in /sys/class/hwmon/hwmon*/name; do
            [[ -r "$h" ]] || continue
            local n=$(cat "$h")
            if [[ "$n" =~ ^(amdgpu|i915|k10temp|intel_gpu)$ ]] && [[ "$n" != "k10temp" ]]; then
                local t=$(cat "$(dirname "$h")/temp1_input" 2>/dev/null)
                [[ -n "$t" ]] && { GPU_TEMP=$((t/1000)); break; }
            fi
        done
    fi
}

read_cpu_temp() {
    CPU_TEMP="-"
    for h in /sys/class/hwmon/hwmon*/name; do
        [[ -r "$h" ]] || continue
        local n=$(cat "$h")
        if [[ "$n" =~ ^(coretemp|k10temp|zenpower)$ ]]; then
            local t=$(cat "$(dirname "$h")/temp1_input" 2>/dev/null)
            [[ -n "$t" ]] && { CPU_TEMP=$((t/1000)); return; }
        fi
    done
    # thermal_zone fallback
    local t=$(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null)
    [[ -n "$t" ]] && CPU_TEMP=$((t/1000))
}

read_disk() {
    DISK_R_BPS=0; DISK_W_BPS=0
    local r=0 w=0
    while read -r _ _ dev _ _ rd _ _ _ wt _; do
        [[ "$dev" =~ ^(sd[a-z]|nvme[0-9]+n[0-9]+|vd[a-z])$ ]] || continue
        r=$(( r + rd )); w=$(( w + wt ))
    done < /proc/diskstats
    # Sectors are 512B
    local rb=$(( r * 512 )) wb=$(( w * 512 ))
    (( PREV_DISK_READ > 0 ))  && DISK_R_BPS=$(( rb - PREV_DISK_READ ))
    (( PREV_DISK_WRITE > 0 )) && DISK_W_BPS=$(( wb - PREV_DISK_WRITE ))
    PREV_DISK_READ=$rb; PREV_DISK_WRITE=$wb
    (( DISK_R_BPS < 0 )) && DISK_R_BPS=0
    (( DISK_W_BPS < 0 )) && DISK_W_BPS=0
}

# ─── render ───────────────────────────────────────────────────
render() {
    read_cpu_stats
    read_net_stats
    read_battery
    read_gpu
    read_cpu_temp
    read_disk

    # Aggregate CPU avg
    local sum=0 n=${#CPU_USAGE[@]}
    for p in "${CPU_USAGE[@]}"; do sum=$((sum+p)); done
    local cpu_avg=0
    (( n > 0 )) && cpu_avg=$(( sum / n ))

    push_hist HIST_CPU "$cpu_avg"
    push_hist HIST_RX "$(( NET_RX_BPS / 1024 ))"
    push_hist HIST_TX "$(( NET_TX_BPS / 1024 ))"

    local mode=$(cat /run/balos-mode 2>/dev/null || cat /tmp/balos-mode 2>/dev/null || echo "default")
    local cpu_gov=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo "?")
    local cpu_boost=$(cat /sys/devices/system/cpu/cpufreq/boost 2>/dev/null || echo "?")
    local cpu_freq=$(awk '/cpu MHz/{sum+=$4;c++}END{if(c>0)printf "%.2f GHz",(sum/c)/1000; else printf "?.?? GHz"}' /proc/cpuinfo 2>/dev/null || echo "?.?? GHz")
    local ram_info=$(free -m | awk '/^Mem:/{printf "%d/%d MB (%d%%)", $3,$2,($3*100/$2)}')
    local ram_pct=$(free -m | awk '/^Mem:/{printf "%d", ($3*100/$2)}')
    local swap_info=$(free -m | awk '/^Swap:/{if($2>0)printf "%d/%d MB",$3,$2; else printf "off"}')
    local load=$(awk '{printf "%s %s %s", $1,$2,$3}' /proc/loadavg)
    local procs=$(awk '{print $4}' /proc/loadavg)
    local up=$(uptime -p | sed 's/up //')

    local ip_local=$(ip -4 addr show | awk '/inet / && !/127\./{print $2; exit}' | cut -d/ -f1)
    local iface=$(ip -4 route show default | awk '{print $5; exit}')
    local vpn_state="${Y}down${N}"
    ip link show wg0 &>/dev/null && vpn_state="${G}up${N}"
    local tor_state=$(systemctl is-active tor 2>/dev/null || echo inactive)
    local fw=$(nft list tables 2>/dev/null | head -1 | awk '{print $NF}')
    [[ -z "$fw" ]] && fw="${Y}off${N}" || fw="${G}${fw}${N}"
    local gm=$(systemctl --user is-active gamemoded 2>/dev/null || echo inactive)
    [[ "$gm" == "active" ]] && gm="${G}on${N}" || gm="${D}off${N}"

    local mode_color="$G"
    case "$mode" in
        boost*) mode_color="$R" ;;
        saver*) mode_color="$C" ;;
    esac

    local W=$(cols)
    (( W > 110 )) && W=110
    (( W < 70 )) && W=70

    clear
    # ─ Header
    printf "${M}${B}┏"; printf '━%.0s' $(seq 1 $((W-2))); printf "┓${N}\n"
    printf "${M}${B}┃${N}  ${C}${B}BalOS${N} · monitor    profile: ${mode_color}${B}%-12s${N}  uptime: ${D}%-20s${N}" "$mode" "$up"
    local used=$((15 + 12 + 12 + 20))
    printf '%*s' $((W - used - 4)) ""
    printf "${M}${B}┃${N}\n"
    printf "${M}${B}┣"; printf '━%.0s' $(seq 1 $((W-2))); printf "┫${N}\n"

    # ─ CPU per-core
    printf "${M}┃${N}  ${B}CPU${N}  gov=${C}%-11s${N}  boost=${C}%-3s${N}  avg=${C}%3d%%${N}  freq=${C}%-10s${N}  temp=${C}%3s°C${N}\n" \
        "$cpu_gov" "$cpu_boost" "$cpu_avg" "$cpu_freq" "$CPU_TEMP"

    # Show per-core bars in 2 columns if many cores
    local bar_w=$(( (W - 20) / 2 - 6 ))
    (( bar_w < 10 )) && bar_w=10
    local i=0
    local nc=${#CPU_USAGE[@]}
    while (( i < nc )); do
        printf "${M}┃${N}  "
        printf "c%-2d " $i
        printf "%s" "$(bar ${CPU_USAGE[$i]} $bar_w $G)"
        printf " ${D}%3d%%${N}" "${CPU_USAGE[$i]}"
        local j=$((i + nc / 2))
        if (( j < nc )); then
            printf "  c%-2d " $j
            printf "%s" "$(bar ${CPU_USAGE[$j]} $bar_w $G)"
            printf " ${D}%3d%%${N}" "${CPU_USAGE[$j]}"
        fi
        printf "\n"
        i=$((i+1))
        (( i >= nc / 2 )) && break
    done

    # ─ CPU history sparkline
    printf "${M}┃${N}  ${B}CPU hist${N}  ${G}$(sparkline HIST_CPU)${N}  ${D}(last ${#HIST_CPU[@]}s)${N}\n"

    printf "${M}┣"; printf '━%.0s' $(seq 1 $((W-2))); printf "┫${N}\n"

    # ─ Memory/load
    printf "${M}┃${N}  ${B}RAM${N}    $(bar $ram_pct 30 $C)  ${C}%s${N}\n" "$ram_info"
    printf "${M}┃${N}  ${B}Swap${N}   ${C}%s${N}     ${B}Load${N} ${C}%s${N}     ${B}Procs${N} ${C}%s${N}\n" "$swap_info" "$load" "$procs"

    printf "${M}┣"; printf '━%.0s' $(seq 1 $((W-2))); printf "┫${N}\n"

    # ─ Battery
    local bat_color="$G"
    [[ "$BAT_PCT" != "-" ]] && (( BAT_PCT < 30 )) && bat_color="$Y"
    [[ "$BAT_PCT" != "-" ]] && (( BAT_PCT < 15 )) && bat_color="$R"
    local state_icon="⚡"
    [[ "$BAT_STATE" == "Discharging" ]] && state_icon="▼"
    [[ "$BAT_STATE" == "Charging" ]]    && state_icon="▲"
    [[ "$BAT_STATE" == "Full" ]]        && state_icon="●"
    if [[ "$BAT_PCT" != "-" ]]; then
        printf "${M}┃${N}  ${B}Battery${N} $(bar $BAT_PCT 20 $bat_color) ${bat_color}%3d%% %s${N}  draw=${C}%s${N}  remain=${C}%s${N}\n" \
            "$BAT_PCT" "$state_icon" "$BAT_POWER" "$BAT_REMAIN"
    else
        printf "${M}┃${N}  ${B}Battery${N} ${D}(AC only)${N}\n"
    fi

    # ─ GPU
    if [[ "$GPU_USAGE" != "-" ]]; then
        printf "${M}┃${N}  ${B}GPU${N}    $(bar $GPU_USAGE 20 $M) ${M}%3d%%${N}   name=${C}%s${N}  temp=${C}%s°C${N}\n" \
            "$GPU_USAGE" "$GPU_NAME" "$GPU_TEMP"
    fi

    printf "${M}┣"; printf '━%.0s' $(seq 1 $((W-2))); printf "┫${N}\n"

    # ─ Network
    printf "${M}┃${N}  ${B}NET${N}    iface=${C}%-8s${N}  ip=${C}%-16s${N}  fw=%b  vpn=%b  tor=${C}%s${N}\n" \
        "${iface:--}" "${ip_local:--}" "$fw" "$vpn_state" "$tor_state"
    printf "${M}┃${N}  ${G}▼ RX${N}  $(sparkline HIST_RX)  ${C}%s${N}\n" "$(human_bytes $NET_RX_BPS)"
    printf "${M}┃${N}  ${Y}▲ TX${N}  $(sparkline HIST_TX)  ${C}%s${N}\n" "$(human_bytes $NET_TX_BPS)"

    printf "${M}┣"; printf '━%.0s' $(seq 1 $((W-2))); printf "┫${N}\n"

    # ─ Disk I/O
    printf "${M}┃${N}  ${B}DISK${N}   read=${C}%-14s${N}  write=${C}%-14s${N}  gm=%b\n" \
        "$(human_bytes $DISK_R_BPS)" "$(human_bytes $DISK_W_BPS)" "$gm"

    # ─ Top 3 CPU/mem
    printf "${M}┣"; printf '━%.0s' $(seq 1 $((W-2))); printf "┫${N}\n"
    printf "${M}┃${N}  ${B}TOP CPU${N}\n"
    ps -eo pcpu,pmem,comm --sort=-pcpu --no-headers 2>/dev/null | head -3 | while read c m cmd; do
        printf "${M}┃${N}     ${C}%5s%%${N} cpu  ${C}%5s%%${N} mem  ${D}%s${N}\n" "$c" "$m" "$cmd"
    done

    # ─ Footer
    printf "${M}┣"; printf '━%.0s' $(seq 1 $((W-2))); printf "┫${N}\n"
    printf "${M}┃${N}  ${D}q=quit · b=boost · s=saver · p=panic · h=hack · v=vpn · r=refresh${N}\n"
    printf "${M}${B}┗"; printf '━%.0s' $(seq 1 $((W-2))); printf "┛${N}\n"
}

# ─── main ─────────────────────────────────────────────────────
if $ONCE; then
    # First sample (initialize deltas) then second sample after 1s
    read_cpu_stats; read_net_stats; read_disk
    sleep 1
    render
    exit 0
fi

trap 'clear; exit 0' INT TERM
# Prime counters
read_cpu_stats; read_net_stats; read_disk
sleep 1

while true; do
    render
    read -r -s -n1 -t 1 key || key=""
    case "$key" in
        q|Q) clear; exit 0 ;;
        b|B) sudo balboost >/dev/null 2>&1 & ;;
        s|S) sudo balsaver >/dev/null 2>&1 & ;;
        p|P) sudo balpanic soft >/dev/null 2>&1 & ;;
        h|H) balhack & disown ;;
        v|V) sudo wg-quick up wg0 >/dev/null 2>&1 || sudo wg-quick down wg0 >/dev/null 2>&1 ;;
        r|R) : ;;
    esac
done
