#!/usr/bin/env bash
# balvault — GPG-encrypted secrets manager with TUI
# Wraps pass(1) with fzf picker, auto-clipboard, and QR export
set -euo pipefail

G='\033[0;32m'; C='\033[0;36m'; Y='\033[1;33m'; M='\033[0;35m'; R='\033[0;31m'
B='\033[1m'; D='\033[2m'; N='\033[0m'

VAULT_DIR="${BALVAULT_DIR:-$HOME/.balvault}"
export PASSWORD_STORE_DIR="$VAULT_DIR"
export PASSWORD_STORE_CLIP_TIME=20

need() { command -v "$1" &>/dev/null || { echo -e "${R}missing: $1${N}"; return 1; }; }

usage() {
cat << EOF
${C}${B}balvault${N} — encrypted secrets

  ${C}init${N} ${D}<gpg-id>${N}   Initialize vault with GPG identity
  ${C}add${N} ${D}<name>${N}      Add new secret
  ${C}get${N} ${D}[name]${N}      Retrieve (fzf picker if no name)
  ${C}list${N}              List entries
  ${C}edit${N} ${D}<name>${N}     Edit entry
  ${C}rm${N} ${D}<name>${N}       Remove
  ${C}gen${N} ${D}<name>${N}      Generate random password
  ${C}sync${N} ${D}<git-url>${N}  Sync to encrypted git remote
  ${C}lock${N}              Forget GPG cache immediately
  ${C}qr${N} ${D}<name>${N}       Show secret as QR code (for phone)
  ${C}strength${N} ${D}[-p name]${N} Estimate password entropy + AI verdict (stdin or vault entry)
  ${C}audit${N}             Vault hygiene report (entries, duplicates, stale) + AI suggestions

${B}VAULT:${N} ${VAULT_DIR}
EOF
}

init_vault() {
    local gpg_id="${1:-}"
    if [[ -z "$gpg_id" ]]; then
        if ! gpg --list-secret-keys --keyid-format LONG 2>/dev/null | grep -q sec; then
            echo -e "${Y}No GPG key found. Generating Ed25519...${N}"
            gpg --quick-generate-key "${USER}@$(hostname)" ed25519 default 1y
        fi
        gpg_id=$(gpg --list-secret-keys --keyid-format LONG | awk -F'/' '/^sec/{print $2}' | awk '{print $1}' | head -1)
    fi
    pass init "$gpg_id"
    echo -e "${G}✓ Vault initialized with GPG key ${gpg_id}${N}"
}

add_secret() {
    local name="${1:?usage: balvault add <name>}"
    pass insert -m "$name"
}

get_secret() {
    local name="${1:-}"
    if [[ -z "$name" ]]; then
        need fzf || exit 1
        name=$(cd "$VAULT_DIR" && fd -e gpg . | sed 's/\.gpg$//' | fzf --prompt="▶ secret · ")
        [[ -z "$name" ]] && exit 0
    fi
    pass show -c "$name"
    echo -e "${G}✓ Copied to clipboard (clears in 20s)${N}"
}

list_secrets() {
    pass ls
}

gen_secret() {
    local name="${1:?usage: balvault gen <name>}"
    local length="${2:-32}"
    pass generate -c "$name" "$length"
}

sync_vault() {
    cd "$VAULT_DIR" || exit 1
    if [[ ! -d .git ]]; then
        pass git init
        [[ -n "${1:-}" ]] && pass git remote add origin "$1"
    fi
    pass git add -A
    pass git commit -m "sync $(date -Iseconds)" 2>/dev/null || true
    pass git push 2>/dev/null || echo -e "${Y}(set up remote: balvault sync <git-url>)${N}"
}

lock_vault() {
    echo RELOADAGENT | gpg-connect-agent >/dev/null 2>&1
    echo -e "${G}✓ GPG cache cleared${N}"
}

qr_secret() {
    local name="${1:?usage: balvault qr <name>}"
    need qrencode || { echo "install qrencode"; exit 1; }
    pass show "$name" | head -1 | qrencode -t ansiutf8
}

# Evaluate the *strength* of a password read from stdin (or -p <name> for
# an existing entry). Critical: the raw password NEVER leaves this script.
# We compute entropy stats locally and then — if balai is around — ask the
# local model to comment on the stats (length, charset mix, dictionary
# hits from /usr/share/dict/words), not the actual string.
strength() {
    local pw name="" from_vault=false
    while (($#)); do
        case "$1" in
            -p|--pass) name="$2"; from_vault=true; shift 2 ;;
            -h|--help) echo "usage: balvault strength [-p <vault-name>]  (else: read stdin)"; return 0 ;;
            *) shift ;;
        esac
    done

    if $from_vault; then
        [[ -n "$name" ]] || { echo "usage: balvault strength -p <name>"; return 1; }
        pw=$(pass show "$name" | head -1)
    else
        if [[ -t 0 ]]; then
            read -rsp "password (hidden): " pw; echo
        else
            IFS= read -r pw
        fi
    fi
    [[ -n "$pw" ]] || { echo "empty password"; return 1; }

    # Local stats — NO network, no AI yet.
    local len=${#pw}
    local classes=0
    [[ "$pw" =~ [a-z] ]] && classes=$((classes+1))
    [[ "$pw" =~ [A-Z] ]] && classes=$((classes+1))
    [[ "$pw" =~ [0-9] ]] && classes=$((classes+1))
    [[ "$pw" =~ [^A-Za-z0-9] ]] && classes=$((classes+1))

    # Pool size per class (standard Shannon-style estimate).
    local pool=0
    [[ "$pw" =~ [a-z] ]] && pool=$((pool+26))
    [[ "$pw" =~ [A-Z] ]] && pool=$((pool+26))
    [[ "$pw" =~ [0-9] ]] && pool=$((pool+10))
    [[ "$pw" =~ [^A-Za-z0-9] ]] && pool=$((pool+33))
    # bits = len * log2(pool)  — approximate via python for log2
    local bits
    bits=$(python3 -c "import math; print(f'{$len * math.log2($pool):.0f}')" 2>/dev/null || echo "?")

    # Dictionary hit check (warn if the whole password is a common word).
    local dict_hit="no"
    for d in /usr/share/dict/words /usr/share/dict/cracklib-small; do
        [[ -f "$d" ]] || continue
        if grep -qiFx -- "$pw" "$d" 2>/dev/null; then
            dict_hit="yes ($d)"
            break
        fi
    done

    # Repeated-char run detection (aaaa, 1111).
    local max_run=1 cur=1 prev=""
    local i; for ((i=0; i<len; i++)); do
        local ch="${pw:$i:1}"
        if [[ "$ch" == "$prev" ]]; then cur=$((cur+1)); (( cur > max_run )) && max_run=$cur
        else cur=1; fi
        prev="$ch"
    done

    # Verdict buckets.
    local verdict color
    if   (( bits >= 80 )); then verdict="strong";   color="$G"
    elif (( bits >= 60 )); then verdict="good";     color="$G"
    elif (( bits >= 40 )); then verdict="fair";     color="$Y"
    elif (( bits >= 25 )); then verdict="weak";     color="$Y"
    else                         verdict="terrible"; color="$R"
    fi

    echo ""
    echo -e "  length        ${B}${len}${N}"
    echo -e "  character mix ${classes}/4 classes (pool=${pool})"
    echo -e "  entropy       ~${bits} bits  →  ${color}${B}${verdict}${N}"
    echo -e "  longest run   ${max_run} (≥4 is a red flag)"
    echo -e "  dict hit      ${dict_hit}"
    echo ""

    # Optional AI commentary on the STATS (never the raw string).
    if command -v balai >/dev/null 2>&1; then
        local stats
        stats="length=${len}, classes=${classes}/4, pool=${pool}, bits≈${bits}, longest_run=${max_run}, dict_hit=${dict_hit}"
        echo -e "${M}${B}AI verdict:${N}"
        timeout 20 balai "Password-strength stats (no raw password): ${stats}
Give a 1-paragraph plain-English assessment and ONE concrete suggestion if weak." 2>/dev/null || \
            echo "(balai unavailable)"
    fi
}

# Audit the whole vault: counts, duplicates, stale entries (> 1 year).
# Never reveals secrets — only filenames / modtimes.
audit() {
    [[ -d "$VAULT_DIR" ]] || { echo "no vault at $VAULT_DIR — run: balvault init"; return 1; }
    echo -e "${M}${B}▸ BalVault audit${N}\n"
    local total; total=$(find "$VAULT_DIR" -name '*.gpg' | wc -l)
    echo -e "  entries:  ${B}${total}${N}"

    # Names that might collide (case-insensitive duplicates).
    local dups
    dups=$(find "$VAULT_DIR" -name '*.gpg' -printf '%f\n' | sed 's/\.gpg$//' | \
           tr '[:upper:]' '[:lower:]' | sort | uniq -d)
    if [[ -n "$dups" ]]; then
        echo -e "  ${Y}duplicates (case-insensitive):${N}"
        echo "$dups" | sed 's/^/    /'
    else
        echo -e "  duplicates: none"
    fi

    # Stale secrets (> 365 days old).
    local stale_count
    stale_count=$(find "$VAULT_DIR" -name '*.gpg' -mtime +365 2>/dev/null | wc -l)
    if (( stale_count > 0 )); then
        echo -e "  ${Y}stale (>1 year): ${stale_count}${N} — consider rotation"
    else
        echo -e "  stale:     none"
    fi
    echo ""

    if command -v balai >/dev/null 2>&1; then
        echo -e "${M}${B}AI recommendation:${N}"
        timeout 25 balai "My password vault audit:
  entries:     $total
  duplicates:  $(echo "$dups" | wc -l)
  stale >365d: $stale_count
Suggest 2 concrete housekeeping actions (no generic advice)." 2>/dev/null || \
            echo "(balai unavailable)"
    fi
}

need pass || { echo "install: sudo pacman -S pass"; exit 1; }

case "${1:-menu}" in
    init)  shift; init_vault "$@" ;;
    add|insert) shift; add_secret "$@" ;;
    get|show|copy) shift; get_secret "$@" ;;
    list|ls) list_secrets ;;
    edit) shift; pass edit "$@" ;;
    rm|remove|delete) shift; pass rm "$@" ;;
    gen|generate) shift; gen_secret "$@" ;;
    sync|git) shift; sync_vault "$@" ;;
    lock)  lock_vault ;;
    qr)    shift; qr_secret "$@" ;;
    strength|check) shift; strength "$@" ;;
    audit) audit ;;
    menu|help|*) usage ;;
esac
