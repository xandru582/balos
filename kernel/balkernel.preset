# mkinitcpio preset for BalKernel
# Generated images live in /boot next to the kernel image.

ALL_kver="/boot/vmlinuz-linux-balkernel"
ALL_microcode=(/boot/*-ucode.img)

PRESETS=('default' 'fallback')

#default_config="/etc/mkinitcpio.conf"
default_image="/boot/initramfs-linux-balkernel.img"
#default_uki="/efi/EFI/Linux/arch-linux-balkernel.efi"
#default_options="--splash /usr/share/systemd/bootctl/splash-arch.bmp"

#fallback_config="/etc/mkinitcpio.conf"
fallback_image="/boot/initramfs-linux-balkernel-fallback.img"
#fallback_uki="/efi/EFI/Linux/arch-linux-balkernel-fallback.efi"
fallback_options="-S autodetect"
