# Maintainer: BalOS Project <kernel@balos.io>
# Kernel: BalKernel — linux-zen base + Clear Linux perf patches + laptop focus
# Targets: gaming low-latency + aggressive power management + WiFi monitor mode

pkgbase=linux-balkernel
pkgver=6.12.balos
pkgrel=1
pkgdesc='BalKernel: hacker-tuned Linux — gaming, battery, pentesting'
url='https://balos.io/kernel'
arch=(x86_64)
license=(GPL-2.0-only)
makedepends=(
    bc cpio gettext libelf pahole perl python tar xz
    graphviz imagemagick python-sphinx texlive-latexextra
)
options=(!debug !strip)

# Source: zen-kernel upstream
_srcname=zen-kernel
_srctag=v6.12-zen1

source=(
    "git+https://github.com/zen-kernel/zen-kernel.git#tag=${_srctag}?signed"
    "balkernel.config"
    # Clear Linux patches (applied selectively for perf)
    "0001-init-wait-for-partition-and-retry-scan.patch::https://raw.githubusercontent.com/clearlinux-pkgs/linux/main/0107-init-wait-for-partition-and-retry-scan.patch"
    # BORE scheduler already upstream in zen; custom tuning below
    "balkernel-tuning.patch"
)

sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP')

prepare() {
    cd "${_srcname}"

    echo " ▶ Applying BalKernel patches..."
    for patch in ../*.patch; do
        echo "   ├─ $(basename "$patch")"
        patch -p1 -N < "$patch" || echo "   │  (patch already applied or skipped)"
    done

    # Copy optimized config
    cp "${srcdir}/balkernel.config" .config

    # Auto-accept defaults for new symbols, preferring performance + laptop
    make olddefconfig

    # BalKernel version string
    scripts/setlocalversion --save-scmversion
    echo "-balkernel" > localversion.20-pkgname
}

build() {
    cd "${_srcname}"

    # Use all cores + LLVM for faster build
    export LLVM=${LLVM:-0}
    export KCFLAGS="-march=x86-64-v3 -O2 -pipe"

    make KERNELVERSION="${pkgver}" all
}

_package() {
    pkgdesc="BalKernel — hacker-tuned Linux"
    depends=(coreutils kmod initramfs)
    optdepends=(
        'wireless-regdb: WiFi regulatory rules'
        'linux-firmware: firmware images'
        'crda: WiFi regulatory agent'
    )
    provides=(VIRTUALBOX-GUEST-MODULES WIREGUARD-MODULE KSMBD-MODULE)
    replaces=(virtualbox-guest-modules-arch wireguard-arch)

    cd "${_srcname}"

    local kernver="$(make -s kernelrelease)"
    local modulesdir="${pkgdir}/usr/lib/modules/${kernver}"

    install -Dm644 "$(make -s image_name)" "${modulesdir}/vmlinuz"
    install -Dm644 "${modulesdir}/vmlinuz" "${pkgdir}/boot/vmlinuz-${pkgbase}"

    ZSTD_CLEVEL=19 make INSTALL_MOD_PATH="${pkgdir}/usr" INSTALL_MOD_STRIP=1 \
        DEPMOD=/doesnt/exist modules_install

    # Install hooks for mkinitcpio
    echo "${pkgbase}" > "${modulesdir}/pkgbase"
}

_package-headers() {
    pkgdesc="Headers and build files for BalKernel"
    depends=(pahole)

    cd "${_srcname}"
    local builddir="${pkgdir}/usr/lib/modules/$(make -s kernelrelease)/build"

    install -Dt "${builddir}" -m644 .config Makefile Module.symvers System.map \
        localversion.* version vmlinux
    install -Dt "${builddir}/kernel" -m644 kernel/Makefile
    install -Dt "${builddir}/arch/x86" -m644 arch/x86/Makefile
    cp -t "${builddir}" -a scripts
    install -Dt "${builddir}/tools/objtool" tools/objtool/objtool
    install -Dt "${builddir}/tools/bpf/resolve_btfids" tools/bpf/resolve_btfids/resolve_btfids 2>/dev/null || true
    cp -t "${builddir}" -a include
    cp -t "${builddir}/arch/x86" -a arch/x86/include
    install -Dt "${builddir}/arch/x86/kernel" -m644 arch/x86/kernel/asm-offsets.s
    install -Dt "${builddir}/drivers/md" -m644 drivers/md/*.h
    install -Dt "${builddir}/net/mac80211" -m644 net/mac80211/*.h
    install -Dt "${builddir}/drivers/media/i2c" -m644 drivers/media/i2c/msp3400-driver.h
    install -Dt "${builddir}/drivers/media/usb/dvb-usb" -m644 drivers/media/usb/dvb-usb/*.h
    install -Dt "${builddir}/drivers/media/dvb-frontends" -m644 drivers/media/dvb-frontends/*.h
    install -Dt "${builddir}/drivers/media/tuners" -m644 drivers/media/tuners/*.h
    install -Dt "${builddir}/drivers/iio/common/hid-sensors" -m644 drivers/iio/common/hid-sensors/*.h 2>/dev/null || true

    # Remove files unneeded at install time
    find "${builddir}" -type f -name "*.o" -delete
    find "${builddir}" -type l -exec test ! -e {} \; -delete

    # Strip unneeded files
    find -L "${builddir}" -type f -name '*.ko' -exec strip --strip-unneeded {} + 2>/dev/null || true
}

pkgname=("${pkgbase}" "${pkgbase}-headers")
for _p in "${pkgname[@]}"; do
    eval "package_${_p}() {
        $(declare -f "_package${_p#${pkgbase}}")
        _package${_p#${pkgbase}}
    }"
done
