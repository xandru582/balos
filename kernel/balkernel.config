# ═══════════════════════════════════════════════════════════════════
# BalKernel .config overrides (merged over linux-zen defconfig)
#
# This is a fragment file. During prepare():
#   1. Start from linux-zen's `make olddefconfig`
#   2. Apply these overrides with scripts/config
#
# For a real production kernel you'd use a full .config (~12K lines)
# generated from a working x86_64 build. The critical switches are
# documented here so they can be applied via scripts/config or menuconfig.
# ═══════════════════════════════════════════════════════════════════

# ── Architecture (march=x86-64-v3: Haswell+, ~2013 onward) ───────
CONFIG_X86_64=y
CONFIG_GENERIC_CPU3=y               # x86-64-v3 (AVX2)

# ── Preemption (low-latency for gaming) ──────────────────────────
CONFIG_PREEMPT=y
CONFIG_PREEMPT_COUNT=y
CONFIG_PREEMPTION=y
CONFIG_PREEMPT_DYNAMIC=y
# CONFIG_PREEMPT_RT=y               # Fully preemptible (tradeoff: throughput)

# ── Timer frequency (1000Hz for gaming responsiveness) ───────────
CONFIG_HZ_1000=y
CONFIG_HZ=1000
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y                 # Tickless when idle → battery win

# ── Scheduler (BORE from zen + autogroup) ────────────────────────
CONFIG_SCHED_AUTOGROUP=y
CONFIG_SCHED_BORE=y                 # Burst-Oriented Response Enhancer
CONFIG_SCHED_MUQSS=n                # MuQSS not in current zen
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y

# ── CPU governors (intel_pstate + amd_pstate + schedutil) ────────
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_X86_INTEL_PSTATE=y
CONFIG_X86_AMD_PSTATE=y
CONFIG_X86_AMD_PSTATE_UT=n

# ── CPU Idle (deep sleep for battery) ────────────────────────────
CONFIG_CPU_IDLE=y
CONFIG_CPU_IDLE_GOV_MENU=y
CONFIG_CPU_IDLE_GOV_TEO=y           # Timer Events Oriented — better idle residency
CONFIG_INTEL_IDLE=y
CONFIG_ACPI_PROCESSOR=y

# ── Power management ─────────────────────────────────────────────
CONFIG_PM=y
CONFIG_PM_SLEEP=y
CONFIG_PM_AUTOSLEEP=y
CONFIG_PM_WAKELOCKS=y
CONFIG_ACPI=y
CONFIG_ACPI_AC=y
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_THERMAL=y
CONFIG_ACPI_CPU_FREQ_PSS=y
CONFIG_INTEL_POWERCLAMP=y
CONFIG_INTEL_RAPL=y
CONFIG_X86_PKG_TEMP_THERMAL=y
CONFIG_PCIEASPM=y
CONFIG_PCIEASPM_POWERSUPERSAVE=y    # Deepest PCIe link power savings

# ── Networking (low-latency + security) ──────────────────────────
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_SCH_FQ=y                 # Fair queue (for BBR)
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_CAKE=y               # CAKE qdisc — best default
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
CONFIG_NETFILTER=y
CONFIG_NF_TABLES=y
CONFIG_WIREGUARD=y                  # Built-in VPN

# ── Wireless (monitor mode + injection for pentesting) ───────────
CONFIG_WLAN=y
CONFIG_MAC80211=y
CONFIG_CFG80211=y
CONFIG_CFG80211_WEXT=y
CONFIG_MAC80211_MESH=y
# Popular adapters for monitor mode:
CONFIG_ATH9K=m
CONFIG_ATH9K_HTC=m
CONFIG_ATH10K=m
CONFIG_ATH11K=m
CONFIG_RT2800USB=m
CONFIG_RTL8XXXU=m                   # RTL88xx injection
CONFIG_RTW88=m
CONFIG_RTW89=m
CONFIG_MT76_USB=m
CONFIG_MT7921E=m
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m

# ── Filesystems (gaming + snapshots) ─────────────────────────────
CONFIG_EXT4_FS=y
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_LZ4=y
CONFIG_F2FS_FS_ZSTD=y
CONFIG_XFS_FS=y
CONFIG_NTFS3_FS=y                   # Paragon NTFS3 (fast NTFS)
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y

# ── Graphics ─────────────────────────────────────────────────────
CONFIG_DRM=y
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_AMDGPU_SI=y              # Older AMD GCN 1.0
CONFIG_DRM_AMDGPU_CIK=y             # GCN 2.0
CONFIG_DRM_AMDGPU_USERPTR=y
CONFIG_DRM_I915=m
CONFIG_DRM_I915_FORCE_PROBE="*"
CONFIG_DRM_NOUVEAU=m

# ── Security (balanced — mitigations via cmdline, not compile-out) ──
CONFIG_SECURITY=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_YAMA=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y

# ── Containers & Virt ─────────────────────────────────────────────
CONFIG_KVM=m
CONFIG_KVM_AMD=m
CONFIG_KVM_INTEL=m
CONFIG_VIRTIO=m
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_BPF=y

# ── Debugging (disable heavy options for perf) ────────────────────
CONFIG_DEBUG_INFO=n
CONFIG_DEBUG_INFO_DWARF5=n
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=n
CONFIG_DEBUG_KERNEL=n
CONFIG_DEBUG_MISC=n

# ── Compression (fast boot, less space) ──────────────────────────
CONFIG_KERNEL_ZSTD=y
CONFIG_MODULE_COMPRESS_ZSTD=y
CONFIG_MODULE_COMPRESS_XZ=n

# ── LTO (Link-Time Optimization: ~5-10% smaller+faster) ──────────
# Requires clang toolchain
# CONFIG_LTO_CLANG_THIN=y

# ── BORE / EEVDF tuning (zen defaults good, override if needed) ──
# CONFIG_ZEN_INTERACTIVE=y

# ── Transparent Hugepages ─────────────────────────────────────────
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y   # Only when app asks
# "always" would hurt gaming frametimes; madvise is the sweet spot.

# ── FUTEX2 (Proton Fsync) ────────────────────────────────────────
CONFIG_FUTEX=y
CONFIG_FUTEX_PI=y

# ── ZSTD-compressed ZRAM ──────────────────────────────────────────
CONFIG_ZRAM=m
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_ZSWAP=y
CONFIG_ZSWAP_COMPRESSOR_DEFAULT_ZSTD=y
CONFIG_ZSWAP_DEFAULT_ON=y
