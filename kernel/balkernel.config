# ═══════════════════════════════════════════════════════════════════
# BalKernel .config fragment — linux-zen 6.12 base + BalOS tuning.
#
# This file is a fragment of CONFIG_* assignments. The PKGBUILD merges
# it on top of zen's defconfig via `scripts/config --file .config`
# followed by `make olddefconfig` so every symbol resolves cleanly
# (dependencies are picked by Kbuild itself, not by this file).
#
# Design goals, in priority order:
#   1. Security hardening (KASLR, KPTI, FORTIFY, init_on_alloc/free,
#      slab freelist hardening, BPF lockdown, LSM stack, module signing
#      advisory — not forced, so out-of-tree aircrack/realtek drivers
#      still load).
#   2. Low-latency preemption + 1000 Hz tick + dynamic preempt.
#   3. Modern memory reclaim (MGLRU) + ZRAM/ZSWAP with ZSTD.
#   4. Modern network stack (BBR by default + CAKE qdisc built-in).
#   5. Modern filesystems: btrfs, ext4, f2fs, xfs, bcachefs, ntfs3.
#   6. Gaming: FUTEX, FUTEX2 wait-multiple, schedutil governor,
#      transparent hugepages "madvise".
#   7. Pentest-friendly wireless: mac80211 monitor mode + injection
#      for ath9k/ath10k/ath11k/rtw88/rtw89/rtl8xxxu/mt76/iwlwifi.
#   8. KVM host + guest + VFIO for GPU passthrough.
#   9. Laptop ACPI / thermal / backlight / keyboard-reset coverage.
#  10. Remove clearly legacy attack surface (firewire, parallel, a.out,
#      TIOCSTI injection, legacy pty semantics).
#
# Patches (applied separately in prepare()):
#   - Clear Linux init-wait-for-partition-and-retry-scan
#   - Clear Linux pci-pme-wakeups (battery)
#   - Clear Linux smpboot-reuse-timer (faster boot)
#   - Clear Linux initialize-ata-before-scsi (faster block init)
#
# Every non-obvious flag below has an inline reason so future
# maintainers (and `balai explain`) can audit the decision.
# ═══════════════════════════════════════════════════════════════════

# ─── Architecture ───────────────────────────────────────────────────
# x86-64-v3 target: Haswell-era (2013+) CPUs. Covers 99 % of users and
# lets us enable AVX2-optimised crypto, lz4/zstd, and memcpy.
CONFIG_X86_64=y
CONFIG_GENERIC_CPU3=y
CONFIG_X86_MCE=y
CONFIG_X86_MCE_INTEL=y
CONFIG_X86_MCE_AMD=y
CONFIG_X86_THERMAL_VECTOR=y
# Compile in SMP, NUMA, large-page support.
CONFIG_SMP=y
CONFIG_NUMA=y
CONFIG_X86_5LEVEL=y

# ─── Preemption (low-latency gaming) ────────────────────────────────
# PREEMPT_DYNAMIC lets userspace flip preempt modes at boot via the
# `preempt=` cmdline arg without rebuilding. Default to full preempt
# for interactive desktop / gaming.
CONFIG_PREEMPT=y
CONFIG_PREEMPTION=y
CONFIG_PREEMPT_COUNT=y
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_PREEMPT_RCU=y
# PREEMPT_RT kept OFF by default — it's great for audio, bad for raw
# throughput. Users who need it can flip it via a downstream build.
# CONFIG_PREEMPT_RT=y

# ─── Timer / tick ───────────────────────────────────────────────────
CONFIG_HZ_1000=y
CONFIG_HZ=1000
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y                 # Tickless when idle: huge battery win
CONFIG_NO_HZ_FULL=y                 # Available (opt-in at boot time)

# ─── Scheduler ──────────────────────────────────────────────────────
# zen's BORE scheduler handles bursts well (e.g. compile spikes). Plus
# autogroup so a compile in one terminal doesn't freeze Firefox.
CONFIG_SCHED_AUTOGROUP=y
CONFIG_SCHED_BORE=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
# RCU nocb: offload RCU callbacks to housekeeping CPUs → lower jitter.
CONFIG_RCU_NOCB_CPU=y
CONFIG_RCU_NOCB_CPU_CB_BOOST=y

# ─── CPU frequency + idle ───────────────────────────────────────────
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_X86_INTEL_PSTATE=y
CONFIG_X86_AMD_PSTATE=y
CONFIG_X86_AMD_PSTATE_DEFAULT_MODE=3   # guided mode
CONFIG_X86_AMD_PSTATE_UT=n
CONFIG_X86_ACPI_CPUFREQ=y              # fallback
CONFIG_CPU_IDLE=y
CONFIG_CPU_IDLE_GOV_MENU=y
CONFIG_CPU_IDLE_GOV_TEO=y              # modern timer-event oriented gov
CONFIG_CPU_IDLE_GOV_HALTPOLL=y
CONFIG_INTEL_IDLE=y

# ─── Power management ───────────────────────────────────────────────
CONFIG_PM=y
CONFIG_PM_SLEEP=y
CONFIG_PM_AUTOSLEEP=y
CONFIG_PM_WAKELOCKS=y
CONFIG_PM_TRACE_RTC=n                  # not useful in production
CONFIG_ACPI=y
CONFIG_ACPI_AC=y
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_THERMAL=y
CONFIG_ACPI_CPU_FREQ_PSS=y
CONFIG_ACPI_DOCK=y
CONFIG_ACPI_WMI=m                      # laptop vendor hotkeys
CONFIG_DELL_WMI=m
CONFIG_ASUS_WMI=m
CONFIG_THINKPAD_ACPI=m
CONFIG_INTEL_IPS=m
CONFIG_INTEL_POWERCLAMP=y
CONFIG_INTEL_RAPL=y
CONFIG_X86_PKG_TEMP_THERMAL=y
CONFIG_INTEL_PMC_CORE=y
CONFIG_PCIEASPM=y
CONFIG_PCIEASPM_POWERSUPERSAVE=y
CONFIG_PCIEPORTBUS=y

# ─── Memory management ──────────────────────────────────────────────
# MGLRU: the modern, much-better page reclaim. Reduces latency spikes
# on memory pressure. Enable by default.
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_LRU_GEN_STATS=n
# Shuffle page allocator: frustrates physically-adjacent use-after-free.
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
# Transparent hugepages on madvise: sweet spot for gaming frametimes.
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
# ZSWAP + ZRAM both compiled, zstd default. BalOS userspace picks one
# at boot via zram-generator.conf.
CONFIG_ZRAM=m
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_ZSWAP=y
CONFIG_ZSWAP_COMPRESSOR_DEFAULT_ZSTD=y
CONFIG_ZSWAP_DEFAULT_ON=y
CONFIG_ZSMALLOC=y

# ─── Security hardening — extreme ───────────────────────────────────
# Compiled IN, not just available; defenses that protect against
# kernel exploitation without breaking Arch userspace.
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_NETWORK_XFRM=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_APPARMOR_BOOTPARAM_VALUE=1
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_SECURITY_SELINUX=n              # pick one LSM as default; AA here
CONFIG_SECURITY_LOADPIN=y
CONFIG_SECURITY_TOMOYO=n
CONFIG_SECURITY_DMESG_RESTRICT=y
CONFIG_SECURITY_PERF_EVENTS_RESTRICT=y
CONFIG_SECURITY_WRITABLE_HOOKS=n
CONFIG_LSM="landlock,lockdown,yama,loadpin,integrity,apparmor,bpf"

# Exploit mitigations (compile-time, no cmdline needed).
CONFIG_HARDENED_USERCOPY=y
CONFIG_HARDENED_USERCOPY_FALLBACK=n
CONFIG_FORTIFY_SOURCE=y
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_SCHED_STACK_END_CHECK=y
CONFIG_VMAP_STACK=y
CONFIG_THREAD_INFO_IN_TASK=y
CONFIG_RANDOMIZE_BASE=y                # KASLR
CONFIG_RANDOMIZE_MEMORY=y
CONFIG_RANDOMIZE_KSTACK_OFFSET=y
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y
CONFIG_PAGE_TABLE_ISOLATION=y          # Meltdown mitigation (KPTI)
CONFIG_RETPOLINE=y                     # Spectre v2
CONFIG_CPU_IBPB_ENTRY=y
CONFIG_CPU_IBRS_ENTRY=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STRICT_MODULE_RWX=y
CONFIG_DEBUG_WX=y
CONFIG_STRICT_DEVMEM=y
CONFIG_IO_STRICT_DEVMEM=y

# Heap / slab hardening
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SLAB_MERGE_DEFAULT=n            # don't merge across caches
CONFIG_SLAB_BUCKETS=y                  # (6.12+) per-cgroup slab isolation
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y      # zero freshly-allocated pages
CONFIG_INIT_ON_FREE_DEFAULT_ON=y       # zero freed pages (~1-3 % perf cost)
CONFIG_PAGE_POISONING=y
CONFIG_ZERO_CALL_USED_REGS=y

# Reference-count hardening (was REFCOUNT_FULL in older kernels)
CONFIG_REFCOUNT_FULL=y

# BUG on memory corruption — crash rather than silently continue.
CONFIG_BUG=y
CONFIG_BUG_ON_DATA_CORRUPTION=y
CONFIG_PANIC_ON_OOPS=n                 # too aggressive for desktop
CONFIG_PANIC_ON_OOPS_VALUE=0

# Remove surprising attack surface without breaking compatibility.
CONFIG_LEGACY_TIOCSTI=n                # classic TTY injection exploit
CONFIG_LDISC_AUTOLOAD=n                # no implicit line discipline loads
CONFIG_LEGACY_PTYS=n                   # Arch uses pts, legacy not needed
CONFIG_DEVMEM=n                        # /dev/mem — huge attack surface
CONFIG_DEVKMEM=n
CONFIG_PROC_KCORE=n
CONFIG_KEXEC=n                         # BalOS never kexecs
CONFIG_KEXEC_FILE=n
CONFIG_HIBERNATION=y                   # keep — users want suspend-to-disk
CONFIG_USELIB=n                        # ancient libc loader
CONFIG_BINFMT_MISC=m                   # keep as module (Wine/Proton)

# Module signing — advisory (key embedded, but not FORCED). Out-of-tree
# drivers (aircrack, realtek patches, zfs, nvidia) must still load.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_FORCE_UNLOAD=n
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_FORCE=n
CONFIG_MODULE_SIG_SHA512=y
CONFIG_MODULE_SIG_HASH="sha512"
CONFIG_MODULE_SIG_KEY="certs/signing_key.pem"

# BPF: enable but lock unprivileged use by default (known attack vec).
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BPF_UNPRIV_DEFAULT_OFF=y        # sysctl toggle at runtime
CONFIG_BPF_LSM=y                       # enables falco et al
CONFIG_NET_CLS_BPF=y

# ─── Networking ─────────────────────────────────────────────────────
CONFIG_NET=y
CONFIG_PACKET=y                        # raw sockets (for pentesting)
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_NETFILTER=y
CONFIG_NF_TABLES=y
CONFIG_NFT_FIB_IPV4=m
CONFIG_NFT_FIB_IPV6=m
CONFIG_NFT_CT=m
CONFIG_NFT_SET_HASH=m
CONFIG_NFT_CONNLIMIT=m
CONFIG_NFT_LIMIT=m
CONFIG_NFT_NAT=m
CONFIG_NFT_QUEUE=m
CONFIG_IP_NF_IPTABLES=m                # compat
CONFIG_NF_CONNTRACK=m
# Congestion control: BBR default + CUBIC available.
CONFIG_TCP_CONG_BBR=y
CONFIG_TCP_CONG_CUBIC=y
CONFIG_DEFAULT_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"
# Qdiscs: CAKE as default (shapes bufferbloat well on residential lines).
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_CAKE=y
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_CAKE=y
CONFIG_DEFAULT_NET_SCH="cake"
# VPN stack
CONFIG_WIREGUARD=y                     # built-in, not module
CONFIG_TLS=m

# ─── Wireless (monitor mode + injection for pentesting) ─────────────
CONFIG_WLAN=y
CONFIG_MAC80211=y
CONFIG_CFG80211=y
CONFIG_CFG80211_WEXT=y                 # legacy userspace
CONFIG_CFG80211_DEFAULT_PS=n           # don't auto-powersave (breaks aircrack)
CONFIG_MAC80211_MESH=y
CONFIG_MAC80211_LEDS=y
# Chipsets with good monitor/injection support:
CONFIG_ATH9K=m
CONFIG_ATH9K_HTC=m
CONFIG_ATH10K=m
CONFIG_ATH10K_PCI=m
CONFIG_ATH11K=m
CONFIG_ATH11K_PCI=m
CONFIG_RT2800PCI=m
CONFIG_RT2800USB=m
CONFIG_RTL8XXXU=m
CONFIG_RTL8XXXU_UNTESTED=y
CONFIG_RTW88=m
CONFIG_RTW89=m
CONFIG_MT76_USB=m
CONFIG_MT7921E=m
CONFIG_MT7921U=m
CONFIG_MT7925E=m
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m
CONFIG_IWLDVM=m
CONFIG_B43=m
CONFIG_BRCMFMAC=m

# ─── Bluetooth ──────────────────────────────────────────────────────
CONFIG_BT=m
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIUART=m

# ─── Filesystems ────────────────────────────────────────────────────
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_LZ4=y
CONFIG_F2FS_FS_ZSTD=y
CONFIG_F2FS_FS_COMPRESSION=y
CONFIG_XFS_FS=y
CONFIG_XFS_POSIX_ACL=y
CONFIG_XFS_QUOTA=y
CONFIG_NTFS3_FS=y                      # Paragon read+write NTFS
CONFIG_NTFS3_LZX_XPRESS=y
CONFIG_EXFAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_FS=y
CONFIG_FS_ENCRYPTION=y                 # fscrypt (f2fs, ext4)
CONFIG_FS_VERITY=y                     # measured-boot of specific files
CONFIG_FS_DAX=y
CONFIG_BCACHEFS_FS=m                   # modern COW fs (opt-in, module)
CONFIG_OVERLAY_FS=y
CONFIG_FUSE_FS=y

# ─── Block layer ────────────────────────────────────────────────────
CONFIG_BLK_CGROUP=y
CONFIG_BLK_CGROUP_IOCOST=y
CONFIG_BLK_CGROUP_IOPRIO=y
CONFIG_BLK_WBT=y
CONFIG_BLK_WBT_MQ=y
CONFIG_IOSCHED_BFQ=y
CONFIG_BFQ_GROUP_IOSCHED=y
CONFIG_MQ_IOSCHED_DEADLINE=y
CONFIG_MQ_IOSCHED_KYBER=y
# Default I/O scheduler chosen at runtime via udev rules (NVMe → none,
# SSD → mq-deadline, rotational → bfq).
CONFIG_BLK_DEV_NVME=y                  # built in, for root-on-NVMe
CONFIG_NVME_CORE=y
CONFIG_NVME_MULTIPATH=y

# ─── io_uring ───────────────────────────────────────────────────────
CONFIG_IO_URING=y

# ─── Graphics ───────────────────────────────────────────────────────
CONFIG_DRM=y
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_AMDGPU_SI=y                 # older GCN 1.x
CONFIG_DRM_AMDGPU_CIK=y                # GCN 2.x
CONFIG_DRM_AMDGPU_USERPTR=y
CONFIG_DRM_AMD_DC=y
CONFIG_DRM_I915=m
CONFIG_DRM_I915_FORCE_PROBE="*"
CONFIG_DRM_I915_GVT=y
CONFIG_DRM_I915_GVT_KVMGT=m            # Intel GVT-g passthrough
CONFIG_DRM_NOUVEAU=m
CONFIG_DRM_NOUVEAU_BACKLIGHT=y
# Wayland / modern
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_FBDEV_EMULATION=y

# ─── Audio ──────────────────────────────────────────────────────────
CONFIG_SOUND=m
CONFIG_SND=m
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_HDA_GENERIC=m
CONFIG_SND_SOC=m
CONFIG_SND_USB_AUDIO=m
CONFIG_SND_USB_USX2Y=m
CONFIG_SND_SEQUENCER=m

# ─── USB ────────────────────────────────────────────────────────────
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_HID=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y                       # USB-attached SCSI (fast NVMe over USB)
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_SERIAL=m
CONFIG_USB_PRINTER=m
CONFIG_USB_DEFAULT_PERSIST=y
# Don't build legacy attack surface.
CONFIG_USB_GADGET=n

# ─── Input / HID ────────────────────────────────────────────────────
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_INPUT_MOUSE=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_HID_MULTITOUCH=m
CONFIG_HID_APPLE=m
CONFIG_HID_LOGITECH=m
CONFIG_HID_MAGICMOUSE=m
CONFIG_HID_STEAM=m                     # Steam Controller
CONFIG_HID_XBOX_GAMEPAD=m              # (if present in tree)

# ─── Virtualization (KVM host + guest + VFIO) ───────────────────────
CONFIG_KVM=m
CONFIG_KVM_AMD=m
CONFIG_KVM_INTEL=m
CONFIG_KVM_GUEST=y
CONFIG_VIRTIO=m
CONFIG_VIRTIO_PCI=m
CONFIG_VIRTIO_BLK=m
CONFIG_VIRTIO_NET=m
CONFIG_VIRTIO_BALLOON=m
CONFIG_VIRTIO_CONSOLE=m
CONFIG_VIRTIO_FS=m
CONFIG_VFIO=m
CONFIG_VFIO_PCI=m
CONFIG_VFIO_PCI_VGA=y
CONFIG_VFIO_MDEV=m
CONFIG_VBOXGUEST=m
CONFIG_VBOXVIDEO=m
CONFIG_VBOXSF_FS=m

# ─── Namespaces + cgroups ───────────────────────────────────────────
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_BPF=y
CONFIG_CGROUP_MEMORY=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_IOPRIO=y

# ─── Sensors + laptop hardware ──────────────────────────────────────
CONFIG_HWMON=y
CONFIG_SENSORS_CORETEMP=y
CONFIG_SENSORS_K10TEMP=y
CONFIG_SENSORS_DELL_SMM=m
CONFIG_SENSORS_APPLESMC=m
CONFIG_ACPI_ALS=m                      # ambient light sensors

# ─── Tracing / debugging (for balai, bpftrace, perf) ────────────────
CONFIG_DEBUG_INFO=n                    # heavy: disable for prod build
CONFIG_DEBUG_INFO_DWARF5=n
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=n                  # smaller image, no runtime loss
CONFIG_KPROBES=y
CONFIG_UPROBES=y
CONFIG_TRACING=y
CONFIG_TRACEPOINTS=y
CONFIG_FTRACE=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_STACK_TRACER=y
CONFIG_PROFILING=y
CONFIG_PERF_EVENTS=y

# ─── Compression ────────────────────────────────────────────────────
CONFIG_KERNEL_ZSTD=y
CONFIG_MODULE_COMPRESS_ZSTD=y
CONFIG_MODULE_COMPRESS_XZ=n
CONFIG_INITRAMFS_COMPRESSION_ZSTD=y
CONFIG_RD_ZSTD=y

# ─── Futex2 (modern wait_on_bit → Proton, Wine ESYNC/FSYNC) ─────────
CONFIG_FUTEX=y
CONFIG_FUTEX_PI=y
# FUTEX2 was upstreamed as wait_on_bit in 6.x; keep generic entry on.
CONFIG_GENERIC_ENTRY=y

# ─── EFI ────────────────────────────────────────────────────────────
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_MIXED=y                     # IA32 firmware + x64 kernel
CONFIG_EFI_ZBOOT=y                     # self-extracting EFI
CONFIG_EFI_VARS=y
CONFIG_EFIVAR_FS=y

# ─── Integrity / IMA (opt-in, no policy shipped by default) ─────────
CONFIG_INTEGRITY=y
CONFIG_IMA=y
CONFIG_IMA_DEFAULT_HASH_SHA256=y
CONFIG_IMA_APPRAISE=y
CONFIG_EVM=y

# ─── Remove deliberately ────────────────────────────────────────────
# Attack surface with no desktop-laptop use case.
CONFIG_IEEE1394=n                      # FireWire (DMA attack)
CONFIG_PARPORT=n                       # parallel port
CONFIG_BINFMT_AOUT=n                   # a.out binaries
CONFIG_SYSFS_SYSCALL=n                 # deprecated sysfs syscall
CONFIG_SYSCTL_SYSCALL=n
CONFIG_X86_VSYSCALL_EMULATION=n        # CVE-prone compat

# ─── Watchdog ───────────────────────────────────────────────────────
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_NOWAYOUT=n
CONFIG_SOFT_WATCHDOG=m
CONFIG_IT87_WDT=m
CONFIG_SP5100_TCO=m                    # AMD
CONFIG_ITCO_WDT=m                      # Intel

# ─── Crypto (AES-NI, AVX2 accelerated) ──────────────────────────────
CONFIG_CRYPTO=y
CONFIG_CRYPTO_AES_NI_INTEL=y
CONFIG_CRYPTO_BLAKE2B=y
CONFIG_CRYPTO_CHACHA20_X86_64=y
CONFIG_CRYPTO_CURVE25519_X86=y
CONFIG_CRYPTO_POLY1305_X86_64=y
CONFIG_CRYPTO_SHA256_SSSE3=y
CONFIG_CRYPTO_SHA512_SSSE3=y
# ZSTD compression (module + initramfs)
CONFIG_CRYPTO_ZSTD=y
CONFIG_CRYPTO_LZ4=y
# Hardware RNG
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_INTEL=m
CONFIG_HW_RANDOM_AMD=m
CONFIG_HW_RANDOM_VIRTIO=m
CONFIG_CRYPTO_USER_API=m
CONFIG_CRYPTO_USER_API_HASH=m
CONFIG_CRYPTO_USER_API_SKCIPHER=m
CONFIG_CRYPTO_USER_API_RNG=m
CONFIG_CRYPTO_USER_API_AEAD=m

# ─── Misc laptop/desktop sanity ─────────────────────────────────────
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FB_EFI=y
CONFIG_DRM_BOOTSPLASH=n                # keep plymouth optional
CONFIG_SERIAL_8250=y                   # console serial for debugging
CONFIG_SERIAL_8250_CONSOLE=y
