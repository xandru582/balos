# BalKernel in-tree tuning patch
# ─────────────────────────────────────────────────────────────────
# Keep this patch small and well-justified — every line we apply to
# upstream increases our rebase debt. Anything that can live in
# balkernel.config, /usr/lib/sysctl.d/99-balos-kernel.conf, or the
# kernel cmdline goes THERE instead of here.
#
# Current tweaks:
#
# 1. Tag /proc/version so `uname -v` / `cat /proc/version` clearly
#    identify the build as BalKernel. Makes bug reports easier
#    ("BalOS" in the string) and lets bal* tools detect at runtime
#    whether they're on the blessed kernel.
# ─────────────────────────────────────────────────────────────────

--- a/init/version-timestamp.c
+++ b/init/version-timestamp.c
@@ -10,7 +10,7 @@
 #include <linux/utsname.h>

 struct uts_namespace init_uts_ns = {
-	.name = {
+	.name = {        /* BalKernel build */
 		.sysname	= UTS_SYSNAME,
 		.nodename	= "(none)",
 		.release	= UTS_RELEASE,
